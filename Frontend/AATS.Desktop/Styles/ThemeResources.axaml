<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <!-- ═══════════════════════════════════════════ -->
        <!--                DARK THEME                   -->
        <!-- ═══════════════════════════════════════════ -->
        <ResourceDictionary x:Key="Dark">

            <!-- ── Surfaces ── -->
            <SolidColorBrush x:Key="AppBackground" Color="#0A1931"/>
            <SolidColorBrush x:Key="SidebarBg" Color="#020617"/>
            <SolidColorBrush x:Key="NavbarBg" Color="#0A0F1A"/>
            <SolidColorBrush x:Key="ContentBg" Color="#0A1931"/>
            <SolidColorBrush x:Key="CardBg" Color="#151E2E"/>
            <SolidColorBrush x:Key="FilterBarBg" Color="#1A2B44"/>
            <SolidColorBrush x:Key="InputBg" Color="#0A0F1A"/>
            <SolidColorBrush x:Key="ModalBg" Color="#0A0F1A"/>
            <SolidColorBrush x:Key="DrawerBg" Color="#0A111E"/>
            <SolidColorBrush x:Key="DrawerHeaderBg" Color="#0F172A"/>
            <SolidColorBrush x:Key="DrawerFooterBg" Color="#0A0F1A"/>
            <SolidColorBrush x:Key="DrawerCardBg" Color="#151D2F"/>
            <SolidColorBrush x:Key="DrawerInputBg" Color="#0F172A"/>
            <SolidColorBrush x:Key="GuideCardBg" Color="#121826"/>
            <SolidColorBrush x:Key="ProTipBg" Color="#0F172A"/>

            <!-- ── Hover / Interactive Surfaces ── -->
            <SolidColorBrush x:Key="HoverBg" Color="#1E293B"/>
            <SolidColorBrush x:Key="HoverBgStrong" Color="#4E618A"/>
            <SolidColorBrush x:Key="HoverBgSubtle" Color="#2D3748"/>
            <SolidColorBrush x:Key="RowHoverBg" Color="#1F2942"/>
            <SolidColorBrush x:Key="SelectedRowBg" Color="#1E2B3C"/>
            <SolidColorBrush x:Key="ActiveNavBg" Color="#CBD5E1"/>
            <SolidColorBrush x:Key="ActiveNavFg" Color="#0F172A"/>
            <SolidColorBrush x:Key="UserHeaderBg" Color="#1E293B"/>
            <SolidColorBrush x:Key="UserDropdownBg" Color="#0F172A"/>
            <SolidColorBrush x:Key="SignOutHoverBg" Color="#451A1A"/>
            <SolidColorBrush x:Key="ProcessBadgeBg" Color="#1C263A"/>

            <!-- ── Borders ── -->
            <SolidColorBrush x:Key="BorderDefault" Color="#1E293B"/>
            <SolidColorBrush x:Key="BorderSubtle" Color="#2D3748"/>
            <SolidColorBrush x:Key="BorderMuted" Color="#111827"/>
            <SolidColorBrush x:Key="BorderFocus" Color="#4E618A"/>
            <SolidColorBrush x:Key="SidebarBorder" Color="#2D3748"/>
            <SolidColorBrush x:Key="NavbarBorder" Color="#1F2937"/>

            <!-- ── Text ── -->
            <SolidColorBrush x:Key="TextPrimary" Color="White"/>
            <SolidColorBrush x:Key="TextHeading" Color="#F8FAFC"/>
            <SolidColorBrush x:Key="TextSecondary" Color="#94A3B8"/>
            <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>
            <SolidColorBrush x:Key="TextDimmed" Color="#6B7280"/>
            <SolidColorBrush x:Key="TextFaint" Color="#4B5563"/>
            <SolidColorBrush x:Key="TextNav" Color="#D1D5DB"/>
            <SolidColorBrush x:Key="TextSubNav" Color="#94A3B8"/>
            <SolidColorBrush x:Key="TextInput" Color="#F1F5F9"/>
            <SolidColorBrush x:Key="TextOnActive" Color="#0F172A"/>
            <SolidColorBrush x:Key="TextBody" Color="#E2E8F0"/>
            <SolidColorBrush x:Key="TextLabel" Color="#8695B1"/>

            <!-- ── Accent ── -->
            <SolidColorBrush x:Key="AccentBlue" Color="#60A5FA"/>
            <SolidColorBrush x:Key="AccentPrimary" Color="#3B82F6"/>
            <SolidColorBrush x:Key="AccentBlueDark" Color="#1E40AF"/>

            <!-- ── Logo ── -->
            <SolidColorBrush x:Key="LogoTitle" Color="#8FA3D1"/>
            <SolidColorBrush x:Key="LogoSubtitle" Color="#E5E7EB"/>

            <!-- ── Breadcrumb ── -->
            <SolidColorBrush x:Key="BreadcrumbMain" Color="#94A3B8"/>
            <SolidColorBrush x:Key="BreadcrumbSub" Color="#60A5FA"/>
            <SolidColorBrush x:Key="BreadcrumbChevron" Color="#4B5563"/>

            <!-- ── Buttons ── -->
            <SolidColorBrush x:Key="BtnSecondaryBg" Color="#1E293B"/>
            <SolidColorBrush x:Key="BtnSecondaryFg" Color="#F1F5F9"/>
            <SolidColorBrush x:Key="BtnDetailBg" Color="#1E293B"/>
            <SolidColorBrush x:Key="BtnDetailHover" Color="#2D3A4F"/>
            <SolidColorBrush x:Key="BtnEditBorder" Color="#2D3748"/>
            <SolidColorBrush x:Key="BtnEditHover" Color="#1E293B"/>
            <SolidColorBrush x:Key="CircleNavBg" Color="#1E293B"/>
            <SolidColorBrush x:Key="AddRecordBg" Color="#AEC9E0"/>
            <SolidColorBrush x:Key="AddRecordFg" Color="#0A0F1A"/>
            <SolidColorBrush x:Key="AddRecordHover" Color="#9ABBD2"/>

            <!-- ── Overlay ── -->
            <SolidColorBrush x:Key="OverlayBg" Color="#CC020617"/>

            <!-- ── Shadows (as BoxShadows) ── -->
            <BoxShadows x:Key="CardShadow">0 4 20 0 #40000000</BoxShadows>
            <BoxShadows x:Key="ModalShadow">0 20 50 0 #80000000</BoxShadows>
            <BoxShadows x:Key="DrawerShadow">-15 0 35 0 #000000</BoxShadows>
            <BoxShadows x:Key="DetailCardShadow">0 4 15 0 #20000000</BoxShadows>

            <!-- ── Chevron / Expander ── -->
            <SolidColorBrush x:Key="ChevronStroke" Color="#D1D5DB"/>

            <!-- ── Search / Misc ── -->
            <SolidColorBrush x:Key="SearchIcon" Color="#9CA3AF"/>
            <SolidColorBrush x:Key="BellIcon" Color="#9CA3AF"/>
            <SolidColorBrush x:Key="UserAvatarBg" Color="#1F2937"/>
            <SolidColorBrush x:Key="UserAvatarBorder" Color="#2D3748"/>

            <!-- ── Dashboard Specific ── -->
            <SolidColorBrush x:Key="DashCardBg" Color="#151E2E"/>
            <SolidColorBrush x:Key="DashActionBg" Color="#111827"/>
            <SolidColorBrush x:Key="DashActionBorder" Color="#1F2937"/>
            <SolidColorBrush x:Key="DashActionHover" Color="#1F2937"/>
            <SolidColorBrush x:Key="DashModuleBg" Color="#1F2937"/>
            <SolidColorBrush x:Key="DashModuleIconBg" Color="#1E293B"/>
            <SolidColorBrush x:Key="DashChartBg" Color="#1F2937"/>
            <SolidColorBrush x:Key="DashActivityIconBg" Color="#1E293B"/>

            <!-- ── Table / DataGrid ── -->
            <SolidColorBrush x:Key="TableBg" Color="#1A2B44"/>
            <SolidColorBrush x:Key="TableHeaderFg" Color="#94A3B8"/>
            <SolidColorBrush x:Key="TableRowBorder" Color="#2D3748"/>
            <SolidColorBrush x:Key="TableCellFg" Color="#94A3B8"/>
            <SolidColorBrush x:Key="TableCellPrimaryFg" Color="White"/>

            <!-- ── Pagination Buttons ── -->
            <SolidColorBrush x:Key="PaginationBg" Color="#1A2B44"/>
            <SolidColorBrush x:Key="PaginationBorder" Color="#2D3748"/>

            <!-- ── Calendar ── -->
            <SolidColorBrush x:Key="CalendarBg" Color="#0B1221"/>
            <SolidColorBrush x:Key="CalendarBorder" Color="#1C273D"/>
            <SolidColorBrush x:Key="CalendarHeaderBg" Color="#0B1221"/>
            <SolidColorBrush x:Key="CalendarWeekdayFg" Color="#8E9BB0"/>
            <SolidColorBrush x:Key="CalendarDayHover" Color="#152238"/>
            <SolidColorBrush x:Key="CalendarDaySelected" Color="#1E293B"/>
            <SolidColorBrush x:Key="CalendarInactiveFg" Color="#475569"/>

            <!-- ── Drawer Edit Button ── -->
            <SolidColorBrush x:Key="DrawerEditBtnBg" Color="#111B2D"/>
            <SolidColorBrush x:Key="DrawerEditBtnHover" Color="#1E293B"/>
            <SolidColorBrush x:Key="DrawerSaveBtnBg" Color="#AECACE"/>
            <SolidColorBrush x:Key="DrawerSaveBtnFg" Color="#0A0F1A"/>
            <SolidColorBrush x:Key="DrawerSaveBtnHover" Color="#C0DAE0"/>
            <BoxShadows x:Key="FlyoutShadow">0 10 30 0 #A0000000</BoxShadows>

            <!-- ── Icon Action Buttons (Drawer) ── -->
            <SolidColorBrush x:Key="IconActionBg" Color="#1E293B"/>
            <SolidColorBrush x:Key="IconActionBorder" Color="#334155"/>
            <SolidColorBrush x:Key="IconActionHover" Color="#334155"/>

            <!-- ── Guide Number Badge ── -->
            <SolidColorBrush x:Key="GuideBadgeBg" Color="#D1D5DB"/>
            <SolidColorBrush x:Key="GuideBadgeFg" Color="#121826"/>
            <SolidColorBrush x:Key="GuideGotItBg" Color="#CBD5E1"/>
            <SolidColorBrush x:Key="GuideGotItFg" Color="#0F172A"/>

            <!-- ── Date Flyout ── -->
            <SolidColorBrush x:Key="DateFlyoutBg" Color="#1C263A"/>
            <SolidColorBrush x:Key="DateFlyoutBorder" Color="#2D3748"/>

            <!-- ── Step Indicator ── -->
            <SolidColorBrush x:Key="StepCircleBorder" Color="#1E293B"/>
            <SolidColorBrush x:Key="StepNumFg" Color="#64748B"/>
            <SolidColorBrush x:Key="StepLabelFg" Color="#94A3B8"/>

            <!-- ── Confirmation Dialog Icon Circle ── -->
            <SolidColorBrush x:Key="ConfirmIconBg" Color="#1E1E2E"/>

            <!-- ── Filter / ComboBox Dropdown ── -->
            <SolidColorBrush x:Key="InputPointerOverBg" Color="#1E293B"/>
            <SolidColorBrush x:Key="InputFocusBg" Color="#0A0F1A"/>
            <SolidColorBrush x:Key="ComboPointerOverBg" Color="#1E293B"/>
            <SolidColorBrush x:Key="ComboFocusBg" Color="#0A0F1A"/>
            <SolidColorBrush x:Key="ComboDropdownBg" Color="#0B1121"/>
            <SolidColorBrush x:Key="ComboDropdownBorder" Color="#1E293B"/>
            <SolidColorBrush x:Key="ComboItemHover" Color="#1F2937"/>
            <SolidColorBrush x:Key="ComboItemSelected" Color="#334155"/>
            <SolidColorBrush x:Key="ComboItemSelectedHover" Color="#475569"/>

            <!-- ── Action Button States ── -->
            <SolidColorBrush x:Key="ActionBtnPointerOver" Color="#2D3A4F"/>

            <!-- ── Selection Indicator ── -->
            <SolidColorBrush x:Key="SelectionIndicatorBg" Color="#1F2937"/>

            <!-- ── Semantic Status Colors ── -->
            <SolidColorBrush x:Key="StatusSuccess" Color="#10B981"/>
            <SolidColorBrush x:Key="StatusDanger" Color="#FA003F"/>
            <SolidColorBrush x:Key="StatusWarning" Color="#F59E0B"/>
            <SolidColorBrush x:Key="StatusInfo" Color="#3B82F6"/>

        </ResourceDictionary>

        <!-- ═══════════════════════════════════════════ -->
        <!--                LIGHT THEME                  -->
        <!-- ═══════════════════════════════════════════ -->
        <ResourceDictionary x:Key="Light">

            <!-- ── Surfaces ── -->
            <SolidColorBrush x:Key="AppBackground" Color="#F1F5F9"/>
            <SolidColorBrush x:Key="SidebarBg" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="NavbarBg" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ContentBg" Color="#F3F4F6"/>
            <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="FilterBarBg" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="InputBg" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ModalBg" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="DrawerBg" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="DrawerHeaderBg" Color="#F8FAFC"/>
            <SolidColorBrush x:Key="DrawerFooterBg" Color="#F8FAFC"/>
            <SolidColorBrush x:Key="DrawerCardBg" Color="#F9FAFB"/>
            <SolidColorBrush x:Key="DrawerInputBg" Color="#F9FAFB"/>
            <SolidColorBrush x:Key="GuideCardBg" Color="#F3F4F6"/>
            <SolidColorBrush x:Key="ProTipBg" Color="#F0F4FF"/>

            <!-- ── Hover / Interactive Surfaces ── -->
            <SolidColorBrush x:Key="HoverBg" Color="#F3F4F6"/>
            <SolidColorBrush x:Key="HoverBgStrong" Color="#E5E7EB"/>
            <SolidColorBrush x:Key="HoverBgSubtle" Color="#F9FAFB"/>
            <SolidColorBrush x:Key="RowHoverBg" Color="#F0F4FF"/>
            <SolidColorBrush x:Key="SelectedRowBg" Color="#EFF6FF"/>
            <SolidColorBrush x:Key="ActiveNavBg" Color="#2563EB"/>
            <SolidColorBrush x:Key="ActiveNavFg" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="UserHeaderBg" Color="#F1F5F9"/>
            <SolidColorBrush x:Key="UserDropdownBg" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="SignOutHoverBg" Color="#FEF2F2"/>
            <SolidColorBrush x:Key="ProcessBadgeBg" Color="#F1F5F9"/>

            <!-- ── Borders ── -->
            <SolidColorBrush x:Key="BorderDefault" Color="#E5E7EB"/>
            <SolidColorBrush x:Key="BorderSubtle" Color="#D1D5DB"/>
            <SolidColorBrush x:Key="BorderMuted" Color="#E5E7EB"/>
            <SolidColorBrush x:Key="BorderFocus" Color="#3B82F6"/>
            <SolidColorBrush x:Key="SidebarBorder" Color="#E5E7EB"/>
            <SolidColorBrush x:Key="NavbarBorder" Color="#E5E7EB"/>

            <!-- ── Text ── -->
            <SolidColorBrush x:Key="TextPrimary" Color="#111827"/>
            <SolidColorBrush x:Key="TextHeading" Color="#111827"/>
            <SolidColorBrush x:Key="TextSecondary" Color="#6B7280"/>
            <SolidColorBrush x:Key="TextMuted" Color="#9CA3AF"/>
            <SolidColorBrush x:Key="TextDimmed" Color="#9CA3AF"/>
            <SolidColorBrush x:Key="TextFaint" Color="#D1D5DB"/>
            <SolidColorBrush x:Key="TextNav" Color="#374151"/>
            <SolidColorBrush x:Key="TextSubNav" Color="#6B7280"/>
            <SolidColorBrush x:Key="TextInput" Color="#1F2937"/>
            <SolidColorBrush x:Key="TextOnActive" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="TextBody" Color="#374151"/>
            <SolidColorBrush x:Key="TextLabel" Color="#6B7280"/>

            <!-- ── Accent ── -->
            <SolidColorBrush x:Key="AccentBlue" Color="#3B82F6"/>
            <SolidColorBrush x:Key="AccentPrimary" Color="#2563EB"/>
            <SolidColorBrush x:Key="AccentBlueDark" Color="#1D4ED8"/>

            <!-- ── Logo ── -->
            <SolidColorBrush x:Key="LogoTitle" Color="#1E40AF"/>
            <SolidColorBrush x:Key="LogoSubtitle" Color="#374151"/>

            <!-- ── Breadcrumb ── -->
            <SolidColorBrush x:Key="BreadcrumbMain" Color="#6B7280"/>
            <SolidColorBrush x:Key="BreadcrumbSub" Color="#2563EB"/>
            <SolidColorBrush x:Key="BreadcrumbChevron" Color="#D1D5DB"/>

            <!-- ── Buttons ── -->
            <SolidColorBrush x:Key="BtnSecondaryBg" Color="#F3F4F6"/>
            <SolidColorBrush x:Key="BtnSecondaryFg" Color="#374151"/>
            <SolidColorBrush x:Key="BtnDetailBg" Color="#F3F4F6"/>
            <SolidColorBrush x:Key="BtnDetailHover" Color="#E5E7EB"/>
            <SolidColorBrush x:Key="BtnEditBorder" Color="#D1D5DB"/>
            <SolidColorBrush x:Key="BtnEditHover" Color="#F3F4F6"/>
            <SolidColorBrush x:Key="CircleNavBg" Color="#F3F4F6"/>
            <SolidColorBrush x:Key="AddRecordBg" Color="#2563EB"/>
            <SolidColorBrush x:Key="AddRecordFg" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="AddRecordHover" Color="#1D4ED8"/>

            <!-- ── Overlay ── -->
            <SolidColorBrush x:Key="OverlayBg" Color="#66000000"/>

            <!-- ── Shadows ── -->
            <BoxShadows x:Key="CardShadow">0 1 3 0 #1A000000</BoxShadows>
            <BoxShadows x:Key="ModalShadow">0 20 50 0 #30000000</BoxShadows>
            <BoxShadows x:Key="DrawerShadow">-8 0 25 0 #20000000</BoxShadows>
            <BoxShadows x:Key="DetailCardShadow">0 1 3 0 #10000000</BoxShadows>

            <!-- ── Chevron / Expander ── -->
            <SolidColorBrush x:Key="ChevronStroke" Color="#6B7280"/>

            <!-- ── Search / Misc ── -->
            <SolidColorBrush x:Key="SearchIcon" Color="#9CA3AF"/>
            <SolidColorBrush x:Key="BellIcon" Color="#6B7280"/>
            <SolidColorBrush x:Key="UserAvatarBg" Color="#E5E7EB"/>
            <SolidColorBrush x:Key="UserAvatarBorder" Color="#D1D5DB"/>

            <!-- ── Dashboard Specific ── -->
            <SolidColorBrush x:Key="DashCardBg" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="DashActionBg" Color="#F9FAFB"/>
            <SolidColorBrush x:Key="DashActionBorder" Color="#E5E7EB"/>
            <SolidColorBrush x:Key="DashActionHover" Color="#F3F4F6"/>
            <SolidColorBrush x:Key="DashModuleBg" Color="#F3F4F6"/>
            <SolidColorBrush x:Key="DashModuleIconBg" Color="#EFF6FF"/>
            <SolidColorBrush x:Key="DashChartBg" Color="#F3F4F6"/>
            <SolidColorBrush x:Key="DashActivityIconBg" Color="#F3F4F6"/>

            <!-- ── Table / DataGrid ── -->
            <SolidColorBrush x:Key="TableBg" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="TableHeaderFg" Color="#6B7280"/>
            <SolidColorBrush x:Key="TableRowBorder" Color="#F3F4F6"/>
            <SolidColorBrush x:Key="TableCellFg" Color="#6B7280"/>
            <SolidColorBrush x:Key="TableCellPrimaryFg" Color="#111827"/>

            <!-- ── Pagination Buttons ── -->
            <SolidColorBrush x:Key="PaginationBg" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="PaginationBorder" Color="#E5E7EB"/>

            <!-- ── Calendar ── -->
            <SolidColorBrush x:Key="CalendarBg" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="CalendarBorder" Color="#E5E7EB"/>
            <SolidColorBrush x:Key="CalendarHeaderBg" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="CalendarWeekdayFg" Color="#6B7280"/>
            <SolidColorBrush x:Key="CalendarDayHover" Color="#F3F4F6"/>
            <SolidColorBrush x:Key="CalendarDaySelected" Color="#EFF6FF"/>
            <SolidColorBrush x:Key="CalendarInactiveFg" Color="#D1D5DB"/>

            <!-- ── Drawer Edit Button ── -->
            <SolidColorBrush x:Key="DrawerEditBtnBg" Color="#F0F4FF"/>
            <SolidColorBrush x:Key="DrawerEditBtnHover" Color="#DBEAFE"/>
            <SolidColorBrush x:Key="DrawerSaveBtnBg" Color="#2563EB"/>
            <SolidColorBrush x:Key="DrawerSaveBtnFg" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="DrawerSaveBtnHover" Color="#1D4ED8"/>
            <BoxShadows x:Key="FlyoutShadow">0 10 30 0 #20000000</BoxShadows>

            <!-- ── Icon Action Buttons (Drawer) ── -->
            <SolidColorBrush x:Key="IconActionBg" Color="#F3F4F6"/>
            <SolidColorBrush x:Key="IconActionBorder" Color="#E5E7EB"/>
            <SolidColorBrush x:Key="IconActionHover" Color="#E5E7EB"/>

            <!-- ── Guide Number Badge ── -->
            <SolidColorBrush x:Key="GuideBadgeBg" Color="#2563EB"/>
            <SolidColorBrush x:Key="GuideBadgeFg" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="GuideGotItBg" Color="#2563EB"/>
            <SolidColorBrush x:Key="GuideGotItFg" Color="#FFFFFF"/>

            <!-- ── Date Flyout ── -->
            <SolidColorBrush x:Key="DateFlyoutBg" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="DateFlyoutBorder" Color="#E5E7EB"/>

            <!-- ── Step Indicator ── -->
            <SolidColorBrush x:Key="StepCircleBorder" Color="#E5E7EB"/>
            <SolidColorBrush x:Key="StepNumFg" Color="#9CA3AF"/>
            <SolidColorBrush x:Key="StepLabelFg" Color="#6B7280"/>

            <!-- ── Confirmation Dialog Icon Circle ── -->
            <SolidColorBrush x:Key="ConfirmIconBg" Color="#F3F4F6"/>

            <!-- ── Filter / ComboBox Dropdown ── -->
            <SolidColorBrush x:Key="InputPointerOverBg" Color="#F9FAFB"/>
            <SolidColorBrush x:Key="InputFocusBg" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ComboPointerOverBg" Color="#F3F4F6"/>
            <SolidColorBrush x:Key="ComboFocusBg" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ComboDropdownBg" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ComboDropdownBorder" Color="#E5E7EB"/>
            <SolidColorBrush x:Key="ComboItemHover" Color="#F3F4F6"/>
            <SolidColorBrush x:Key="ComboItemSelected" Color="#EFF6FF"/>
            <SolidColorBrush x:Key="ComboItemSelectedHover" Color="#DBEAFE"/>

            <!-- ── Action Button States ── -->
            <SolidColorBrush x:Key="ActionBtnPointerOver" Color="#F3F4F6"/>

            <!-- ── Selection Indicator ── -->
            <SolidColorBrush x:Key="SelectionIndicatorBg" Color="#F3F4F6"/>

            <!-- ── Semantic Status Colors ── -->
            <SolidColorBrush x:Key="StatusSuccess" Color="#059669"/>
            <SolidColorBrush x:Key="StatusDanger" Color="#DC2626"/>
            <SolidColorBrush x:Key="StatusWarning" Color="#D97706"/>
            <SolidColorBrush x:Key="StatusInfo" Color="#2563EB"/>

        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
