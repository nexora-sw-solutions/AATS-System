<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AATS.Desktop.ViewModels.AuditAndAccounts"
             xmlns:vm_shared="clr-namespace:AATS.Desktop.ViewModels.Shared"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             xmlns:inter="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
             xmlns:ia="clr-namespace:Avalonia.Xaml.Interactions.Core;assembly=Avalonia.Xaml.Interactions"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="AATS.Desktop.Views.Shared.SharedAuditTableView"
             x:DataType="vm_shared:AuditTableViewModelBase"
             ClipToBounds="False"
             x:CompileBindings="False"
             xmlns:conv="using:AATS.Desktop.Converters">

    <UserControl.Styles>
        <StyleInclude Source="avares://AATS.Desktop/Styles/PremiumDrawer.axaml" />

        <Style Selector="Button.add-record-button">
            <Setter Property="Background" Value="{DynamicResource AddRecordBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource AddRecordFg}"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontSize" Value="14"/>
            <Style.Resources>
                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#9ABBD2"/>
            </Style.Resources>
        </Style>

        <!-- Status Badge Styles (Drawer) -->
        <Style Selector="Border.status-badge">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.status-active">
            <Setter Property="Background" Value="#DCFCE7"/>
            <Setter Property="BorderBrush" Value="#BBF7D0"/>
            <Setter Property="BoxShadow" Value="0 0 8 0 #33BBF7D0"/>
            <Style Selector="^ TextBlock">
                <Setter Property="Foreground" Value="#166534"/>
            </Style>
        </Style>

        <Style Selector="Button.action-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.action-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource RowHoverBg}"/>
        </Style>
        <Style Selector="Button.action-btn:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.1)"/>
        </Style>


        <Style Selector="DataGrid">
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TableHeaderFg}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="AreSeparatorsVisible" Value="False"/>
        </Style>

        <Style Selector="DataGridColumnHeader:pointerover /template/ Grid">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="DataGridColumnHeader:pointerover /template/ Border">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="DataGridRow">
            <Setter Property="BorderBrush" Value="{DynamicResource TableRowBorder}"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
        </Style>

        <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="{DynamicResource RowHoverBg}"/>
            <Setter Property="Opacity" Value="0.5"/>
        </Style>

        <!-- Button style to avoid cell hover highlight -->
        <Style Selector="Button.row-button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style Selector="Button.row-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.row-button.selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SelectedRowBg}"/>
        </Style>
        <Style Selector="Button.row-button.selected">
            <Setter Property="Background" Value="{DynamicResource SelectedRowBg}"/>
        </Style>
        <Style Selector="Border.row-cell.selected">
            <Setter Property="Background" Value="{DynamicResource SelectedRowBg}"/>
        </Style>

        <!-- Status Badges -->
        <Style Selector="Border.status-badge">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="12,0"/>
        </Style>
        <Style Selector="Border.status-paid">
            <Setter Property="Background" Value="#B3CFE5"/>
            <Setter Property="BorderBrush" Value="#334A7FA7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BoxShadow" Value="0 0 8 0 #334A7FA7"/>
            <Style Selector="^ TextBlock">
                <Setter Property="Foreground" Value="#0A1931"/>
            </Style>
        </Style>
        <Style Selector="Border.status-unpaid">
            <Setter Property="Background" Value="#FEE2E2"/>
            <Setter Property="BorderBrush" Value="#FCA5A5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BoxShadow" Value="0 0 8 0 #33FCA5A5"/>
            <Style Selector="^ TextBlock">
                <Setter Property="Foreground" Value="#991B1B"/>
            </Style>
        </Style>
        <Style Selector="Border.status-partial">
            <Setter Property="Background" Value="#DCFCE7"/>
            <Setter Property="BorderBrush" Value="#BBF7D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BoxShadow" Value="0 0 8 0 #33BBF7D0"/>
            <Style Selector="^ TextBlock">
                <Setter Property="Foreground" Value="#166534"/>
            </Style>
        </Style>

        <!-- Process Badges -->
        <Style Selector="Border.process-badge">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="12,0"/>
            <Setter Property="Background" Value="{DynamicResource ProcessBadgeBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style Selector="^ TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextBody}"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </Style>
        </Style>
        <Style Selector="Border.process-completed">
            <Setter Property="Background" Value="{DynamicResource InputBg}"/>
            <Style Selector="^ TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextHeading}"/></Style>
        </Style>
        <Style Selector="Border.process-pending">
            <Setter Property="Background" Value="{DynamicResource HoverBg}"/>
            <Style Selector="^ TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextNav}"/></Style>
        </Style>
        <Style Selector="Border.process-inprogress">
            <Setter Property="Background" Value="{DynamicResource HoverBg}"/>
            <Style Selector="^ TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextNav}"/></Style>
        </Style>
        <Style Selector="Border.process-review">
            <Setter Property="Background" Value="{DynamicResource HoverBg}"/>
            <Style Selector="^ TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextNav}"/></Style>
        </Style>
        <Style Selector="Border.process-draft">
            <Setter Property="Background" Value="{DynamicResource HoverBg}"/>
            <Style Selector="^ TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextNav}"/></Style>
        </Style>
        <Style Selector="Border.process-submitted">
            <Setter Property="Background" Value="{DynamicResource HoverBg}"/>
            <Style Selector="^ TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextNav}"/></Style>
        </Style>
        <Style Selector="Border.process-issueraised">
            <Setter Property="Background" Value="{DynamicResource HoverBg}"/>
            <Style Selector="^ TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextNav}"/></Style>
        </Style>

        <!-- Date Picker Sync Styles -->
        <Style Selector="FlyoutPresenter.date-flyout">
            <Setter Property="Background" Value="{DynamicResource DateFlyoutBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DateFlyoutBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="15"/>
        </Style>
        <Style Selector="CalendarDatePicker">
            <Setter Property="Background" Value="{DynamicResource InputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBody}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>
        <Style Selector="CalendarDatePicker:pointerover /template/ Border#Background">
            <Setter Property="Background" Value="{DynamicResource HoverBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderFocus}"/>
        </Style>

        <!-- Calendar UI -->
        <Style Selector="Calendar">
            <Setter Property="Background" Value="{DynamicResource CalendarBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CalendarBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="CalendarItem">
            <Setter Property="Background" Value="{DynamicResource CalendarBg}"/>
            <Setter Property="HeaderBackground" Value="{DynamicResource CalendarHeaderBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource CalendarWeekdayFg}"/>
        </Style>
        <Style Selector="Button.CalendarItemButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style Selector="CalendarButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="CalendarDayButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="CalendarDayButton:inactive">
            <Setter Property="Foreground" Value="{DynamicResource CalendarInactiveFg}"/>
        </Style>
        <Style Selector="CalendarDayButton:pointerover /template/ ContentPresenter#PART_DayPresenter">
            <Setter Property="Background" Value="{DynamicResource CalendarDayHover}"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="CalendarDayButton:selected /template/ ContentPresenter#PART_DayPresenter">
            <Setter Property="Background" Value="{DynamicResource CalendarDaySelected}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </UserControl.Styles>

    <Panel>
        <ScrollViewer>
            <Grid RowDefinitions="Auto, Auto, Auto, Auto" Margin="25,20,15,20">
            <!-- Header -->
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,25">
                <TextBlock Text="{Binding PageTitle}" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Classes="add-record-button" Command="{Binding AddRecordCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <i:Icon Value="fa-solid fa-plus" FontSize="14" Foreground="{DynamicResource AddRecordFg}"/>
                        <TextBlock Text="Add Record" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Filters -->
            <Border Grid.Row="1" Background="{DynamicResource FilterBarBg}" CornerRadius="12" Padding="15" Margin="0,0,0,20" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                <Grid ColumnDefinitions="*, 15, Auto, 10, Auto, 10, Auto, 10, Auto, Auto">
                    <!-- Search and Selection Actions -->
                    <Grid Grid.Column="0" ColumnDefinitions="*, Auto">
                        <Panel Grid.Column="0">
                            <TextBox Classes="filter-search" Watermark="{Binding SearchPlaceholder}" Text="{Binding SearchText}"/>
                            <i:Icon Value="fa-solid fa-magnifying-glass" Foreground="{DynamicResource TextDimmed}" FontSize="14" HorizontalAlignment="Left" Margin="15,0,0,0" VerticalAlignment="Center"/>
                        </Panel>

                        <!-- Selection Indicator -->
                        <Border Grid.Column="1" IsVisible="{Binding HasSelectedRecords}" Background="{DynamicResource SelectionIndicatorBg}" CornerRadius="6"
                                Padding="12,4" Margin="10,0,0,0" VerticalAlignment="Center" MinHeight="38">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="{Binding SelectedRecordCount, StringFormat='{}{0} selected'}" Foreground="{DynamicResource TextBody}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Button Classes="footer-link" Command="{Binding DeleteSelectedCommand}" ToolTip.Tip="Delete Selected" VerticalAlignment="Center">
                                    <i:Icon Value="fa-regular fa-trash-can" Foreground="{DynamicResource StatusDanger}" FontSize="12"/>
                                </Button>
                                <Rectangle Width="1" Fill="{DynamicResource BorderFocus}" Margin="2,5"/>
                                <Button Classes="footer-link" Command="{Binding DeselectAllCommand}" ToolTip.Tip="Deselect All" VerticalAlignment="Center">
                                    <i:Icon Value="fa-solid fa-xmark" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Date Filters Group -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                        <!-- 1. Unified Date Filter -->
                        <Button Classes="date-filter-trigger">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <i:Icon Value="fa-solid fa-calendar-alt" Foreground="{DynamicResource AccentPrimary}" FontSize="16"/>
                                <TextBlock Text="{Binding DateFilterSummary}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14"/>
                                <i:Icon Value="fa-solid fa-chevron-down" Foreground="{DynamicResource TextMuted}" FontSize="10" VerticalAlignment="Center" Margin="5,0,0,0"/>
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft" FlyoutPresenterClasses="premium-flyout">
                                    <Border Background="{DynamicResource DrawerBg}" 
                                        BorderBrush="{DynamicResource BorderDefault}" 
                                        BorderThickness="1" 
                                        CornerRadius="12" 
                                        Padding="0" 
                                        ClipToBounds="True"
                                        BoxShadow="{DynamicResource FlyoutShadow}">
                                    <Grid ColumnDefinitions="Auto, 1, Auto">
                                        <!-- Left: Quick Picks List -->
                                        <Border Classes="quick-pick-sidebar">
                                            <ListBox ItemsSource="{Binding DateFilters}" SelectedItem="{Binding SelectedDateFilter}"
                                                     Classes="quick-pick-list"/>
                                        </Border>

                                        <!-- Vertical Divider -->
                                        <Border Grid.Column="1" Background="{DynamicResource BorderMuted}" Width="1" VerticalAlignment="Stretch"/>

                                        <!-- Right: Context Content -->
                                        <Border Grid.Column="2" Padding="25" MinWidth="350" MinHeight="480">
                                                <Panel>
                                                    <!-- All Dates / Simple Filters -->
                                                    <StackPanel Spacing="15" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                IsVisible="{Binding SelectedDateFilter, Converter={StaticResource StringEqualityConverter}, ConverterParameter=All Dates}">
                                                        <Panel Height="80">
                                                            <i:Icon Value="fa-solid fa-calendar-check" FontSize="48" Foreground="{DynamicResource TextMuted}" Opacity="0.3" HorizontalAlignment="Center"/>
                                                        </Panel>
                                                        <TextBlock Text="Viewing all time records" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                    
                                                    <StackPanel Spacing="15" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                IsVisible="{Binding SelectedDateFilter, Converter={StaticResource StringEqualityConverter}, ConverterParameter=Today}">
                                                        <Panel Height="80">
                                                            <i:Icon Value="fa-solid fa-clock" FontSize="48" Foreground="{DynamicResource StatusInfo}" Opacity="0.5" HorizontalAlignment="Center"/>
                                                        </Panel>
                                                        <TextBlock Text="Viewing records from today" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                                                    </StackPanel>

                                                    <StackPanel Spacing="15" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                IsVisible="{Binding SelectedDateFilter, Converter={StaticResource StringEqualityConverter}, ConverterParameter=This Week}">
                                                        <Panel Height="80">
                                                            <i:Icon Value="fa-solid fa-calendar-week" FontSize="48" Foreground="{DynamicResource AccentBlue}" Opacity="0.5" HorizontalAlignment="Center"/>
                                                        </Panel>
                                                        <TextBlock Text="Viewing records from this week" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                                                    </StackPanel>

                                                    <!-- Month Selection -->
                                                    <StackPanel Spacing="15" 
                                                                IsVisible="{Binding SelectedDateFilter, Converter={StaticResource StringEqualityConverter}, ConverterParameter=This Month}">
                                                        <TextBlock Text="Select Month" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimary}"/>
                                                        <Calendar SelectedDate="{Binding MonthDate}"/>
                                                        <TextBlock Text="Tip: Select any day in the month" FontSize="11" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                                                    </StackPanel>

                                                    <!-- Year Selection -->
                                                    <StackPanel Spacing="15" 
                                                                IsVisible="{Binding SelectedDateFilter, Converter={StaticResource StringEqualityConverter}, ConverterParameter=This Year}">
                                                        <TextBlock Text="Select Year" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimary}"/>
                                                        <ListBox ItemsSource="{Binding Years}" 
                                                              SelectedItem="{Binding SelectedYear}"
                                                              Classes="year-selector-list">
                                                         <ListBox.ItemsPanel>
                                                             <ItemsPanelTemplate>
                                                                 <WrapPanel/>
                                                             </ItemsPanelTemplate>
                                                         </ListBox.ItemsPanel>
                                                     </ListBox>
                                                    </StackPanel>

                                                    <!-- Specific Date -->
                                                    <StackPanel Spacing="15" 
                                                                IsVisible="{Binding SelectedDateFilter, Converter={StaticResource StringEqualityConverter}, ConverterParameter=Specific Date}">
                                                        <TextBlock Text="Select Specific Date" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimary}"/>
                                                        <Calendar SelectedDate="{Binding SpecificDate}"/>
                                                    </StackPanel>

                                                    <!-- Specific Period -->
                                                    <StackPanel Spacing="15" 
                                                                IsVisible="{Binding SelectedDateFilter, Converter={StaticResource StringEqualityConverter}, ConverterParameter=Specific Period}">
                                                        <TextBlock Text="Select Date Range" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimary}"/>
                                                        <Border Background="{DynamicResource DateFlyoutBg}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="5">
                                                            <StackPanel Spacing="10">
                                                                <Calendar SelectionMode="SingleRange" 
                                                                          SelectedDatesChanged="Calendar_OnSelectedDatesChanged"
                                                                          HorizontalAlignment="Center"/>
                                                                <Grid ColumnDefinitions="*, Auto, *" Margin="10,0">
                                                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                                                        <TextBlock Text="Start Date" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                                                        <TextBlock Text="{Binding PeriodStartDate, StringFormat={}{0:dd MMM yyyy}}" FontWeight="SemiBold" FontSize="12"/>
                                                                    </StackPanel>
                                                                    <i:Icon Grid.Column="1" Value="fa-solid fa-arrow-right" FontSize="10" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="10,0"/>
                                                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                                                        <TextBlock Text="End Date" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                                                        <TextBlock Text="{Binding PeriodEndDate, StringFormat={}{0:dd MMM yyyy}}" FontWeight="SemiBold" FontSize="12"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                        <TextBlock Text="Tip: Click and drag or use Shift+Click to select a range" FontSize="11" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Panel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>

                    <!-- Status Filter -->
                    <ComboBox Grid.Column="4" Classes="filter-combo" PlaceholderText="All Statuses"
                              ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding SelectedStatusFilter}"
                              IsVisible="{Binding IsStatusVisible}"/>

                    <!-- Process Filter -->
                    <ComboBox Grid.Column="6" Classes="filter-combo" PlaceholderText="All Processes"
                              ItemsSource="{Binding ProcessFilters}" SelectedItem="{Binding SelectedProcessFilter}"
                              IsVisible="{Binding IsProcessVisible}"/>

                    <!-- Branch Filter -->
                    <ComboBox Grid.Column="8" Classes="filter-combo" PlaceholderText="All Branches"
                              ItemsSource="{Binding BranchFilters}" SelectedItem="{Binding SelectedBranchFilter}"
                              IsVisible="{Binding IsBranchVisible}"/>
                              
                    <!-- Clear Filters Reset Button -->
                    <Button Grid.Column="9" Margin="10,0,0,0"
                            Command="{Binding ClearFiltersCommand}"
                            IsVisible="{Binding HasActiveFilters}"
                            Background="Transparent" BorderThickness="0" Padding="8"
                            ToolTip.Tip="Reset All Filters"
                            VerticalAlignment="Center"
                            Cursor="Hand">
                        <i:Icon Value="fa-solid fa-rotate-left" Foreground="{DynamicResource StatusDanger}" FontSize="16"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Table -->
            <Border Grid.Row="2" Background="{DynamicResource TableBg}" CornerRadius="12" Padding="5" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                <DataGrid ItemsSource="{Binding Records}" AutoGenerateColumns="False" 
                          CanUserResizeColumns="True" CanUserSortColumns="True"
                          Background="Transparent" BorderThickness="0"
                          GridLinesVisibility="None" RowBackground="Transparent"
                          HeadersVisibility="Column"
                          RowHeight="38">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="40">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding $parent[UserControl].DataContext.IsAllSelected}" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Classes="row-cell" Classes.selected="{Binding IsSelected}">
                                        <CheckBox IsChecked="{Binding IsSelected}" Command="{Binding $parent[UserControl].DataContext.CalculateSelectedCommand}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        
                        <DataGridTemplateColumn Header="ID" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Classes="row-button" Classes.selected="{Binding IsSelected}" Command="{Binding $parent[UserControl].DataContext.DetailsCommand}" CommandParameter="{Binding}">
                                        <TextBlock Text="{Binding Code}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="12,0" HorizontalAlignment="Left"/>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Date" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Classes="row-button" Classes.selected="{Binding IsSelected}" Command="{Binding $parent[UserControl].DataContext.DetailsCommand}" CommandParameter="{Binding}">
                                        <TextBlock Text="{Binding Date, StringFormat={}{0:dd/MM/yyyy}}" Foreground="{DynamicResource TableCellFg}" FontSize="13" VerticalAlignment="Center" Margin="12,0" HorizontalAlignment="Left"/>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Client" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Classes="row-button" Classes.selected="{Binding IsSelected}" Command="{Binding $parent[UserControl].DataContext.DetailsCommand}" CommandParameter="{Binding}">
                                        <TextBlock Text="{Binding ClientName}" Foreground="{DynamicResource TableCellPrimaryFg}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0" HorizontalAlignment="Left"/>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Company" Width="*" IsVisible="{Binding $parent[UserControl].DataContext.IsCompanyVisible}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Classes="row-button" Classes.selected="{Binding IsSelected}" Command="{Binding $parent[UserControl].DataContext.DetailsCommand}" CommandParameter="{Binding}">
                                        <TextBlock Text="{Binding Company}" Foreground="{DynamicResource TableCellFg}" VerticalAlignment="Center" Margin="12,0" HorizontalAlignment="Left"/>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Assignment" Width="*" IsVisible="{Binding $parent[UserControl].DataContext.IsAssignmentVisible}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Classes="row-button" Classes.selected="{Binding IsSelected}" Command="{Binding $parent[UserControl].DataContext.DetailsCommand}" CommandParameter="{Binding}">
                                        <TextBlock Text="{Binding Assignment}" Foreground="{DynamicResource TableCellFg}" VerticalAlignment="Center" Margin="12,0" HorizontalAlignment="Left"/>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="No of Staffs" Width="120" IsVisible="{Binding $parent[UserControl].DataContext.IsNoOfStaffsVisible}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Classes="row-button" Classes.selected="{Binding IsSelected}" Command="{Binding $parent[UserControl].DataContext.DetailsCommand}" CommandParameter="{Binding}">
                                        <TextBlock Text="{Binding NoOfStaffs}" Foreground="{DynamicResource TableCellFg}" VerticalAlignment="Center" Margin="12,0" HorizontalAlignment="Left"/>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Country" Width="120" IsVisible="{Binding $parent[UserControl].DataContext.IsCountryVisible}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Classes="row-button" Classes.selected="{Binding IsSelected}" Command="{Binding $parent[UserControl].DataContext.DetailsCommand}" CommandParameter="{Binding}">
                                        <TextBlock Text="{Binding Country}" Foreground="{DynamicResource TableCellFg}" VerticalAlignment="Center" Margin="12,0" HorizontalAlignment="Left"/>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="{Binding $parent[UserControl].DataContext.StatusHeader}" Width="140" IsVisible="{Binding $parent[UserControl].DataContext.IsStatusVisible}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Classes="row-button" Classes.selected="{Binding IsSelected}" Command="{Binding $parent[UserControl].DataContext.DetailsCommand}" CommandParameter="{Binding}">
                                        <Border Classes="status-badge" VerticalAlignment="Center"
                                                Classes.status-paid="{Binding IsPaid}"
                                                Classes.status-unpaid="{Binding IsUnpaid}"
                                                Classes.status-partial="{Binding IsPartial}">
                                            <TextBlock Text="{Binding PaymentStatus}" FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Process" Width="140" IsVisible="{Binding $parent[UserControl].DataContext.IsProcessVisible}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Classes="row-button" Classes.selected="{Binding IsSelected}" Command="{Binding $parent[UserControl].DataContext.DetailsCommand}" CommandParameter="{Binding}">
                                        <Panel>
                                            <Border Classes="process-badge" VerticalAlignment="Center"
                                                    Classes.process-completed="{Binding IsCompleted}"
                                                    Classes.process-pending="{Binding IsPendingProcess}"
                                                    Classes.process-inprogress="{Binding IsInProgress}"
                                                    Classes.process-review="{Binding IsReview}"
                                                    Classes.process-draft="{Binding IsDraft}"
                                                    Classes.process-submitted="{Binding IsSubmitted}"
                                                    Classes.process-issueraised="{Binding IsIssueRaised}">
                                                <TextBlock Text="{Binding Process}" TextAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="-" Foreground="{DynamicResource TextBody}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="22,0" IsVisible="{Binding HasNoProcess}"/>
                                        </Panel>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Footer -->
            <Grid Grid.Row="3" ColumnDefinitions="Auto, *, Auto" Margin="0,20,0,0">
                <Button Classes="footer-link" Command="{Binding OpenGuideCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                         <i:Icon Value="fa-solid fa-circle-question" Foreground="{DynamicResource TextSecondary}" FontSize="16"/>
                         <TextBlock Text="{Binding GuideLinkText}" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="15" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PaginationDisplay}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" FontSize="13"/>
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Button Command="{Binding PrevPageCommand}" CornerRadius="4" Background="{DynamicResource PaginationBg}" Width="30" Height="30" BorderBrush="{DynamicResource PaginationBorder}" BorderThickness="1">
                            <i:Icon Value="fa-solid fa-chevron-left" FontSize="10"/>
                        </Button>
                        <Button Command="{Binding NextPageCommand}" CornerRadius="4" Background="{DynamicResource PaginationBg}" Width="30" Height="30" BorderBrush="{DynamicResource PaginationBorder}" BorderThickness="1">
                            <i:Icon Value="fa-solid fa-chevron-right" FontSize="10"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
        </ScrollViewer>
        
        <!-- Instruction Guide Popup -->
        <Border ZIndex="10" IsVisible="{Binding IsGuideVisible}" Background="{DynamicResource OverlayBg}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="-20">
            <Border Background="{DynamicResource ModalBg}" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" CornerRadius="12" Width="600" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="30">
                <StackPanel Spacing="20">
                    <!-- Header -->
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <i:Icon Value="fa-regular fa-circle-question" FontSize="20" Foreground="{DynamicResource TextHeading}"/>
                            <TextBlock Text="{Binding PageTitle, StringFormat='{}Guide: {0}'}" Foreground="{DynamicResource TextHeading}" FontSize="20" FontWeight="Bold"/>
                        </StackPanel>
                        <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="5" Command="{Binding CloseGuideCommand}" Cursor="Hand">
                            <i:Icon Value="fa-solid fa-xmark" Foreground="{DynamicResource TextSecondary}" FontSize="16"/>
                        </Button>
                    </Grid>
                    
                    <TextBlock Text="{Binding GuideDescription}" Foreground="{DynamicResource TextSecondary}" FontSize="14" Margin="0,-10,0,10"/>

                    <!-- Grid of features -->
                    <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, *" Margin="0,0,0,10">
                        <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource GuideCardBg}" BorderThickness="0" CornerRadius="8" Padding="15" Margin="0,0,10,10">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Background="{DynamicResource GuideBadgeBg}" CornerRadius="10" Width="20" Height="20">
                                        <TextBlock Text="1" Foreground="{DynamicResource GuideBadgeFg}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{Binding GuideFeature1Title}" Foreground="{DynamicResource TextHeading}" FontWeight="Bold" FontSize="14"/>
                                </StackPanel>
                                <TextBlock Text="{Binding GuideFeature1Text}" Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource GuideCardBg}" BorderThickness="0" CornerRadius="8" Padding="15" Margin="10,0,0,10">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Background="{DynamicResource GuideBadgeBg}" CornerRadius="10" Width="20" Height="20">
                                        <TextBlock Text="2" Foreground="{DynamicResource GuideBadgeFg}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{Binding GuideFeature2Title}" Foreground="{DynamicResource TextHeading}" FontWeight="Bold" FontSize="14"/>
                                </StackPanel>
                                <TextBlock Text="{Binding GuideFeature2Text}" Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource GuideCardBg}" BorderThickness="0" CornerRadius="8" Padding="15" Margin="0,10,10,0">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Background="{DynamicResource GuideBadgeBg}" CornerRadius="10" Width="20" Height="20">
                                        <TextBlock Text="3" Foreground="{DynamicResource GuideBadgeFg}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{Binding GuideFeature3Title}" Foreground="{DynamicResource TextHeading}" FontWeight="Bold" FontSize="14"/>
                                </StackPanel>
                                <TextBlock Text="{Binding GuideFeature3Text}" Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource GuideCardBg}" BorderThickness="0" CornerRadius="8" Padding="15" Margin="10,10,0,0">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Background="{DynamicResource GuideBadgeBg}" CornerRadius="10" Width="20" Height="20">
                                        <TextBlock Text="4" Foreground="{DynamicResource GuideBadgeFg}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{Binding GuideFeature4Title}" Foreground="{DynamicResource TextHeading}" FontWeight="Bold" FontSize="14"/>
                                </StackPanel>
                                <TextBlock Text="{Binding GuideFeature4Text}" Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Pro Tip -->
                    <Border Background="{DynamicResource ProTipBg}" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" CornerRadius="8" Padding="15">
                        <StackPanel Spacing="10">
                            <TextBlock Text="PRO TIP" Foreground="{DynamicResource TextSecondary}" FontWeight="Bold" FontSize="11"/>
                            <TextBlock Text="{Binding GuideProTip}" Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    
                    <Button Content="Got it, thanks!" Background="{DynamicResource GuideGotItBg}" Foreground="{DynamicResource GuideGotItFg}" FontWeight="Bold" CornerRadius="6" Padding="15,8" HorizontalAlignment="Right" Command="{Binding CloseGuideCommand}" Cursor="Hand"/>
                </StackPanel>
            </Border>
        </Border>


        <!-- Premium Global Confirmation Dialog Overlay -->
        <Border ZIndex="1000" IsVisible="{Binding IsDeleteConfirmVisible}" Classes="premium-modal-overlay">
            <Border Classes="premium-modal-content" HorizontalAlignment="Center" VerticalAlignment="Center" Width="480">
                <StackPanel Spacing="28">
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                             <Border Width="48" Height="48" CornerRadius="24" Background="{DynamicResource HoverBg}">
                                <i:Icon Value="fa-solid fa-circle-exclamation" Foreground="{DynamicResource StatusDanger}" FontSize="22"/>
                            </Border>
                            <TextBlock Text="Delete Record?" Foreground="{DynamicResource TextHeading}" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="footer-link" Command="{Binding CancelDeleteSelectedCommand}" VerticalAlignment="Top" Margin="0,-10,-10,0">
                            <i:Icon Value="fa-solid fa-xmark" Foreground="{DynamicResource TextSecondary}" FontSize="20"/>
                        </Button>
                    </Grid>
 
                    <TextBlock Text="{Binding DeleteConfirmMessage}" Foreground="{DynamicResource TextSecondary}" FontSize="16" LineHeight="26" TextWrapping="Wrap"/>
 
                    <Grid ColumnDefinitions="*, 12, *" Margin="0,10,0,0">
                        <Button Grid.Column="0" Content="Cancel" Classes="btn-secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding CancelDeleteSelectedCommand}"/>
                        <Button Grid.Column="2" Content="Delete" Classes="btn-delete" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding ConfirmDeleteSelectedCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>


        <!-- SLIDE-IN DETAIL DRAWER -->
        <Border Classes="drawer-overlay" Classes.open="{Binding IsDrawerOpen}" ZIndex="2000" Margin="0,-70,0,0">
            <Grid ColumnDefinitions="*, 480" VerticalAlignment="Stretch">
                <Button Grid.Column="0" Command="{Binding CloseDrawerCommand}" Background="#01000000" BorderThickness="0" Cursor="Hand"/>
                
                <Border Grid.Column="1" Classes="detail-drawer" Classes.open="{Binding IsDrawerOpen}" VerticalAlignment="Stretch">
                    <Panel>
                        <Grid RowDefinitions="Auto, *, Auto">
                            <!-- Drawer Header -->
                            <Border Grid.Row="0" Background="{DynamicResource DrawerHeaderBg}" Padding="25" BorderBrush="{DynamicResource BorderMuted}" BorderThickness="0,0,0,1">
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <Border Grid.Column="0" Width="64" Height="64" CornerRadius="32" Background="{DynamicResource HoverBg}" BorderBrush="{DynamicResource IconActionBorder}" BorderThickness="1">
                                        <i:Icon Value="fa-solid fa-user" Foreground="{DynamicResource AccentBlue}" FontSize="28"/>
                                    </Border>
                                    
                                    <StackPanel Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayClientName}" Foreground="{DynamicResource TextPrimary}" FontSize="20" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding DisplayTin, StringFormat='{}TIN: {0}'}" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding SelectedRecord.Code, StringFormat='{}ID: #{0}'}" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top" Margin="0,5,0,0">
                                        <Button Command="{Binding DownloadReportCommand}" Classes="icon-action" ToolTip.Tip="Download PDF">
                                            <i:Icon Value="fa-solid fa-download" Foreground="{DynamicResource TextSecondary}" FontSize="18"/>
                                        </Button>
                                        <Button Command="{Binding OpenReportCommand}" Classes="icon-action" ToolTip.Tip="Print/Preview">
                                            <i:Icon Value="fa-solid fa-print" Foreground="{DynamicResource TextSecondary}" FontSize="18"/>
                                        </Button>
                                        <Button Command="{Binding CloseDrawerCommand}" Classes="icon-action">
                                            <i:Icon Value="fa-solid fa-chevron-right" Foreground="{DynamicResource TextFaint}" FontSize="18"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Drawer Content -->
                            <ScrollViewer Grid.Row="1" Padding="25">
                                <StackPanel>
                                    <!-- Client Information Card -->
                                    <StackPanel Spacing="12" Margin="0,0,0,25">
                                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,5">
                                            <i:Icon Value="fa-solid fa-user" Foreground="{DynamicResource TextSecondary}" FontSize="14"/>
                                            <TextBlock Text="Client Information" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                        </StackPanel>
                                        
                                        <Border Classes="drawer-card">
                                            <StackPanel>
                                                <Grid Classes="drawer-field-row" ColumnDefinitions="140, *">
                                                    <TextBlock Grid.Column="0" Text="Individual Name:" Classes="drawer-label"/>
                                                    <Panel Grid.Column="1">
                                                        <TextBlock Text="{Binding DisplayClientName}" Classes="drawer-value" IsVisible="{Binding !IsEditMode}"/>
                                                        <TextBox Text="{Binding EditClientName}" Classes="drawer-input" IsVisible="{Binding IsEditMode}"/>
                                                    </Panel>
                                                </Grid>
                                                
                                                <Grid Classes="drawer-field-row" ColumnDefinitions="140, *" Margin="0">
                                                    <TextBlock Grid.Column="0" Text="Director ID (DIN No):" Classes="drawer-label"/>
                                                    <Panel Grid.Column="1">
                                                        <TextBlock Text="{Binding DisplayDirectorId}" Classes="drawer-value" IsVisible="{Binding !IsEditMode}"/>
                                                        <TextBox Text="{Binding EditDirectorId}" Classes="drawer-input" IsVisible="{Binding IsEditMode}"/>
                                                    </Panel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Module Details Card -->
                                    <StackPanel Spacing="12">
                                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,5">
                                            <i:Icon Value="fa-solid fa-file-lines" Foreground="{DynamicResource TextSecondary}" FontSize="14"/>
                                            <TextBlock Text="{Binding PageTitle, StringFormat='{}{0} Details'}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                        </StackPanel>
                                        
                                        <Border Classes="drawer-card">
                                            <StackPanel>
                                                <Grid Classes="drawer-field-row" ColumnDefinitions="140, *">
                                                    <TextBlock Grid.Column="0" Text="Status:" Classes="drawer-label"/>
                                                    <Panel Grid.Column="1">
                                                        <Border Classes="status-badge" Padding="12,4" Margin="-12,0,0,0" CornerRadius="6" HorizontalAlignment="Left" VerticalAlignment="Center" IsVisible="{Binding !IsEditMode}"
                                                                Background="{DynamicResource HoverBg}" BorderBrush="{DynamicResource IconActionBorder}" BorderThickness="1">
                                                            <TextBlock Text="{Binding DisplayStatus}" Foreground="{DynamicResource TextPrimary}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding EditStatus}" Classes="drawer-input" IsVisible="{Binding IsEditMode}"/>
                                                    </Panel>
                                                </Grid>
                                                
                                                <Grid Classes="drawer-field-row" ColumnDefinitions="140, *">
                                                    <TextBlock Grid.Column="0" Text="Assessment Year:" Classes="drawer-label"/>
                                                    <Panel Grid.Column="1">
                                                        <TextBlock Text="{Binding DisplayAssessmentYear}" Classes="drawer-value" IsVisible="{Binding !IsEditMode}"/>
                                                        <TextBox Text="{Binding EditAssessmentYear}" Classes="drawer-input" IsVisible="{Binding IsEditMode}"/>
                                                    </Panel>
                                                </Grid>
 
                                                <Grid Classes="drawer-field-row" ColumnDefinitions="140, *">
                                                    <TextBlock Grid.Column="0" Text="Current Period:" Classes="drawer-label"/>
                                                    <Panel Grid.Column="1">
                                                        <TextBlock Text="{Binding DisplayCurrentPeriod}" Classes="drawer-value" IsVisible="{Binding !IsEditMode}"/>
                                                        <TextBox Text="{Binding EditCurrentPeriod}" Classes="drawer-input" IsVisible="{Binding IsEditMode}"/>
                                                    </Panel>
                                                </Grid>

                                                <StackPanel Spacing="10" Margin="0,15,0,0">
                                                    <TextBlock Text="Auditor Notes:" Foreground="{DynamicResource TextLabel}" FontSize="13" FontWeight="SemiBold"/>
                                                    <TextBox Text="{Binding EditAuditorNotes}" Classes="drawer-input" 
                                                             AcceptsReturn="True" TextWrapping="Wrap" IsReadOnly="{Binding !IsEditMode}"
                                                             Watermark="Add notes..." MinHeight="120" VerticalContentAlignment="Top"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Drawer Footer -->
                            <Border Grid.Row="2" Background="{DynamicResource DrawerFooterBg}" BorderBrush="{DynamicResource BorderMuted}" BorderThickness="0,1,0,0" Padding="25">
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <Button Grid.Column="0" Classes="icon-action" ToolTip.Tip="Download">
                                        <i:Icon Value="fa-solid fa-download" Foreground="{DynamicResource TextSecondary}" FontSize="16"/>
                                    </Button>

                                    <!-- Action Buttons (View Mode) -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" IsVisible="{Binding !IsEditMode}">
                                        <Button Content="Edit" Command="{Binding EnterEditModeCommand}" Classes="btn-drawer-edit" MinWidth="100"/>
                                        <Button Content="Delete" Command="{Binding RequestDeleteDrawerRecordCommand}" Classes="btn-drawer-delete" MinWidth="100"/>
                                    </StackPanel>

                                    <!-- Action Buttons (Edit Mode) -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" IsVisible="{Binding IsEditMode}">
                                        <Button Content="Cancel" Command="{Binding CancelEditCommand}" Classes="btn-drawer-edit" MinWidth="100"/>
                                        <Button Content="Save" Command="{Binding SaveEditCommand}" Classes="btn-drawer-save" MinWidth="100"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Delete Confirmation Overlay (Inside Drawer) -->
                        <Border IsVisible="{Binding IsDrawerDeleteConfirmVisible}" Background="{DynamicResource OverlayBg}" ZIndex="100">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20" Width="300">
                                <i:Icon Value="fa-solid fa-circle-exclamation" Foreground="{DynamicResource StatusDanger}" FontSize="40" HorizontalAlignment="Center"/>
                                <TextBlock Text="Delete this record?" Foreground="{DynamicResource TextPrimary}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Text="This action cannot be undone." Foreground="{DynamicResource TextSecondary}" FontSize="13" HorizontalAlignment="Center" TextAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" Margin="0,10,0,0">
                                    <Button Content="No, Keep it" Command="{Binding CancelDrawerDeleteCommand}" Classes="btn-drawer-edit" Padding="15,8"/>
                                    <Button Content="Yes, Delete" Command="{Binding ConfirmDrawerDeleteCommand}" Classes="btn-drawer-delete" Padding="15,8"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Discard Changes Confirmation Overlay (Inside Drawer) -->
                        <Border IsVisible="{Binding IsDiscardConfirmVisible}" Background="{DynamicResource OverlayBg}" ZIndex="101">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20" Width="300">
                                <i:Icon Value="fa-solid fa-triangle-exclamation" Foreground="{DynamicResource StatusWarning}" FontSize="40" HorizontalAlignment="Center"/>
                                <TextBlock Text="Discard changes?" Foreground="{DynamicResource TextPrimary}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Text="Any unsaved progress will be lost." Foreground="{DynamicResource TextSecondary}" FontSize="13" HorizontalAlignment="Center" TextAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" Margin="0,10,0,0">
                                    <Button Content="Keep Editing" Command="{Binding CancelDiscardCommand}" Classes="btn-drawer-edit" Padding="15,8"/>
                                    <Button Content="Discard" Command="{Binding ConfirmDiscardCommand}" Classes="btn-drawer-delete" Padding="15,8"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Panel>
                </Border>
            </Grid>
        </Border>

    </Panel>
</UserControl>
