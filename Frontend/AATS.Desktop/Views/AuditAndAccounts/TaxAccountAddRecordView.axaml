<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AATS.Desktop.ViewModels.AuditAndAccounts"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="1000"
             x:Class="AATS.Desktop.Views.AuditAndAccounts.TaxAccountAddRecordView"
             x:DataType="vm:TaxAccountAddRecordViewModel"
             x:CompileBindings="False">

    <UserControl.Styles>
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextHeading}"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>
        <Style Selector="TextBlock.input-label">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextHeading}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style Selector="TextBox.form-input">
            <Setter Property="Background" Value="{DynamicResource InputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextInput}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="TextBox.form-input:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource InputBg}"/>
        </Style>
        
        <Style Selector="Border.card-panel">
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="25"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>

        <Style Selector="Button.upload-trigger">
            <Setter Property="Background" Value="{DynamicResource InputBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.upload-trigger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
        </Style>

        <Style Selector="Button.btn-cancel">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TextBody}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="Button.btn-save">
            <Setter Property="Background" Value="{DynamicResource TextInput}"/>
            <Setter Property="Foreground" Value="{DynamicResource DrawerHeaderBg}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        
        <Style Selector="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextInput}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,20,0"/>
        </Style>

        <!-- Footer Link Styling (Learn More) -->
        <Style Selector="Button.footer-link">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.footer-link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </UserControl.Styles>

    <Panel>
        <ScrollViewer>
            <Grid RowDefinitions="Auto, *" Margin="25,20,15,20">
                <!-- Header -->
                <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,25">
                    <TextBlock Text="Tax Account - Add Record" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="15">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource StatusDanger}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,15,0" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <Button Classes="btn-cancel" Content="Cancel" Command="{Binding $parent[Window].DataContext.GoBackCommand}"/>
                        <Button Classes="btn-save" Command="{Binding SaveRecordCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <i:Icon Value="fa-regular fa-floppy-disk" FontSize="14"/>
                                <TextBlock Text="Save Record"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Main Form Area -->
                <Grid Grid.Row="1" ColumnDefinitions="6*, 4*" Margin="0,0,0,20">
                    <!-- Left Column -->
                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <!-- General Details -->
                        <Border Classes="card-panel">
                            <StackPanel>
                                <TextBlock Text="General Details" Classes="section-title"/>
                                
                                <Grid ColumnDefinitions="*, *">
                                    <StackPanel Grid.Column="0" Margin="0,0,15,0" Spacing="20">
                                        <StackPanel>
                                            <TextBlock Text="ID" Classes="input-label"/>
                                            <TextBox Classes="form-input integer-input" Watermark="Enter ID" Text="{Binding Id}"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Date" Classes="input-label"/>
                                            <CalendarDatePicker SelectedDate="{Binding Date}" HorizontalAlignment="Stretch" BorderBrush="{DynamicResource BorderDefault}" Background="{DynamicResource InputBg}" Padding="10,6" CornerRadius="6" Height="38"/>
                                        </StackPanel>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Column="1" Margin="15,0,0,0">
                                        <TextBlock Text="Client Logo (Optional)" Classes="input-label"/>
                                        <Button Classes="upload-trigger" Height="140" HorizontalAlignment="Stretch" Command="{Binding UploadLogoCommand}">
                                            <Panel>
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" IsVisible="{Binding !HasClientLogo}">
                                                    <i:Icon Value="fa-solid fa-cloud-arrow-up" FontSize="26" Foreground="{DynamicResource TextSecondary}"/>
                                                </StackPanel>
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" IsVisible="{Binding HasClientLogo}">
                                                    <i:Icon Value="fa-regular fa-image" FontSize="32" Foreground="{DynamicResource AccentPrimary}"/>
                                                    <TextBlock Text="{Binding ClientLogo}" Foreground="{DynamicResource TextInput}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="150"/>
                                                </StackPanel>
                                            </Panel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Margin="0,20,0,0">
                                    <TextBlock Text="Client Name" Classes="input-label"/>
                                    <TextBox Classes="form-input" Watermark="Enter client name" Text="{Binding ClientName}"/>
                                </StackPanel>

                                <StackPanel Margin="0,20,0,0">
                                    <TextBlock Text="Assignment" Classes="input-label"/>
                                    <TextBox Classes="form-input" Watermark="Enter assignment details..." Text="{Binding Assignment}" Height="100" AcceptsReturn="True" TextWrapping="Wrap"/>
                                </StackPanel>

                                <StackPanel Margin="0,20,0,0">
                                    <TextBlock Text="Notes (Optional)" Classes="input-label"/>
                                    <TextBox Classes="form-input" Watermark="Add notes..." Text="{Binding Notes}" Height="100" AcceptsReturn="True" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Footer Links -->
                        <StackPanel Margin="0,20,0,0">
                            <Button Classes="footer-link" Command="{Binding OpenGuideCommand}" Padding="0" HorizontalAlignment="Left" Cursor="Hand">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <i:Icon Value="fa-solid fa-circle-question" Foreground="{DynamicResource TextSecondary}" FontSize="16"/>
                                    <TextBlock Text="Learn more about Tax Account Records" Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- Right Column: Payment Summary Section -->
                    <Border Grid.Column="1" Classes="card-panel" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Payment Summary" Classes="section-title"/>

                            <!-- Sub Total -->
                            <StackPanel Margin="0,0,0,25">
                                <TextBlock Text="Sub Total" Classes="input-label"/>
                                <TextBox Classes="form-input numeric-input" Text="{Binding SubTotal, TargetNullValue='', FallbackValue='0'}">
                                    <TextBox.InnerLeftContent>
                                        <TextBlock Text="LKR " Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="12,0,5,0" FontSize="13"/>
                                    </TextBox.InnerLeftContent>
                                </TextBox>
                            </StackPanel>

                            <!-- Payment Option -->
                            <StackPanel Margin="0,0,0,25">
                                <TextBlock Text="Payment Option" Classes="input-label"/>
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <RadioButton Content="Cash" IsChecked="{Binding IsOptionCash}"/>
                                    <RadioButton Content="Online" IsChecked="{Binding IsOptionOnline}"/>
                                    <RadioButton Content="Cheque" IsChecked="{Binding IsOptionCheque}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Payment Status -->
                            <StackPanel Margin="0,0,0,25">
                                <TextBlock Text="Payment Status" Classes="input-label"/>
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <RadioButton Content="Paid" IsChecked="{Binding IsStatusPaid}"/>
                                    <RadioButton Content="Unpaid" IsChecked="{Binding IsStatusUnpaid}"/>
                                    <RadioButton Content="Partial" IsChecked="{Binding IsStatusPartial}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Discount -->
                            <StackPanel Margin="0,0,0,25">
                                <TextBlock Text="Discount" Classes="input-label"/>
                                <TextBox Classes="form-input numeric-input" Text="{Binding Discount, TargetNullValue='', FallbackValue='0'}"/>
                            </StackPanel>

                            <!-- Total Block -->
                            <Border Background="{DynamicResource DrawerHeaderBg}" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,15,0,0">
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Text="Total Payment:" Foreground="{DynamicResource TextHeading}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                                        <TextBlock Text="{Binding TotalPayment, StringFormat='{}{0:N2}'}" Foreground="{DynamicResource TextHeading}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- Save Confirmation Dialog Overlay -->
        <Border ZIndex="100" IsVisible="{Binding IsConfirmSaveVisible}" Background="#66000000"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Background="{DynamicResource DrawerHeaderBg}" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" CornerRadius="12"
                    Width="420" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Padding="30" BoxShadow="0 8 32 0 #66000000">
                <StackPanel Spacing="20">
                    <!-- Dialog Title -->
                    <TextBlock Text="{Binding ConfirmSaveTitle}" Foreground="{DynamicResource TextHeading}" FontSize="18" FontWeight="Bold"/>
                    
                    <!-- Dialog Message -->
                    <TextBlock Text="{Binding ConfirmSaveMessage}" Foreground="{DynamicResource TextSecondary}" FontSize="14" TextWrapping="Wrap" LineHeight="22"/>
                    
                    <!-- Dialog Buttons -->
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Discard changes" Classes="btn-delete"
                                Command="{Binding DiscardChangesCommand}" Cursor="Hand"/>
                        <Button Content="Save Record" Background="{DynamicResource AccentPrimary}" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"
                                Padding="25,10" CornerRadius="8"
                                Command="{Binding ConfirmSaveCommand}" Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Instruction Guide Popup Overlay -->
        <Border ZIndex="10" IsVisible="{Binding IsGuideVisible}" Background="#66000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" CornerRadius="12" Width="600" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="30">
                <StackPanel Spacing="25">
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <i:Icon Value="fa-solid fa-circle-question" FontSize="22" Foreground="{DynamicResource TextHeading}"/>
                            <TextBlock Text="Guide: Tax Account" Foreground="{DynamicResource TextHeading}" FontSize="20" FontWeight="Bold"/>
                        </StackPanel>
                        <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="5" Command="{Binding CloseGuideCommand}" Cursor="Hand">
                            <i:Icon Value="fa-solid fa-xmark" Foreground="{DynamicResource TextSecondary}" FontSize="18"/>
                        </Button>
                    </Grid>

                    <TextBlock Text="Comprehensive tax filing and compliance management for corporate and personal clients." Foreground="{DynamicResource TextSecondary}" FontSize="14" Margin="0,-15,0,0" TextWrapping="Wrap"/>

                    <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto">
                        <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource GuideCardBg}" CornerRadius="8" Padding="15" Margin="0,0,10,10">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Background="{DynamicResource GuideGotItBg}" CornerRadius="10" Width="20" Height="20">
                                        <TextBlock Text="1" Foreground="{DynamicResource GuideCardBg}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Tax Identity" Foreground="{DynamicResource TextHeading}" FontWeight="Bold" FontSize="14"/>
                                </StackPanel>
                                <TextBlock Text="Verify the Tax Record ID and client details to ensure accurate filing history." Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource GuideCardBg}" CornerRadius="8" Padding="15" Margin="10,0,0,10">
                             <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Background="{DynamicResource GuideGotItBg}" CornerRadius="10" Width="20" Height="20">
                                        <TextBlock Text="2" Foreground="{DynamicResource GuideCardBg}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Compliance Data" Foreground="{DynamicResource TextHeading}" FontWeight="Bold" FontSize="14"/>
                                </StackPanel>
                                <TextBlock Text="Input detailed assignment scopes to track various tax services and compliances." Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Button Command="{Binding CloseGuideCommand}" Content="Got it, thanks!" Background="{DynamicResource AppBackground}" Foreground="{DynamicResource GuideCardBg}" FontWeight="Bold" CornerRadius="6" Padding="20,10" HorizontalAlignment="Right" Cursor="Hand"/>
                </StackPanel>
            </Border>
        </Border>
    </Panel>
</UserControl>
