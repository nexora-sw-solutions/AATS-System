# =====================================================================
# AATS Environment Variables Template (.env.example)
# Copy this file to .env and replace placeholders with actual secrets.
# =====================================================================

# Database Connection String
ConnectionStrings__DefaultConnection=Server=[YOUR_SUPABASE_HOST];Database=postgres;Port=5432;User Id=postgres;Password=[YOUR_DB_PASSWORD];Ssl Mode=Require;Trust Server Certificate=true;Pooling=false;Command Timeout=60;

# JWT Configuration
Jwt__Key=[YOUR_SECRET_JWT_SIGNING_KEY]
Jwt__Issuer=AATS.API
Jwt__Audience=AATS.App

# SMTP Configuration
Smtp__Host=smtp.gmail.com
Smtp__Port=587
Smtp__EnableSsl=true
Smtp__Username=[YOUR_SMTP_EMAIL]
Smtp__Password=[YOUR_SMTP_APP_PASSWORD]
Smtp__FromEmail=[YOUR_SMTP_EMAIL]
Smtp__FromName=AATS System

# Cloudflare R2 Configuration
CloudflareR2__AccountId=[YOUR_R2_ACCOUNT_ID]
CloudflareR2__AccessKey=[YOUR_R2_ACCESS_KEY]
CloudflareR2__SecretKey=[YOUR_R2_SECRET_KEY]
CloudflareR2__BucketName=aats
CloudflareR2__SourceDocsFolder=Audit & assurance source docs
CloudflareR2__PublicBaseUrl=[YOUR_R2_PUBLIC_BUCKET_URL]
