<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AATS.Desktop.ViewModels.SecretarialAdvisory"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="1200"
             x:Class="AATS.Desktop.Views.SecretarialAdvisory.AddBOIView"
             x:DataType="vm:AddBOIViewModel"
             x:CompileBindings="False">

    <UserControl.Styles>
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextHeading}"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>
        <Style Selector="TextBlock.input-label">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextHeading}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style Selector="TextBox.form-input">
            <Setter Property="Background" Value="{DynamicResource InputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextInput}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="TextBox.form-input:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource InputBg}"/>
        </Style>
        
        <Style Selector="Border.card-panel">
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="25"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>


        
        <Style Selector="Button.guide-link-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.guide-link-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Opacity" Value="0.8"/>
        </Style>

        <Style Selector="Button.upload-trigger">
            <Setter Property="Background" Value="#0A1121"/>
            <Setter Property="BorderBrush" Value="{DynamicResource IconActionBorder}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Height" Value="180"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.upload-trigger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#111B31"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
        </Style>
        <Style Selector="Button.upload-trigger:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#162342"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
        </Style>
        
        <Style Selector="Button.action-btn-premium">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.action-btn-premium:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SelectionIndicatorBg}"/>
        </Style>
    </UserControl.Styles>

    <Panel>
        <ScrollViewer>
            <Grid RowDefinitions="Auto, *" Margin="25,20,15,20">
                <!-- Header -->
                <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,25">
                    <StackPanel Spacing="5" VerticalAlignment="Center">
                        <TextBlock Text="Add BOI Record" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="15" VerticalAlignment="Bottom">
                        <Button Classes="btn-cancel" Content="Cancel" Command="{Binding DiscardChangesCommand}"/>
                        <Button Classes="btn-save" Command="{Binding SaveRecordCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <i:Icon Value="fa-regular fa-floppy-disk" FontSize="14"/>
                                <TextBlock Text="Save Record"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Form Area -->
                <StackPanel Grid.Row="1">
                    <!-- General Details Card -->
                    <Border Classes="card-panel">
                        <StackPanel Spacing="20">
                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,20">
                                <i:Icon Value="fa-solid fa-address-card" Foreground="{DynamicResource AccentPrimary}" FontSize="18"/>
                                <TextBlock Text="GENERAL DETAILS" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            
                            <!-- ID and Date Row -->
                            <Grid ColumnDefinitions="*, *">
                                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                    <TextBlock Text="ID" Classes="input-label"/>
                                                                                <Grid ColumnDefinitions="Auto, *">
                                        <!-- Subtle premium vertical bookmark indicator ribbon on the left-edge of the field -->
                                        <Rectangle Grid.Column="0" Width="4" Height="24" Fill="{Binding SelectedClientCategoryColor}" Margin="0,0,8,0" RadiusX="2" RadiusY="2" IsVisible="{Binding HasSelectedClientCategory}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Classes="form-input" Watermark="Enter Client ID (e.g. CL-00001)" Text="{Binding ClientId}" Name="ClientIdTextBox"/>
                                    </Grid>
                                            <Popup IsOpen="{Binding IsClientCodeDropdownOpen}" 
                                                   PlacementTarget="{Binding #ClientIdTextBox}"
                                                   Placement="Bottom"
                                                   PlacementGravity="Bottom"
                                                   PlacementAnchor="Bottom"
                                                   HorizontalOffset="0"
                                                   VerticalOffset="2"
                                                   IsLightDismissEnabled="True"
                                                   MaxHeight="220"
                                                   Width="{Binding #ClientIdTextBox.Bounds.Width}">
                                                <Border Background="{DynamicResource CardBg}" 
                                                        BorderBrush="{DynamicResource BorderDefault}" 
                                                        BorderThickness="1" 
                                                        CornerRadius="0,0,6,6" 
                                                        BoxShadow="0 4 16 0 #40000000"
                                                        ClipToBounds="True">
                                                    <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto" IsScrollChainingEnabled="False">
                                                        <ItemsControl ItemsSource="{Binding ClientCodeSuggestions}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                                                    <Button Background="Transparent" 
                                        BorderThickness="0" 
                                        Padding="0" 
                                        HorizontalAlignment="Stretch" 
                                        HorizontalContentAlignment="Stretch"
                                        Cursor="Hand"
                                        Command="{Binding $parent[UserControl].DataContext.SelectClientCodeCommand}" 
                                        CommandParameter="{Binding}">
                                    <Grid ColumnDefinitions="Auto, *" Height="36" Background="Transparent">
                                        <!-- Subtle premium vertical bookmark accent strip -->
                                        <Rectangle Grid.Column="0" Width="4" Height="20" Fill="{Binding CategoryColor}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0" RadiusX="2" RadiusY="2"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" Margin="10,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ClientCode}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" FontSize="13"/>
                                            <TextBlock Text="-" Foreground="{DynamicResource TextSecondary}" Opacity="0.7" FontSize="13"/>
                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextSecondary}" Opacity="0.8" FontSize="12" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </Border>
                                            </Popup>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="15,0,0,0">
                                    <TextBlock Text="Date" Classes="input-label"/>
                                    <CalendarDatePicker SelectedDate="{Binding Date}" HorizontalAlignment="Stretch" BorderBrush="{DynamicResource BorderDefault}" Background="{DynamicResource InputBg}" Padding="10,6" CornerRadius="6" Height="38"/>
                                </StackPanel>
                            </Grid>

                            <!-- Client and Company Row -->
                            <Grid ColumnDefinitions="*, *">
                                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                    <TextBlock Text="Client Name" Classes="input-label"/>
                                    <TextBox Classes="form-input" Watermark="Client Name" Text="{Binding ClientName}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="15,0,0,0">
                                    <TextBlock Text="Company Name" Classes="input-label"/>
                                    <TextBox Classes="form-input" Watermark="Company Name" Text="{Binding CompanyName}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Code and Country Row -->
                            <Grid ColumnDefinitions="*, *">
                                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                    <TextBlock Text="Code" Classes="input-label"/>
                                    <TextBox Classes="form-input" Watermark="BOI Code" Text="{Binding Code}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="15,0,0,0">
                                    <TextBlock Text="Country" Classes="input-label"/>
                                    <TextBox Classes="form-input" Watermark="Country" Text="{Binding Country}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Address and Investment Row -->
                            <Grid ColumnDefinitions="*, *">
                                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                    <TextBlock Text="Country address" Classes="input-label"/>
                                    <TextBox Classes="form-input" Watermark="Country address" Text="{Binding CountryAddress}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="15,0,0,0">
                                    <TextBlock Text="Investment Value (USD)" Classes="input-label"/>
                                    <TextBox Classes="form-input numeric-input" Watermark="Investment Value in USD" Text="{Binding InvestmentValue}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Assignment Area -->
                            <StackPanel>
                                <TextBlock Text="Assignment" Classes="input-label"/>
                                <TextBox Classes="form-input" Watermark="Assignment details..." Text="{Binding Assignment}" Height="120" AcceptsReturn="True" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    
                    <!-- Documents Card 1 -->
                    <Border Classes="card-panel">
                        <StackPanel Spacing="20">
                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,20">
                                <i:Icon Value="fa-solid fa-folder-open" Foreground="{DynamicResource AccentPrimary}" FontSize="18"/>
                                <TextBlock Text="REQUIRED DOCUMENTS - PART 1" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Tabs -->
                            <Border BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal" Spacing="0">
                                    <Button Classes="tab-btn" Classes.selected="{Binding SelectedCard1Tab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Approval Letter'}" Command="{Binding SelectCard1TabCommand}" CommandParameter="Approval Letter">
                                        <TextBlock Text="Approval Letter"/>
                                    </Button>
                                    <Button Classes="tab-btn" Classes.selected="{Binding SelectedCard1Tab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Passport'}" Command="{Binding SelectCard1TabCommand}" CommandParameter="Passport">
                                        <TextBlock Text="Passport"/>
                                    </Button>
                                    <Button Classes="tab-btn" Classes.selected="{Binding SelectedCard1Tab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Investment'}" Command="{Binding SelectCard1TabCommand}" CommandParameter="Investment">
                                        <TextBlock Text="Investment"/>
                                    </Button>
                                    <Button Classes="tab-btn" Classes.selected="{Binding SelectedCard1Tab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Residential Visa'}" Command="{Binding SelectCard1TabCommand}" CommandParameter="Residential Visa">
                                        <TextBlock Text="Residential Visa"/>
                                    </Button>
                                    <Button Classes="tab-btn" Classes.selected="{Binding SelectedCard1Tab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='IIA Account'}" Command="{Binding SelectCard1TabCommand}" CommandParameter="IIA Account">
                                        <TextBlock Text="IIA Account"/>
                                    </Button>
                                    <Button Classes="tab-btn" Classes.selected="{Binding SelectedCard1Tab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Bank Letter'}" Command="{Binding SelectCard1TabCommand}" CommandParameter="Bank Letter">
                                        <TextBlock Text="Bank Letter"/>
                                    </Button>
                                    <Button Classes="tab-btn" Classes.selected="{Binding SelectedCard1Tab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Company Registration'}" Command="{Binding SelectCard1TabCommand}" CommandParameter="Company Registration">
                                        <TextBlock Text="Company Registration"/>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Tab Content -->
                            <ScrollViewer MaxHeight="450" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <!-- Approval Letter Tab -->
                                    <StackPanel IsVisible="{Binding SelectedCard1Tab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Approval Letter'}">
                                        <ItemsControl ItemsSource="{Binding ApprovalLetterFiles}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource DrawerHeaderBg}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                                            <i:Icon Value="fa-solid fa-file" Foreground="{DynamicResource AccentPrimary}" FontSize="16" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding FileName}" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextInput}"/>
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                                                <Button Command="{Binding $parent[ItemsControl].DataContext.PreviewDocumentCommand}" CommandParameter="{Binding Url}" Classes="action-btn-premium">
                                                                    <i:Icon Value="fa-solid fa-eye" Foreground="{DynamicResource AccentPrimary}" FontSize="14"/>
                                                                </Button>
                                                                <Button Command="{Binding $parent[ItemsControl].DataContext.ShowRemoveApprovalLetterFileConfirmCommand}" CommandParameter="{Binding}" Classes="action-btn-premium">
                                                                    <i:Icon Value="fa-solid fa-trash-can" Foreground="{DynamicResource StatusDanger}" FontSize="14"/>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        
                                        <!-- Upload Area -->
                                        <Button Classes="action-btn-premium" HorizontalAlignment="Left" Command="{Binding PickApprovalLetterFilesCommand}" Margin="0,16,0,0">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <i:Icon Value="fa-solid fa-plus" Foreground="{DynamicResource AccentPrimary}"/>
                                                <TextBlock Text="Add Approval Letter" Foreground="{DynamicResource AccentPrimary}" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <!-- Passport Tab -->
                                    <StackPanel IsVisible="{Binding SelectedCard1Tab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Passport'}">
                                        <ItemsControl ItemsSource="{Binding PassportFiles}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource DrawerHeaderBg}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                                            <i:Icon Value="fa-solid fa-file" Foreground="{DynamicResource AccentPrimary}" FontSize="16" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding FileName}" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextInput}"/>
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                                                <Button Command="{Binding $parent[ItemsControl].DataContext.PreviewDocumentCommand}" CommandParameter="{Binding Url}" Classes="action-btn-premium">
                                                                    <i:Icon Value="fa-solid fa-eye" Foreground="{DynamicResource AccentPrimary}" FontSize="14"/>
                                                                </Button>
                                                                <Button Command="{Binding $parent[ItemsControl].DataContext.ShowRemovePassportFileConfirmCommand}" CommandParameter="{Binding}" Classes="action-btn-premium">
                                                                    <i:Icon Value="fa-solid fa-trash-can" Foreground="{DynamicResource StatusDanger}" FontSize="14"/>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        
                                        <!-- Upload Area -->
                                        <Button Classes="action-btn-premium" HorizontalAlignment="Left" Command="{Binding PickPassportFilesCommand}" Margin="0,16,0,0">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <i:Icon Value="fa-solid fa-plus" Foreground="{DynamicResource AccentPrimary}"/>
                                                <TextBlock Text="Add Passport" Foreground="{DynamicResource AccentPrimary}" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <!-- Investment Tab -->
                                    <StackPanel IsVisible="{Binding SelectedCard1Tab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Investment'}">
                                        <ItemsControl ItemsSource="{Binding InvestmentFiles}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource DrawerHeaderBg}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                                            <i:Icon Value="fa-solid fa-file" Foreground="{DynamicResource AccentPrimary}" FontSize="16" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding FileName}" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextInput}"/>
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                                                <Button Command="{Binding $parent[ItemsControl].DataContext.PreviewDocumentCommand}" CommandParameter="{Binding Url}" Classes="action-btn-premium">
                                                                    <i:Icon Value="fa-solid fa-eye" Foreground="{DynamicResource AccentPrimary}" FontSize="14"/>
                                                                </Button>
                                                                <Button Command="{Binding $parent[ItemsControl].DataContext.ShowRemoveInvestmentFileConfirmCommand}" CommandParameter="{Binding}" Classes="action-btn-premium">
                                                                    <i:Icon Value="fa-solid fa-trash-can" Foreground="{DynamicResource StatusDanger}" FontSize="14"/>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        
                                        <!-- Upload Area -->
                                        <Button Classes="action-btn-premium" HorizontalAlignment="Left" Command="{Binding PickInvestmentFilesCommand}" Margin="0,16,0,0">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <i:Icon Value="fa-solid fa-plus" Foreground="{DynamicResource AccentPrimary}"/>
                                                <TextBlock Text="Add Investment" Foreground="{DynamicResource AccentPrimary}" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <!-- Residential Visa Tab -->
                                    <StackPanel IsVisible="{Binding SelectedCard1Tab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Residential Visa'}">
                                        <ItemsControl ItemsSource="{Binding ResidentialVisaFiles}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource DrawerHeaderBg}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                                            <i:Icon Value="fa-solid fa-file" Foreground="{DynamicResource AccentPrimary}" FontSize="16" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding FileName}" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextInput}"/>
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                                                <Button Command="{Binding $parent[ItemsControl].DataContext.PreviewDocumentCommand}" CommandParameter="{Binding Url}" Classes="action-btn-premium">
                                                                    <i:Icon Value="fa-solid fa-eye" Foreground="{DynamicResource AccentPrimary}" FontSize="14"/>
                                                                </Button>
                                                                <Button Command="{Binding $parent[ItemsControl].DataContext.ShowRemoveResidentialVisaFileConfirmCommand}" CommandParameter="{Binding}" Classes="action-btn-premium">
                                                                    <i:Icon Value="fa-solid fa-trash-can" Foreground="{DynamicResource StatusDanger}" FontSize="14"/>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        
                                        <!-- Upload Area -->
                                        <Button Classes="action-btn-premium" HorizontalAlignment="Left" Command="{Binding PickResidentialVisaFilesCommand}" Margin="0,16,0,0">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <i:Icon Value="fa-solid fa-plus" Foreground="{DynamicResource AccentPrimary}"/>
                                                <TextBlock Text="Add Residential Visa" Foreground="{DynamicResource AccentPrimary}" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <!-- IIA Account Tab -->
                                    <StackPanel IsVisible="{Binding SelectedCard1Tab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='IIA Account'}">
                                        <ItemsControl ItemsSource="{Binding IiaAccountFiles}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource DrawerHeaderBg}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                                            <i:Icon Value="fa-solid fa-file" Foreground="{DynamicResource AccentPrimary}" FontSize="16" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding FileName}" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextInput}"/>
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                                                <Button Command="{Binding $parent[ItemsControl].DataContext.PreviewDocumentCommand}" CommandParameter="{Binding Url}" Classes="action-btn-premium">
                                                                    <i:Icon Value="fa-solid fa-eye" Foreground="{DynamicResource AccentPrimary}" FontSize="14"/>
                                                                </Button>
                                                                <Button Command="{Binding $parent[ItemsControl].DataContext.ShowRemoveIiaAccountFileConfirmCommand}" CommandParameter="{Binding}" Classes="action-btn-premium">
                                                                    <i:Icon Value="fa-solid fa-trash-can" Foreground="{DynamicResource StatusDanger}" FontSize="14"/>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        
                                        <!-- Upload Area -->
                                        <Button Classes="action-btn-premium" HorizontalAlignment="Left" Command="{Binding PickIiaAccountFilesCommand}" Margin="0,16,0,0">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <i:Icon Value="fa-solid fa-plus" Foreground="{DynamicResource AccentPrimary}"/>
                                                <TextBlock Text="Add IIA Account" Foreground="{DynamicResource AccentPrimary}" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <!-- Bank Letter Tab -->
                                    <StackPanel IsVisible="{Binding SelectedCard1Tab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Bank Letter'}">
                                        <ItemsControl ItemsSource="{Binding BankLetterFiles}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource DrawerHeaderBg}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                                            <i:Icon Value="fa-solid fa-file" Foreground="{DynamicResource AccentPrimary}" FontSize="16" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding FileName}" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextInput}"/>
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                                                <Button Command="{Binding $parent[ItemsControl].DataContext.PreviewDocumentCommand}" CommandParameter="{Binding Url}" Classes="action-btn-premium">
                                                                    <i:Icon Value="fa-solid fa-eye" Foreground="{DynamicResource AccentPrimary}" FontSize="14"/>
                                                                </Button>
                                                                <Button Command="{Binding $parent[ItemsControl].DataContext.ShowRemoveBankLetterFileConfirmCommand}" CommandParameter="{Binding}" Classes="action-btn-premium">
                                                                    <i:Icon Value="fa-solid fa-trash-can" Foreground="{DynamicResource StatusDanger}" FontSize="14"/>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        
                                        <!-- Upload Area -->
                                        <Button Classes="action-btn-premium" HorizontalAlignment="Left" Command="{Binding OpenBankLetterPopupCommand}" Margin="0,16,0,0">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <i:Icon Value="fa-solid fa-plus" Foreground="{DynamicResource AccentPrimary}"/>
                                                <TextBlock Text="Add Bank Letter" Foreground="{DynamicResource AccentPrimary}" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <!-- Company Registration Tab -->
                                    <StackPanel IsVisible="{Binding SelectedCard1Tab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Company Registration'}">
                                        <ItemsControl ItemsSource="{Binding CompanyRegistrationFiles}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource DrawerHeaderBg}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                                            <i:Icon Value="fa-solid fa-file" Foreground="{DynamicResource AccentPrimary}" FontSize="16" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding FileName}" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextInput}"/>
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                                                <Button Command="{Binding $parent[ItemsControl].DataContext.PreviewDocumentCommand}" CommandParameter="{Binding Url}" Classes="action-btn-premium">
                                                                    <i:Icon Value="fa-solid fa-eye" Foreground="{DynamicResource AccentPrimary}" FontSize="14"/>
                                                                </Button>
                                                                <Button Command="{Binding $parent[ItemsControl].DataContext.ShowRemoveCompanyRegistrationFileConfirmCommand}" CommandParameter="{Binding}" Classes="action-btn-premium">
                                                                    <i:Icon Value="fa-solid fa-trash-can" Foreground="{DynamicResource StatusDanger}" FontSize="14"/>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        
                                        <!-- Upload Area -->
                                        <Button Classes="action-btn-premium" HorizontalAlignment="Left" Command="{Binding PickCompanyRegistrationFilesCommand}" Margin="0,16,0,0">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <i:Icon Value="fa-solid fa-plus" Foreground="{DynamicResource AccentPrimary}"/>
                                                <TextBlock Text="Add Company Registration" Foreground="{DynamicResource AccentPrimary}" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- Documents Card 2 -->
                    <Border Classes="card-panel">
                        <StackPanel Spacing="20">
                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,20">
                                <i:Icon Value="fa-solid fa-folder-open" Foreground="{DynamicResource AccentPrimary}" FontSize="18"/>
                                <TextBlock Text="REQUIRED DOCUMENTS - PART 2" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Tabs -->
                            <Border BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal" Spacing="0">
                                    <Button Classes="tab-btn" Classes.selected="{Binding SelectedCard2Tab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='BOI Payment Slip'}" Command="{Binding SelectCard2TabCommand}" CommandParameter="BOI Payment Slip">
                                        <TextBlock Text="BOI Payment Slip"/>
                                    </Button>
                                    <Button Classes="tab-btn" Classes.selected="{Binding SelectedCard2Tab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='VAT Certificate'}" Command="{Binding SelectCard2TabCommand}" CommandParameter="VAT Certificate">
                                        <TextBlock Text="VAT Certificate"/>
                                    </Button>
                                    <Button Classes="tab-btn" Classes.selected="{Binding SelectedCard2Tab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='TDL Letter'}" Command="{Binding SelectCard2TabCommand}" CommandParameter="TDL Letter">
                                        <TextBlock Text="TDL Letter"/>
                                    </Button>
                                    <Button Classes="tab-btn" Classes.selected="{Binding SelectedCard2Tab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Plan'}" Command="{Binding SelectCard2TabCommand}" CommandParameter="Plan">
                                        <TextBlock Text="Plan"/>
                                    </Button>
                                    <Button Classes="tab-btn" Classes.selected="{Binding SelectedCard2Tab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Business Proposal'}" Command="{Binding SelectCard2TabCommand}" CommandParameter="Business Proposal">
                                        <TextBlock Text="Business Proposal"/>
                                    </Button>
                                    <Button Classes="tab-btn" Classes.selected="{Binding SelectedCard2Tab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Cover Letter'}" Command="{Binding SelectCard2TabCommand}" CommandParameter="Cover Letter">
                                        <TextBlock Text="Cover Letter"/>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Tab Content -->
                            <ScrollViewer MaxHeight="450" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <!-- BOI Payment Slip Tab -->
                                    <StackPanel IsVisible="{Binding SelectedCard2Tab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='BOI Payment Slip'}">
                                        <ItemsControl ItemsSource="{Binding BoiPaymentSlipFiles}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource DrawerHeaderBg}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                                            <i:Icon Value="fa-solid fa-file" Foreground="{DynamicResource AccentPrimary}" FontSize="16" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding FileName}" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextInput}"/>
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                                                <Button Command="{Binding $parent[ItemsControl].DataContext.PreviewDocumentCommand}" CommandParameter="{Binding Url}" Classes="action-btn-premium">
                                                                    <i:Icon Value="fa-solid fa-eye" Foreground="{DynamicResource AccentPrimary}" FontSize="14"/>
                                                                </Button>
                                                                <Button Command="{Binding $parent[ItemsControl].DataContext.ShowRemoveBoiPaymentSlipFileConfirmCommand}" CommandParameter="{Binding}" Classes="action-btn-premium">
                                                                    <i:Icon Value="fa-solid fa-trash-can" Foreground="{DynamicResource StatusDanger}" FontSize="14"/>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        
                                        <!-- Upload Area -->
                                        <Button Classes="action-btn-premium" HorizontalAlignment="Left" Command="{Binding PickBoiPaymentSlipFilesCommand}" Margin="0,16,0,0">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <i:Icon Value="fa-solid fa-plus" Foreground="{DynamicResource AccentPrimary}"/>
                                                <TextBlock Text="Add BOI Payment Slip" Foreground="{DynamicResource AccentPrimary}" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <!-- VAT Certificate Tab -->
                                    <StackPanel IsVisible="{Binding SelectedCard2Tab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='VAT Certificate'}">
                                        <ItemsControl ItemsSource="{Binding VatCertificateFiles}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource DrawerHeaderBg}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                                            <i:Icon Value="fa-solid fa-file" Foreground="{DynamicResource AccentPrimary}" FontSize="16" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding FileName}" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextInput}"/>
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                                                <Button Command="{Binding $parent[ItemsControl].DataContext.PreviewDocumentCommand}" CommandParameter="{Binding Url}" Classes="action-btn-premium">
                                                                    <i:Icon Value="fa-solid fa-eye" Foreground="{DynamicResource AccentPrimary}" FontSize="14"/>
                                                                </Button>
                                                                <Button Command="{Binding $parent[ItemsControl].DataContext.ShowRemoveVatCertificateFileConfirmCommand}" CommandParameter="{Binding}" Classes="action-btn-premium">
                                                                    <i:Icon Value="fa-solid fa-trash-can" Foreground="{DynamicResource StatusDanger}" FontSize="14"/>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        
                                        <!-- Upload Area -->
                                        <Button Classes="action-btn-premium" HorizontalAlignment="Left" Command="{Binding PickVatCertificateFilesCommand}" Margin="0,16,0,0">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <i:Icon Value="fa-solid fa-plus" Foreground="{DynamicResource AccentPrimary}"/>
                                                <TextBlock Text="Add VAT Certificate" Foreground="{DynamicResource AccentPrimary}" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <!-- TDL Letter Tab -->
                                    <StackPanel IsVisible="{Binding SelectedCard2Tab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='TDL Letter'}">
                                        <ItemsControl ItemsSource="{Binding TdlLetterFiles}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource DrawerHeaderBg}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                                            <i:Icon Value="fa-solid fa-file" Foreground="{DynamicResource AccentPrimary}" FontSize="16" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding FileName}" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextInput}"/>
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                                                <Button Command="{Binding $parent[ItemsControl].DataContext.PreviewDocumentCommand}" CommandParameter="{Binding Url}" Classes="action-btn-premium">
                                                                    <i:Icon Value="fa-solid fa-eye" Foreground="{DynamicResource AccentPrimary}" FontSize="14"/>
                                                                </Button>
                                                                <Button Command="{Binding $parent[ItemsControl].DataContext.ShowRemoveTdlLetterFileConfirmCommand}" CommandParameter="{Binding}" Classes="action-btn-premium">
                                                                    <i:Icon Value="fa-solid fa-trash-can" Foreground="{DynamicResource StatusDanger}" FontSize="14"/>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        
                                        <!-- Upload Area -->
                                        <Button Classes="action-btn-premium" HorizontalAlignment="Left" Command="{Binding PickTdlLetterFilesCommand}" Margin="0,16,0,0">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <i:Icon Value="fa-solid fa-plus" Foreground="{DynamicResource AccentPrimary}"/>
                                                <TextBlock Text="Add TDL Letter" Foreground="{DynamicResource AccentPrimary}" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <!-- Plan Tab -->
                                    <StackPanel IsVisible="{Binding SelectedCard2Tab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Plan'}">
                                        <ItemsControl ItemsSource="{Binding PlanFiles}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource DrawerHeaderBg}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                                            <i:Icon Value="fa-solid fa-file" Foreground="{DynamicResource AccentPrimary}" FontSize="16" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding FileName}" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextInput}"/>
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                                                <Button Command="{Binding $parent[ItemsControl].DataContext.PreviewDocumentCommand}" CommandParameter="{Binding Url}" Classes="action-btn-premium">
                                                                    <i:Icon Value="fa-solid fa-eye" Foreground="{DynamicResource AccentPrimary}" FontSize="14"/>
                                                                </Button>
                                                                <Button Command="{Binding $parent[ItemsControl].DataContext.ShowRemovePlanFileConfirmCommand}" CommandParameter="{Binding}" Classes="action-btn-premium">
                                                                    <i:Icon Value="fa-solid fa-trash-can" Foreground="{DynamicResource StatusDanger}" FontSize="14"/>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        
                                        <!-- Upload Area -->
                                        <Button Classes="action-btn-premium" HorizontalAlignment="Left" Command="{Binding PickPlanFilesCommand}" Margin="0,16,0,0">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <i:Icon Value="fa-solid fa-plus" Foreground="{DynamicResource AccentPrimary}"/>
                                                <TextBlock Text="Add Plan" Foreground="{DynamicResource AccentPrimary}" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <!-- Business Proposal Tab -->
                                    <StackPanel IsVisible="{Binding SelectedCard2Tab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Business Proposal'}">
                                        <ItemsControl ItemsSource="{Binding BusinessProposalFiles}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource DrawerHeaderBg}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                                            <i:Icon Value="fa-solid fa-file" Foreground="{DynamicResource AccentPrimary}" FontSize="16" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding FileName}" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextInput}"/>
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                                                <Button Command="{Binding $parent[ItemsControl].DataContext.PreviewDocumentCommand}" CommandParameter="{Binding Url}" Classes="action-btn-premium">
                                                                    <i:Icon Value="fa-solid fa-eye" Foreground="{DynamicResource AccentPrimary}" FontSize="14"/>
                                                                </Button>
                                                                <Button Command="{Binding $parent[ItemsControl].DataContext.ShowRemoveBusinessProposalFileConfirmCommand}" CommandParameter="{Binding}" Classes="action-btn-premium">
                                                                    <i:Icon Value="fa-solid fa-trash-can" Foreground="{DynamicResource StatusDanger}" FontSize="14"/>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        
                                        <!-- Upload Area -->
                                        <Button Classes="action-btn-premium" HorizontalAlignment="Left" Command="{Binding PickBusinessProposalFilesCommand}" Margin="0,16,0,0">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <i:Icon Value="fa-solid fa-plus" Foreground="{DynamicResource AccentPrimary}"/>
                                                <TextBlock Text="Add Business Proposal" Foreground="{DynamicResource AccentPrimary}" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <!-- Cover Letter Tab -->
                                    <StackPanel IsVisible="{Binding SelectedCard2Tab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Cover Letter'}">
                                        <ItemsControl ItemsSource="{Binding CoverLetterFiles}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource DrawerHeaderBg}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                                            <i:Icon Value="fa-solid fa-file" Foreground="{DynamicResource AccentPrimary}" FontSize="16" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding FileName}" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextInput}"/>
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                                                <Button Command="{Binding $parent[ItemsControl].DataContext.PreviewDocumentCommand}" CommandParameter="{Binding Url}" Classes="action-btn-premium">
                                                                    <i:Icon Value="fa-solid fa-eye" Foreground="{DynamicResource AccentPrimary}" FontSize="14"/>
                                                                </Button>
                                                                <Button Command="{Binding $parent[ItemsControl].DataContext.ShowRemoveCoverLetterFileConfirmCommand}" CommandParameter="{Binding}" Classes="action-btn-premium">
                                                                    <i:Icon Value="fa-solid fa-trash-can" Foreground="{DynamicResource StatusDanger}" FontSize="14"/>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        
                                        <!-- Upload Area -->
                                        <Button Classes="action-btn-premium" HorizontalAlignment="Left" Command="{Binding PickCoverLetterFilesCommand}" Margin="0,16,0,0">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <i:Icon Value="fa-solid fa-plus" Foreground="{DynamicResource AccentPrimary}"/>
                                                <TextBlock Text="Add Cover Letter" Foreground="{DynamicResource AccentPrimary}" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- Footer Link -->
                    <Button Command="{Binding OpenGuideCommand}" Classes="guide-link-btn" HorizontalAlignment="Left" Margin="0,20,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <i:Icon Value="fa-solid fa-circle-question" Foreground="{DynamicResource TextSecondary}" FontSize="16"/>
                            <TextBlock Text="Learn more about BOI" Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Guide Popup Overlay -->
        <Border ZIndex="10" IsVisible="{Binding IsGuideVisible}" Background="{DynamicResource OverlayBg}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Background="{DynamicResource DateFlyoutBg}" CornerRadius="12" Width="600" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="30" BoxShadow="0 20 60 0 #D1000000">
                <StackPanel Spacing="25">
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <i:Icon Value="fa-solid fa-circle-question" FontSize="22" Foreground="{DynamicResource TextHeading}"/>
                            <TextBlock Text="Guide: BOI Records" Foreground="{DynamicResource TextHeading}" FontSize="20" FontWeight="Bold"/>
                        </StackPanel>
                        <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="5" Command="{Binding CloseGuideCommand}" Cursor="Hand">
                            <i:Icon Value="fa-solid fa-xmark" Foreground="{DynamicResource TextSecondary}" FontSize="18"/>
                        </Button>
                    </Grid>

                    <TextBlock Text="Follow these guidelines to accurately record Board of Investment clearances and specialized asset tracking." Foreground="{DynamicResource TextSecondary}" FontSize="14" Margin="0,-15,0,0" TextWrapping="Wrap"/>

                    <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" Margin="0,10,0,0">
                        <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource GuideCardBg}" CornerRadius="8" Padding="15" Margin="0,0,10,10">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Background="{DynamicResource AccentPrimary}" CornerRadius="10" Width="20" Height="20">
                                        <TextBlock Text="1" Foreground="{DynamicResource TextPrimary}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Investment Value" Foreground="{DynamicResource TextHeading}" FontWeight="Bold" FontSize="14"/>
                                </StackPanel>
                                <TextBlock Text="Enter the total investment value in USD as per the BOI agreement." Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource GuideCardBg}" CornerRadius="8" Padding="15" Margin="10,0,0,10">
                             <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Background="{DynamicResource AccentPrimary}" CornerRadius="10" Width="20" Height="20">
                                        <TextBlock Text="2" Foreground="{DynamicResource TextPrimary}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Country Address" Foreground="{DynamicResource TextHeading}" FontWeight="Bold" FontSize="14"/>
                                </StackPanel>
                                <TextBlock Text="Provide the registered address used for international trade and BOI filing." Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
        <!-- Save Confirmation Dialog Overlay -->
        <Border ZIndex="100" IsVisible="{Binding IsConfirmSaveVisible}" Background="{DynamicResource OverlayBg}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Background="{DynamicResource DrawerHeaderBg}" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" CornerRadius="12"
                    Width="420" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Padding="30" BoxShadow="0 8 32 0 #66000000">
                <StackPanel Spacing="20">
                    <TextBlock Text="{Binding ConfirmSaveTitle}" Foreground="{DynamicResource TextHeading}" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="{Binding ConfirmSaveMessage}" Foreground="{DynamicResource TextSecondary}" FontSize="14" TextWrapping="Wrap" LineHeight="22"/>
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Keep Editing" Background="Transparent" Foreground="{DynamicResource TextSecondary}" BorderThickness="0"
                                Command="{Binding CancelSaveCommand}" Cursor="Hand"/>
                        <Button Content="Save Changes" Background="{DynamicResource AccentPrimary}" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"
                                Padding="25,10" CornerRadius="8"
                                Command="{Binding ConfirmSaveCommand}" Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Discard Changes Confirmation Overlay -->
        <Border ZIndex="101" IsVisible="{Binding IsDiscardConfirmVisible}" Classes="premium-modal-overlay">
            <Border Classes="premium-modal-content" HorizontalAlignment="Center" VerticalAlignment="Center" Width="440">
                <StackPanel Spacing="25">
                    <i:Icon Value="fa-solid fa-triangle-exclamation" Foreground="{DynamicResource StatusWarning}" FontSize="40" HorizontalAlignment="Center"/>
                    <TextBlock Text="Discard changes?" Foreground="{DynamicResource TextPrimary}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="You have unsaved information. Are you sure you want to discard it? This action cannot be undone." 
                               Foreground="{DynamicResource TextSecondary}" FontSize="13" TextAlignment="Center" TextWrapping="Wrap"/>
                    <Grid ColumnDefinitions="*, 12, *" Margin="0,10,0,0">
                        <Button Grid.Column="0" Content="Keep Editing" Command="{Binding CancelDiscardCommand}" Classes="btn-secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                        <Button Grid.Column="2" Content="Discard" Command="{Binding ConfirmDiscardCommand}" Classes="btn-delete" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
        <!-- Remove Confirmation Overlay -->
        <Border ZIndex="102" IsVisible="{Binding IsRemoveConfirmVisible}" Classes="premium-modal-overlay">
            <Border Classes="premium-modal-content" HorizontalAlignment="Center" VerticalAlignment="Center" Width="440">
                <StackPanel Spacing="25">
                    <i:Icon Value="fa-solid fa-trash-can" Foreground="{DynamicResource StatusDanger}" FontSize="40" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding RemoveConfirmTitle}" Foreground="{DynamicResource TextPrimary}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding RemoveConfirmMessage}" 
                               Foreground="{DynamicResource TextSecondary}" FontSize="13" TextAlignment="Center" TextWrapping="Wrap"/>
                    <Grid ColumnDefinitions="*, 12, *" Margin="0,10,0,0">
                        <Button Grid.Column="0" Content="Keep File" Command="{Binding CancelRemoveCommand}" Classes="btn-secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                        <Button Grid.Column="2" Content="Remove" Command="{Binding ConfirmRemoveCommand}" Classes="btn-delete" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    
        <!-- Custom Bank Letter Upload Popup -->
        <Border ZIndex="103" IsVisible="{Binding IsBankLetterPopupVisible}" Classes="premium-modal-overlay">
            <Border Classes="premium-modal-content" HorizontalAlignment="Center" VerticalAlignment="Center" Width="480">
                <StackPanel Spacing="20">
                    <TextBlock Text="BANK LETTER" Foreground="{DynamicResource TextPrimary}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <StackPanel Spacing="8">
                        <TextBlock Text="Currency" Classes="input-label"/>
                        <ComboBox ItemsSource="{Binding Currencies}" SelectedItem="{Binding SelectedCurrency}" HorizontalAlignment="Stretch" Classes="form-input" PlaceholderText="Select Currency"/>
                    </StackPanel>
                    <Button Classes="action-btn-premium" HorizontalAlignment="Left" Command="{Binding PickBankLetterFilesCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <i:Icon Value="fa-solid fa-plus" Foreground="{DynamicResource AccentPrimary}"/>
                            <TextBlock Text="Add Document" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                        </StackPanel>
                    </Button>
                    <ScrollViewer MaxHeight="250" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding BankLetterFiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource DrawerHeaderBg}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <i:Icon Value="fa-solid fa-file" Foreground="{DynamicResource AccentPrimary}" FontSize="16" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding FileName}" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextInput}"/>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                                <Button Command="{Binding $parent[ItemsControl].DataContext.PreviewDocumentCommand}" CommandParameter="{Binding Url}" Classes="action-btn-premium">
                                                    <i:Icon Value="fa-solid fa-eye" Foreground="{DynamicResource AccentPrimary}" FontSize="14"/>
                                                </Button>
                                                <Button Command="{Binding $parent[ItemsControl].DataContext.ShowRemoveBankLetterFileConfirmCommand}" CommandParameter="{Binding}" Classes="action-btn-premium">
                                                    <i:Icon Value="fa-solid fa-trash-can" Foreground="{DynamicResource StatusDanger}" FontSize="14"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Grid ColumnDefinitions="*, 12, *" Margin="0,10,0,0">
                        <Button Grid.Column="0" Content="Cancel" Command="{Binding CancelBankLetterPopupCommand}" Classes="btn-secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                        <Button Grid.Column="2" Content="Save" Command="{Binding SaveBankLetterPopupCommand}" Classes="btn-save" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
</Panel>
</UserControl>
