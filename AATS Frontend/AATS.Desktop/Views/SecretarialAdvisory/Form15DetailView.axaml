<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AATS.Desktop.ViewModels.SecretarialAdvisory"
             xmlns:vmb="clr-namespace:AATS.Desktop.ViewModels"
             xmlns:models="clr-namespace:AATS.Desktop.Models"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="1400"
             x:Class="AATS.Desktop.Views.SecretarialAdvisory.Form15DetailView"
             x:DataType="vm:Form15DetailViewModel"
             ClipToBounds="False"
             x:CompileBindings="False"
             Name="Root">

    <UserControl.Styles>
        <Style Selector="Border.detail-card">
            <Setter Property="Background" Value="{DynamicResource TableBg}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="32"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="TextBlock.card-label">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style Selector="TextBlock.card-value">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.tab-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.tab-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BorderSubtle}"/>
        </Style>
        <Style Selector="Button.tab-btn.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
        </Style>
        <Style Selector="Button.tab-btn TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="Button.tab-btn.selected TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Popup Styles -->
        <Style Selector="Border.upload-drop-zone">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="40"/>
        </Style>
        <Style Selector="Border.upload-drop-zone:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource DrawerHeaderBg}"/>
        </Style>

        <Style Selector="Border.file-item-card">
            <Setter Property="Background" Value="{DynamicResource DrawerHeaderBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,12"/>
        </Style>

        <Style Selector="Button.icon-action-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
        </Style>
        <Style Selector="Button.icon-action-btn i|Icon">
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style Selector="ComboBox.popup-input">
            <Setter Property="Background" Value="{DynamicResource DrawerHeaderBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}"/>
        </Style>
        <Style Selector="TextBox.popup-input">
            <Setter Property="Background" Value="{DynamicResource DrawerHeaderBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}"/>
        </Style>

        <!-- Hover Action Styles -->
        <Style Selector="Border.document-item StackPanel.action-icons">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.document-item:pointerover StackPanel.action-icons">
            <Setter Property="Opacity" Value="1"/>
        </Style>
    </UserControl.Styles>

    <Panel>
        <ScrollViewer>
            <Grid RowDefinitions="Auto, Auto, *, Auto, Auto" Margin="40,20,40,40">
                
                <!-- 1. Header Section -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,32">
                    <!-- Client Brand -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16">
                        <Border Width="64" Height="64" CornerRadius="16" Background="{DynamicResource FilterBarBg}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                            <i:Icon Value="fa-solid fa-file-contract" Foreground="{DynamicResource AccentPrimary}" FontSize="28"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="16">
                            <TextBlock Text="{Binding CompanyName}" FontSize="36" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                        </StackPanel>
                    </StackPanel>
 
                    <!-- Header Actions -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                        <Button Classes="btn-secondary" Command="{Binding DownloadRecordCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <i:Icon Value="fa-solid fa-download" FontSize="14" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="Download Report" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="btn-print" Command="{Binding PrintRecordCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <i:Icon Value="fa-solid fa-print" FontSize="14" Foreground="{DynamicResource AddRecordFg}"/>
                                <TextBlock Text="Print" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
 
                <!-- 2. Info Grid Summary -->
                <Grid Grid.Row="1" ColumnDefinitions="*, 20, *, 20, *, 20, *" Margin="0,0,0,32">
                    <Border Grid.Column="0" Classes="detail-summary-card">
                        <StackPanel>
                            <TextBlock Text="ID" Classes="detail-card-label"/>
                            <TextBlock Text="{Binding Record.ID}" Classes="detail-card-value"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Classes="detail-summary-card">
                        <StackPanel>
                            <TextBlock Text="DATE" Classes="detail-card-label"/>
                            <TextBlock Text="{Binding Record.Date, StringFormat='MMM dd, yyyy'}" Classes="detail-card-value"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Classes="detail-summary-card">
                        <StackPanel>
                            <TextBlock Text="BRANCH" Classes="detail-card-label"/>
                            <TextBlock Text="{Binding Record.Branch}" Classes="detail-card-value"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="6" Classes="detail-summary-card">
                        <StackPanel>
                            <TextBlock Text="CLIENT NAME" Classes="detail-card-label"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding ClientName}" Classes="detail-card-value" VerticalAlignment="Center"/>
                                <Border Classes="status-badge" VerticalAlignment="Center" Padding="6,1" IsVisible="{Binding Record.ClientStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                        Classes.status-active="{Binding Record.ClientStatus, Converter={StaticResource StringEqualityConverter}, ConverterParameter=Active}"
                                        Classes.status-inactive="{Binding Record.ClientStatus, Converter={StaticResource StringEqualityConverter}, ConverterParameter=Inactive}"
                                        Classes.status-blacklisted="{Binding Record.ClientStatus, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Black Listed'}"
                                        Classes.status-suspended="{Binding Record.ClientStatus, Converter={StaticResource StringEqualityConverter}, ConverterParameter=Suspended}">
                                    <TextBlock Text="{Binding Record.ClientStatus}" FontSize="9" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
 
                <!-- 3. Content Area -->
                <Grid Grid.Row="2" RowDefinitions="Auto, *">
                    
                    <!-- Top Section: Registration Process Timeline -->
                    <Border Grid.Row="0" Classes="detail-card" Margin="0,0,0,32" Padding="32">
                        <StackPanel Spacing="24">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <i:Icon Value="fa-solid fa-bars-progress" Foreground="{DynamicResource AccentPrimary}" FontSize="18"/>
                                <TextBlock Text="REGISTRATION PROCESS" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            
                            <ItemsControl ItemsSource="{Binding Steps}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vmb:ProcessStep" x:CompileBindings="False">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button AutomationProperties.AutomationId="{Binding Number, StringFormat='ProcessStep_{0}'}" Classes="process-step-btn" 
                                                    Command="{Binding $parent[UserControl].((vm:Form15DetailViewModel)DataContext).StepClickCommand}" 
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding IsClickable}">
                                                <StackPanel Spacing="12">
                                                    <Border Classes="step-indicator-circle" 
                                                            Classes.active="{Binding IsActive}"
                                                            Classes.clickable="{Binding IsClickable}"
                                                            Width="40" Height="40">
                                                        <TextBlock Text="{Binding Number}" 
                                                                  Classes="step-indicator-num" 
                                                                  Classes.active="{Binding IsActive}"
                                                                  FontSize="16"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Name}" 
                                                              Classes="step-indicator-label" 
                                                              Classes.active="{Binding IsActive}"
                                                              Width="110" TextAlignment="Center" FontSize="11"/>
                                                </StackPanel>
                                            </Button>
                                            
                                            <Rectangle Width="45" Height="2" Fill="{DynamicResource BorderSubtle}" Margin="5,20,5,0" VerticalAlignment="Top" IsVisible="{Binding IsNotLast}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Left Column: Details, Documents -->
                    <StackPanel Grid.Row="1" Spacing="32">
                        
                        <!-- Form - 15 Upload -->
                        <Border Classes="detail-card" IsVisible="{Binding IsForm15UploadVisible}">
                            <StackPanel Spacing="20">
                                <Grid ColumnDefinitions="*, Auto">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                        <i:Icon Value="fa-solid fa-file-contract" Foreground="{DynamicResource AccentPrimary}" FontSize="18"/>
                                        <TextBlock Text="FORM - 15 DOCUMENTS" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="btn-primary" Background="{DynamicResource AccentPrimary}" Padding="12,6" Command="{Binding UploadProcessDocumentCommand}" CommandParameter="Form - 15" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <i:Icon Value="fa-solid fa-plus" FontSize="12" Foreground="{DynamicResource TextPrimary}"/>
                                            <TextBlock Text="Upload" FontSize="12" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock Text="Upload and manage Form - 15 documents for this stage." Foreground="{DynamicResource TextSecondary}" FontSize="13" Margin="0,-10,0,10"/>
                                
                                <ItemsControl ItemsSource="{Binding Form15Documents}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Classes="file-item-card" Margin="0,0,0,10">
                                                <Grid ColumnDefinitions="Auto, *, Auto">
                                                    <i:Icon Value="fa-solid fa-file-pdf" FontSize="24" Foreground="#e25555" Margin="0,0,15,0"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FileName}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                                        <TextBlock Text="{Binding FileSize}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Classes="btn-icon-danger" Command="{Binding #Root.((vm:Form15DetailViewModel)DataContext).RemoveProcessDocumentCommand}" CommandParameter="{Binding}">
                                                        <i:Icon Value="fa-solid fa-xmark" FontSize="14"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Payment Upload -->
                        <Border Classes="detail-card" IsVisible="{Binding IsPaymentUploadVisible}">
                            <StackPanel Spacing="20">
                                <Grid ColumnDefinitions="*, Auto">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                        <i:Icon Value="fa-solid fa-money-bill" Foreground="{DynamicResource AccentPrimary}" FontSize="18"/>
                                        <TextBlock Text="PAYMENT SLIPS" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="btn-primary" Background="{DynamicResource AccentPrimary}" Padding="12,6" Command="{Binding UploadProcessDocumentCommand}" CommandParameter="Payment" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <i:Icon Value="fa-solid fa-plus" FontSize="12" Foreground="{DynamicResource TextPrimary}"/>
                                            <TextBlock Text="Upload" FontSize="12" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock Text="Upload payment slips or proof of payment for this stage." Foreground="{DynamicResource TextSecondary}" FontSize="13" Margin="0,-10,0,10"/>
                                
                                <ItemsControl ItemsSource="{Binding PaymentDocuments}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Classes="file-item-card" Margin="0,0,0,10">
                                                <Grid ColumnDefinitions="Auto, *, Auto">
                                                    <i:Icon Value="fa-solid fa-file-image" FontSize="24" Foreground="#4a90e2" Margin="0,0,15,0"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FileName}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                                        <TextBlock Text="{Binding FileSize}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Classes="btn-icon-danger" Command="{Binding #Root.((vm:Form15DetailViewModel)DataContext).RemoveProcessDocumentCommand}" CommandParameter="{Binding}">
                                                        <i:Icon Value="fa-solid fa-xmark" FontSize="14"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Certified Copy Upload -->
                        <Border Classes="detail-card" IsVisible="{Binding IsCertifiedCopyUploadVisible}">
                            <StackPanel Spacing="20">
                                <Grid ColumnDefinitions="*, Auto">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                        <i:Icon Value="fa-solid fa-stamp" Foreground="{DynamicResource AccentPrimary}" FontSize="18"/>
                                        <TextBlock Text="CERTIFIED COPIES" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="btn-primary" Background="{DynamicResource AccentPrimary}" Padding="12,6" Command="{Binding UploadProcessDocumentCommand}" CommandParameter="Certified Copy" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <i:Icon Value="fa-solid fa-plus" FontSize="12" Foreground="{DynamicResource TextPrimary}"/>
                                            <TextBlock Text="Upload" FontSize="12" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock Text="Upload the final certified copies provided by the authority." Foreground="{DynamicResource TextSecondary}" FontSize="13" Margin="0,-10,0,10"/>
                                
                                <ItemsControl ItemsSource="{Binding CertifiedCopyDocuments}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Classes="file-item-card" Margin="0,0,0,10">
                                                <Grid ColumnDefinitions="Auto, *, Auto">
                                                    <i:Icon Value="fa-solid fa-file-pdf" FontSize="24" Foreground="#e25555" Margin="0,0,15,0"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FileName}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                                        <TextBlock Text="{Binding FileSize}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Classes="btn-icon-danger" Command="{Binding #Root.((vm:Form15DetailViewModel)DataContext).RemoveProcessDocumentCommand}" CommandParameter="{Binding}">
                                                        <i:Icon Value="fa-solid fa-xmark" FontSize="14"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>


                        <!-- Client Information Card -->
                        <Border Classes="detail-card">
                            <StackPanel Spacing="24">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <i:Icon Value="fa-solid fa-address-card" Foreground="{DynamicResource AccentPrimary}" FontSize="18"/>
                                    <TextBlock Text="CLIENT INFORMATION" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Read-only registration details for the client." Foreground="{DynamicResource TextSecondary}" FontSize="13" Margin="0,-10,0,0"/>

                                <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, 24, Auto, 24, Auto">
                                    <!-- Row 1 -->
                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Text="CLIENT ID" Classes="card-label"/>
                                        <TextBlock Text="{Binding ClientId}" Classes="card-value"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1">
                                        <TextBlock Text="CLIENT NAME" Classes="card-label"/>
                                        <TextBlock Text="{Binding ClientName}" Classes="card-value"/>
                                    </StackPanel>

                                    <!-- Row 2 -->
                                    <StackPanel Grid.Row="2" Grid.Column="0">
                                        <TextBlock Text="COMPANY NAME" Classes="card-label"/>
                                        <TextBlock Text="{Binding CompanyName}" Classes="card-value"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="1">
                                        <TextBlock Text="PHONE NUMBER" Classes="card-label"/>
                                        <TextBlock Text="{Binding PhoneNo}" Classes="card-value"/>
                                    </StackPanel>

                                    <!-- Row 3 -->
                                    <StackPanel Grid.Row="4" Grid.Column="0">
                                        <TextBlock Text="LOGIN ID" Classes="card-label"/>
                                        <TextBlock Text="{Binding LoginId}" Classes="card-value"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="4" Grid.Column="1">
                                        <TextBlock Text="PASSWORD" Classes="card-label"/>
                                        <Grid ColumnDefinitions="Auto, Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding DisplayPassword}" Classes="card-value" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Classes="icon-action-btn" Command="{Binding TogglePasswordVisibilityCommand}" Background="Transparent" BorderThickness="0" Padding="0" Margin="10,0,0,0">
                                                <i:Icon Value="{Binding PasswordIcon}" Foreground="{DynamicResource TextSecondary}" FontSize="16"/>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Attached Documents Card -->
                        <Border Classes="detail-card">
                            <StackPanel Spacing="24">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <i:Icon Value="fa-solid fa-folder-open" Foreground="{DynamicResource AccentPrimary}" FontSize="18"/>
                                    <TextBlock Text="ATTACHED DOCUMENTS" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="View the documents attached during the registration process." Foreground="{DynamicResource TextSecondary}" FontSize="13" Margin="0,-10,0,0"/>

                                <!-- Tab Strip -->
                                <Border BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1">
                                    <StackPanel Orientation="Horizontal" Spacing="0">
                                        <Button Classes="tab-btn" Classes.selected="{Binding SelectedAttachmentTab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='BR'}" Command="{Binding SelectAttachmentTabCommand}" CommandParameter="BR">
                                            <TextBlock Text="BR Document"/>
                                        </Button>
                                        <Button Classes="tab-btn" Classes.selected="{Binding SelectedAttachmentTab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Form 01'}" Command="{Binding SelectAttachmentTabCommand}" CommandParameter="Form 01">
                                            <TextBlock Text="Form 01"/>
                                        </Button>
                                        <Button Classes="tab-btn" Classes.selected="{Binding SelectedAttachmentTab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Articles of Association'}" Command="{Binding SelectAttachmentTabCommand}" CommandParameter="Articles of Association">
                                            <TextBlock Text="Articles of Association"/>
                                        </Button>
                                        <Button Classes="tab-btn" Classes.selected="{Binding SelectedAttachmentTab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Form 20'}" Command="{Binding SelectAttachmentTabCommand}" CommandParameter="Form 20">
                                            <TextBlock Text="Form 20"/>
                                        </Button>
                                        <Button Classes="tab-btn" Classes.selected="{Binding SelectedAttachmentTab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Audit Report'}" Command="{Binding SelectAttachmentTabCommand}" CommandParameter="Audit Report">
                                            <TextBlock Text="Audit Report"/>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Tab Content (Files) -->
                                <StackPanel Spacing="16">
                                    <TextBlock Text="No documents uploaded in this category." Foreground="{DynamicResource TextFaint}" FontStyle="Italic" HorizontalAlignment="Center" Margin="0,20" IsVisible="{Binding !FilteredAttachmentDocuments.Count}"/>
                                    
                                    <ScrollViewer MaxHeight="350" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding FilteredAttachmentDocuments}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:AppDocument">
                                                    <Border Classes="document-item" Background="{DynamicResource DrawerHeaderBg}" CornerRadius="10" Padding="16,12" Margin="0,0,0,8" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1">
                                                        <Grid ColumnDefinitions="Auto, *, Auto">
                                                            <i:Icon Value="fa-solid fa-file-pdf" Foreground="{DynamicResource AccentPrimary}" FontSize="20" Margin="0,0,16,0"/>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding FileName}" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <TextBlock Text="{Binding FileSize}" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                                                    <TextBlock Text="•" Foreground="{DynamicResource TextFaint}" FontSize="11"/>
                                                                    <TextBlock Text="{Binding Category}" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Grid>

                <!-- Footer Actions -->
                <Grid Grid.Row="4" ColumnDefinitions="Auto, *, Auto" VerticalAlignment="Bottom" Margin="0,40,0,0">
                    <Button Grid.Column="0" Classes="footer-link" Command="{Binding OpenGuideCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <i:Icon Value="fa-solid fa-circle-question" Foreground="{DynamicResource TextSecondary}" FontSize="16"/>
                            <TextBlock Text="Learn more about Form - 15" Foreground="{DynamicResource TextSecondary}" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16">
                        <Button Name="EditRecordButton" Content="Edit" Classes="btn-edit" Width="140" Command="{Binding EditRecordCommand}"/>
                        <Button Name="DeleteRecordButton" Content="Delete" Classes="btn-delete" Width="140" Command="{Binding DeleteRecordCommand}"/>
                    </StackPanel>
                </Grid>

            </Grid>
        </ScrollViewer>

        <!-- Instruction Guide Popup (Global Style Sync) -->
        <Border ZIndex="4000" IsVisible="{Binding IsGuideVisible}" Background="{DynamicResource OverlayBg}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="-30">
             <Border Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" CornerRadius="12" Width="600" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="30" BoxShadow="0 8 32 0 #66000000">
                <StackPanel Spacing="25">
                    <!-- Header -->
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <i:Icon Value="fa-regular fa-circle-question" FontSize="20" Foreground="{DynamicResource TextHeading}"/>
                            <TextBlock Text="{Binding GuideTitle}" Foreground="{DynamicResource TextHeading}" FontSize="20" FontWeight="Bold"/>
                        </StackPanel>
                        <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="5" Command="{Binding CloseGuideCommand}" Cursor="Hand">
                            <i:Icon Value="fa-solid fa-xmark" Foreground="{DynamicResource TextSecondary}" FontSize="18"/>
                        </Button>
                    </Grid>
                    
                    <TextBlock Text="{Binding GuideDescription}" Foreground="{DynamicResource TextSecondary}" FontSize="14" Margin="0,-10,0,10"/>

                    <!-- Features Grid -->
                    <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, *" Margin="0,0,0,10">
                        <!-- 1 -->
                        <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource GuideCardBg}" CornerRadius="8" Padding="15" Margin="0,0,10,10">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Background="{DynamicResource GuideBadgeBg}" CornerRadius="10" Width="20" Height="20">
                                        <TextBlock Text="1" Foreground="{DynamicResource GuideCardBg}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Timeline Progress" Foreground="{DynamicResource TextHeading}" FontWeight="Bold" FontSize="14"/>
                                </StackPanel>
                                <TextBlock Text="Track the 3-step registration process from Form - 15 upload to receiving the certified copy." Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- 2 -->
                        <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource GuideCardBg}" CornerRadius="8" Padding="15" Margin="10,0,0,10">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Background="{DynamicResource GuideBadgeBg}" CornerRadius="10" Width="20" Height="20">
                                        <TextBlock Text="2" Foreground="{DynamicResource GuideCardBg}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Attachments" Foreground="{DynamicResource TextHeading}" FontWeight="Bold" FontSize="14"/>
                                </StackPanel>
                                <TextBlock Text="View and manage uploaded documents for each stage of the Form - 15 process." Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- 3 -->
                        <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource GuideCardBg}" CornerRadius="8" Padding="15" Margin="0,10,10,0">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Background="{DynamicResource GuideBadgeBg}" CornerRadius="10" Width="20" Height="20">
                                        <TextBlock Text="3" Foreground="{DynamicResource GuideCardBg}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Activity Timeline" Foreground="{DynamicResource TextHeading}" FontWeight="Bold" FontSize="14"/>
                                </StackPanel>
                                <TextBlock Text="View the history of activity on this record. Currently under development." Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- 4 -->
                        <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource GuideCardBg}" CornerRadius="8" Padding="15" Margin="10,10,0,0">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Background="{DynamicResource GuideBadgeBg}" CornerRadius="10" Width="20" Height="20">
                                        <TextBlock Text="4" Foreground="{DynamicResource GuideCardBg}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Action Center" Foreground="{DynamicResource TextHeading}" FontWeight="Bold" FontSize="14"/>
                                </StackPanel>
                                <TextBlock Text="Use the bottom action bar to quickly edit, delete, or generate reports for this specific record." Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Pro Tip -->
                    <Border Background="{DynamicResource DrawerHeaderBg}" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" CornerRadius="8" Padding="15">
                        <StackPanel Spacing="10">
                            <TextBlock Text="PRO TIP" Foreground="{DynamicResource TextSecondary}" FontWeight="Bold" FontSize="11"/>
                            <TextBlock Text="{Binding GuideProTip}" Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    
                    <Button Content="Got it, thanks!" Command="{Binding CloseGuideCommand}" Background="{DynamicResource GuideGotItBg}" Foreground="{DynamicResource DrawerHeaderBg}" FontWeight="Bold" CornerRadius="6" Padding="15,8" HorizontalAlignment="Right" Cursor="Hand"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- Global Confirmation Dialog Overlay -->
        <Border Classes="premium-modal-overlay" IsVisible="{Binding IsConfirmDialogVisible}" ZIndex="1000">
            <Border Classes="premium-modal-content" HorizontalAlignment="Center" VerticalAlignment="Center" Width="480">
                <StackPanel Spacing="28">
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                             <Border Width="48" Height="48" CornerRadius="24" Background="{DynamicResource HoverBg}">
                                <i:Icon Value="fa-solid fa-circle-exclamation" Foreground="{DynamicResource StatusDanger}" FontSize="22"/>
                            </Border>
                            <TextBlock Text="{Binding ConfirmDialogTitle}" Foreground="{DynamicResource TextHeading}" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="footer-link" Command="{Binding CancelActionCommand}" VerticalAlignment="Top" Margin="0,-10,-10,0">
                            <i:Icon Value="fa-solid fa-xmark" Foreground="{DynamicResource TextSecondary}" FontSize="20"/>
                        </Button>
                    </Grid>
                    <TextBlock Text="{Binding ConfirmDialogMessage}" Foreground="{DynamicResource TextSecondary}" FontSize="16" LineHeight="26" TextWrapping="Wrap"/>
                    <Grid ColumnDefinitions="*, 12, *" Margin="0,10,0,0">
                        <Button Grid.Column="0" Content="Cancel" Classes="btn-secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding CancelActionCommand}"/>
                        <Button Name="ConfirmDeleteButton" Grid.Column="2" Content="Confirm" Classes="btn-delete" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding ConfirmActionCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

    </Panel>
</UserControl>
