<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:helpers="using:AATS.Desktop.Helpers"
             xmlns:vm="clr-namespace:AATS.Desktop.ViewModels.SecretarialAdvisory"
             xmlns:vmb="clr-namespace:AATS.Desktop.ViewModels"
             xmlns:models="clr-namespace:AATS.Desktop.Models"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="1400"
             x:Class="AATS.Desktop.Views.SecretarialAdvisory.TradeLicenseDetailView"
             x:DataType="vm:TradeLicenseDetailViewModel"
             ClipToBounds="False"
             x:CompileBindings="False"
             Name="Root">

    <UserControl.Styles>
        <Style Selector="Border.detail-card">
            <Setter Property="Background" Value="{DynamicResource TableBg}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="32"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="TextBlock.card-label">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style Selector="TextBlock.card-value">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.tab-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.tab-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BorderSubtle}"/>
        </Style>
        <Style Selector="Button.tab-btn.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
        </Style>
        <Style Selector="Button.tab-btn TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="Button.tab-btn.selected TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Popup Styles -->
        <Style Selector="Border.upload-drop-zone">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="40"/>
        </Style>
        <Style Selector="Border.upload-drop-zone:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource DrawerHeaderBg}"/>
        </Style>

        <Style Selector="Border.file-item-card">
            <Setter Property="Background" Value="{DynamicResource DrawerHeaderBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,12"/>
        </Style>

        <Style Selector="Button.icon-action-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
        </Style>
        <Style Selector="Button.icon-action-btn i|Icon">
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style Selector="ComboBox.popup-input">
            <Setter Property="Background" Value="{DynamicResource DrawerHeaderBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}"/>
        </Style>
        <Style Selector="TextBox.popup-input">
            <Setter Property="Background" Value="{DynamicResource DrawerHeaderBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}"/>
        </Style>

        <!-- Hover Action Styles -->
        <Style Selector="Border.document-item StackPanel.action-icons">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.document-item:pointerover StackPanel.action-icons">
            <Setter Property="Opacity" Value="1"/>
        </Style>
    </UserControl.Styles>

    <Panel>
        <ScrollViewer>
            <Grid RowDefinitions="Auto, Auto, *, Auto, Auto" Margin="40,20,40,40">
                
                <!-- 1. Header Section -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,32">
                    <!-- Client Brand -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16">
                        <Border Width="64" Height="64" CornerRadius="16" Background="{DynamicResource FilterBarBg}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                            <i:Icon Value="fa-solid fa-hotel" Foreground="{DynamicResource AccentPrimary}" FontSize="28"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="16">
                            <TextBlock Text="{Binding CompanyName}" FontSize="36" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                            <Border Background="{Binding ClientCategoryColor}" CornerRadius="12" Padding="8,2" VerticalAlignment="Center" IsVisible="{Binding HasClientCategory}">
                                <TextBlock Text="{Binding ClientCategory}" Foreground="Black" FontSize="10" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
 
                    <!-- Header Actions -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                        <Button Classes="btn-secondary" Command="{Binding DownloadRecordCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <i:Icon Value="fa-solid fa-download" FontSize="14" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="Download Report" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="btn-print" Command="{Binding PrintRecordCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <i:Icon Value="fa-solid fa-print" FontSize="14" Foreground="{DynamicResource AddRecordFg}"/>
                                <TextBlock Text="Print" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
 
                <!-- 2. Info Grid Summary -->
                <Grid Grid.Row="1" ColumnDefinitions="*, 20, *, 20, *, 20, *" Margin="0,0,0,32">
                    <Border Grid.Column="0" Classes="detail-summary-card">
                        <StackPanel>
                            <TextBlock Text="ID" Classes="detail-card-label"/>
                            <TextBlock Text="{Binding IDDisplay}" Classes="detail-card-value"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Classes="detail-summary-card">
                        <StackPanel>
                            <TextBlock Text="DATE" Classes="detail-card-label"/>
                            <TextBlock Text="{Binding DateDisplay}" Classes="detail-card-value"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Classes="detail-summary-card">
                        <StackPanel>
                            <TextBlock Text="BRANCH" Classes="detail-card-label"/>
                            <TextBlock Text="{Binding BranchDisplay}" Classes="detail-card-value"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="6" Classes="detail-summary-card">
                        <StackPanel>
                            <TextBlock Text="CLIENT NAME" Classes="detail-card-label"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding ClientName}" Classes="detail-card-value" VerticalAlignment="Center"/>
                                <Border Classes="status-badge" VerticalAlignment="Center" Padding="6,1" IsVisible="{Binding StatusDisplay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                        Classes.status-active="{Binding StatusDisplay, Converter={StaticResource StringEqualityConverter}, ConverterParameter=Active}"
                                        Classes.status-inactive="{Binding StatusDisplay, Converter={StaticResource StringEqualityConverter}, ConverterParameter=Inactive}"
                                        Classes.status-blacklisted="{Binding StatusDisplay, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Black Listed'}"
                                        Classes.status-suspended="{Binding StatusDisplay, Converter={StaticResource StringEqualityConverter}, ConverterParameter=Suspended}">
                                    <TextBlock Text="{Binding StatusDisplay}" FontSize="9" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
 
                <!-- 3. Content Area -->
                <Grid Grid.Row="2" RowDefinitions="Auto, *">
                    
<!-- Top Section: Registration Process Timeline -->
                    <Border Grid.Row="0" Classes="detail-card" Margin="0,0,0,32" Padding="32">
                        <StackPanel Spacing="24">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <i:Icon Value="fa-solid fa-bars-progress" Foreground="{DynamicResource AccentPrimary}" FontSize="18"/>
                                <TextBlock Text="REGISTRATION PROCESS" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            
                            <ItemsControl ItemsSource="{Binding Steps}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vmb:ProcessStep" x:CompileBindings="False">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button AutomationProperties.AutomationId="{Binding Number, StringFormat='ProcessStep_{0}'}" Classes="process-step-btn" 
                                                    Command="{Binding $parent[UserControl].((vm:TradeLicenseDetailViewModel)DataContext).StepClickCommand}" 
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding IsClickable}">
                                                <StackPanel Spacing="12">
                                                    <Border Classes="step-indicator-circle" 
                                                            Classes.active="{Binding IsActive}"
                                                            Classes.clickable="{Binding IsClickable}"
                                                            Width="40" Height="40">
                                                        <Panel>
                                                            <TextBlock Text="{Binding Number}" 
                                                                      Classes="step-indicator-num" 
                                                                      Classes.active="{Binding IsActive}"
                                                                      FontSize="16"
                                                                      IsVisible="{Binding !IsIconStep}"/>
                                                            <i:Icon Value="{Binding IconValue}" 
                                                                   Foreground="{DynamicResource TextPrimary}" 
                                                                   FontSize="18"
                                                                   IsVisible="{Binding IsIconStep}"/>
                                                        </Panel>
                                                    </Border>
                                                    <TextBlock Text="{Binding Name}" 
                                                              Classes="step-indicator-label" 
                                                              Classes.active="{Binding IsActive}"
                                                              Width="110" TextAlignment="Center" FontSize="11"/>
                                                </StackPanel>
                                            </Button>
                                            
                                            <Rectangle Width="45" Height="2" Fill="{DynamicResource BorderSubtle}" Margin="5,20,5,0" VerticalAlignment="Top" IsVisible="{Binding IsNotLast}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Left Column: Details, Documents -->
                    <StackPanel Grid.Row="1" Spacing="32">
                        
                <!-- Dynamic Document Upload Cards -->
                <StackPanel Spacing="24" Margin="0,0,0,0">
                    <!-- Temporary Certificate Proof Upload -->
                    <Border Classes="detail-card" IsVisible="{Binding IsTempCertificateUploadVisible}">
                        <StackPanel Spacing="24">
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                    <i:Icon Value="fa-solid fa-file-arrow-up" Foreground="{DynamicResource AccentPrimary}" FontSize="18"/>
                                    <TextBlock Text="TEMPORARY CERTIFICATE REQUIRED" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button Grid.Column="1" Classes="btn-primary" Background="{DynamicResource AccentPrimary}" Padding="12,6" Command="{Binding UploadProcessDocumentCommand}" CommandParameter="Temporary Certificate" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <i:Icon Value="fa-solid fa-plus" FontSize="12" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="Upload" FontSize="12" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <TextBlock Text="Please upload the Temporary Certificate to proceed." Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,-8,0,0" TextWrapping="Wrap"/>

                            <!-- Tab Content (Files) -->
                            <StackPanel Spacing="16">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock Text="UPLOADED FILES" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="Bold"/>
                                </StackPanel>
                                
                                <TextBlock Text="No documents uploaded." Foreground="{DynamicResource TextFaint}" FontStyle="Italic" HorizontalAlignment="Center" Margin="0,20" IsVisible="{Binding !FilteredProcessDocuments.Count}"/>
                                
                                <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding FilteredProcessDocuments}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:AppDocument">
                                                <Border Classes="document-item" Background="{DynamicResource DrawerHeaderBg}" CornerRadius="10" Padding="16,12" Margin="0,0,0,8" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1">
                                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                                        <i:Icon Value="fa-solid fa-file-pdf" Foreground="{DynamicResource AccentPrimary}" FontSize="20" Margin="0,0,16,0"/>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding FileName}" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                                                <Border Background="{DynamicResource HoverBg}" CornerRadius="4" Padding="6,2">
                                                                    <TextBlock Text="{Binding FileType}" Foreground="{DynamicResource AccentPrimary}" FontSize="10" FontWeight="Bold"/>
                                                                </Border>
                                                                <TextBlock Text="{Binding FileSize}" Foreground="{DynamicResource TextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                                            <Button Classes="icon-btn" ToolTip.Tip="Preview" Command="{Binding $parent[UserControl].((vm:TradeLicenseDetailViewModel)DataContext).PreviewProcessDocumentCommand}" CommandParameter="{Binding}">
                                                                <i:Icon Value="fa-solid fa-eye" Foreground="{DynamicResource TextSecondary}"/>
                                                            </Button>
                                                            <Button Classes="icon-btn" ToolTip.Tip="Delete" Command="{Binding $parent[UserControl].((vm:TradeLicenseDetailViewModel)DataContext).RemoveProcessDocumentCommand}" CommandParameter="{Binding}">
                                                                <i:Icon Value="fa-solid fa-trash" Foreground="{DynamicResource StatusDanger}"/>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    
                    <!-- Letter Proof Upload -->
                    <Border Classes="detail-card" IsVisible="{Binding IsLetterUploadVisible}">
                        <StackPanel Spacing="24">
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                    <i:Icon Value="fa-solid fa-file-arrow-up" Foreground="{DynamicResource AccentPrimary}" FontSize="18"/>
                                    <TextBlock Text="LETTER REQUIRED" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button Grid.Column="1" Classes="btn-primary" Background="{DynamicResource AccentPrimary}" Padding="12,6" Command="{Binding UploadProcessDocumentCommand}" CommandParameter="Letter" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <i:Icon Value="fa-solid fa-plus" FontSize="12" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="Upload" FontSize="12" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <TextBlock Text="Please upload the Letter document to proceed." Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,-8,0,0" TextWrapping="Wrap"/>

                            <!-- Tab Content (Files) -->
                            <StackPanel Spacing="16">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock Text="UPLOADED FILES" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="Bold"/>
                                </StackPanel>
                                
                                <TextBlock Text="No documents uploaded." Foreground="{DynamicResource TextFaint}" FontStyle="Italic" HorizontalAlignment="Center" Margin="0,20" IsVisible="{Binding !FilteredProcessDocuments.Count}"/>
                                
                                <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding FilteredProcessDocuments}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:AppDocument">
                                                <Border Classes="document-item" Background="{DynamicResource DrawerHeaderBg}" CornerRadius="10" Padding="16,12" Margin="0,0,0,8" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1">
                                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                                        <i:Icon Value="fa-solid fa-file-pdf" Foreground="{DynamicResource AccentPrimary}" FontSize="20" Margin="0,0,16,0"/>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding FileName}" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                                                <Border Background="{DynamicResource HoverBg}" CornerRadius="4" Padding="6,2">
                                                                    <TextBlock Text="{Binding FileType}" Foreground="{DynamicResource AccentPrimary}" FontSize="10" FontWeight="Bold"/>
                                                                </Border>
                                                                <TextBlock Text="{Binding FileSize}" Foreground="{DynamicResource TextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                                            <Button Classes="icon-btn" ToolTip.Tip="Preview" Command="{Binding $parent[UserControl].((vm:TradeLicenseDetailViewModel)DataContext).PreviewProcessDocumentCommand}" CommandParameter="{Binding}">
                                                                <i:Icon Value="fa-solid fa-eye" Foreground="{DynamicResource TextSecondary}"/>
                                                            </Button>
                                                            <Button Classes="icon-btn" ToolTip.Tip="Delete" Command="{Binding $parent[UserControl].((vm:TradeLicenseDetailViewModel)DataContext).RemoveProcessDocumentCommand}" CommandParameter="{Binding}">
                                                                <i:Icon Value="fa-solid fa-trash" Foreground="{DynamicResource StatusDanger}"/>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    
                    <!-- Certificate Proof Upload -->
                    <Border Classes="detail-card" IsVisible="{Binding IsCertificateUploadVisible}">
                        <StackPanel Spacing="24">
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                    <i:Icon Value="fa-solid fa-file-arrow-up" Foreground="{DynamicResource AccentPrimary}" FontSize="18"/>
                                    <TextBlock Text="CERTIFICATE REQUIRED" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button Grid.Column="1" Classes="btn-primary" Background="{DynamicResource AccentPrimary}" Padding="12,6" Command="{Binding UploadProcessDocumentCommand}" CommandParameter="Certificate" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <i:Icon Value="fa-solid fa-plus" FontSize="12" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="Upload" FontSize="12" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <TextBlock Text="Please upload the final Certificate document." Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,-8,0,0" TextWrapping="Wrap"/>

                            <!-- Tab Content (Files) -->
                            <StackPanel Spacing="16">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock Text="UPLOADED FILES" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="Bold"/>
                                </StackPanel>
                                
                                <TextBlock Text="No documents uploaded." Foreground="{DynamicResource TextFaint}" FontStyle="Italic" HorizontalAlignment="Center" Margin="0,20" IsVisible="{Binding !FilteredProcessDocuments.Count}"/>
                                
                                <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding FilteredProcessDocuments}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:AppDocument">
                                                <Border Classes="document-item" Background="{DynamicResource DrawerHeaderBg}" CornerRadius="10" Padding="16,12" Margin="0,0,0,8" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1">
                                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                                        <i:Icon Value="fa-solid fa-file-pdf" Foreground="{DynamicResource AccentPrimary}" FontSize="20" Margin="0,0,16,0"/>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding FileName}" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                                                <Border Background="{DynamicResource HoverBg}" CornerRadius="4" Padding="6,2">
                                                                    <TextBlock Text="{Binding FileType}" Foreground="{DynamicResource AccentPrimary}" FontSize="10" FontWeight="Bold"/>
                                                                </Border>
                                                                <TextBlock Text="{Binding FileSize}" Foreground="{DynamicResource TextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                                            <Button Classes="icon-btn" ToolTip.Tip="Preview" Command="{Binding $parent[UserControl].((vm:TradeLicenseDetailViewModel)DataContext).PreviewProcessDocumentCommand}" CommandParameter="{Binding}">
                                                                <i:Icon Value="fa-solid fa-eye" Foreground="{DynamicResource TextSecondary}"/>
                                                            </Button>
                                                            <Button Classes="icon-btn" ToolTip.Tip="Delete" Command="{Binding $parent[UserControl].((vm:TradeLicenseDetailViewModel)DataContext).RemoveProcessDocumentCommand}" CommandParameter="{Binding}">
                                                                <i:Icon Value="fa-solid fa-trash" Foreground="{DynamicResource StatusDanger}"/>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                                                <!-- General Information Card -->
                        <Border Classes="detail-card">
                            <StackPanel Spacing="24">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <i:Icon Value="fa-solid fa-address-card" Foreground="{DynamicResource AccentPrimary}" FontSize="18"/>
                                    <TextBlock Text="GENERAL INFORMATION" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Read-only registration details for the client." Foreground="{DynamicResource TextSecondary}" FontSize="13" Margin="0,-10,0,0"/>

                                <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, 24, Auto, 24, Auto">
                                    <!-- Row 1 -->
                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Text="CLIENT ID" Classes="card-label"/>
                                        <TextBlock Text="{Binding ClientId}" Classes="card-value"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1">
                                        <TextBlock Text="DATE" Classes="card-label"/>
                                        <TextBlock Text="{Binding Date, StringFormat={}{0:dd MMM yyyy}}" Classes="card-value"/>
                                    </StackPanel>

                                    <!-- Row 2 -->
                                    <StackPanel Grid.Row="2" Grid.Column="0">
                                        <TextBlock Text="CLIENT NAME" Classes="card-label"/>
                                        <TextBlock Text="{Binding ClientName}" Classes="card-value"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="1">
                                        <TextBlock Text="COMPANY NAME" Classes="card-label"/>
                                        <TextBlock Text="{Binding CompanyName}" Classes="card-value"/>
                                    </StackPanel>

                                    <!-- Row 3 -->
                                    <StackPanel Grid.Row="4" Grid.Column="0">
                                        <TextBlock Text="LICENSE CODE" Classes="card-label"/>
                                        <TextBlock Text="{Binding Code}" Classes="card-value"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="4" Grid.Column="1">
                                        <TextBlock Text="ASSIGNMENT DETAILS" Classes="card-label"/>
                                        <TextBlock Text="{Binding AssignmentDisplay}" Classes="card-value" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        

                <!-- 5. Documents Section -->
                                                                    <!-- Corporate Documents Card -->
                    <Border Classes="detail-card">
                        <StackPanel Spacing="20">
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                    <i:Icon Value="fa-solid fa-folder-open" Foreground="{DynamicResource AccentPrimary}" FontSize="18"/>
                                    <TextBlock Text="CORPORATE DOCUMENTS" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                </StackPanel>
                                
                            </Grid>
                            
                            <!-- Document Tabs -->
                            <Border BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1">
                                    <StackPanel Orientation="Horizontal" Spacing="0">
                                        <Button Classes="tab-btn" Classes.selected="{Binding SelectedCorporateDocumentTab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='BR'}" Command="{Binding SelectCorporateDocumentTabCommand}" CommandParameter="BR">
                                            <TextBlock Text="BR"/>
                                        </Button>
                                        <Button Classes="tab-btn" Classes.selected="{Binding SelectedCorporateDocumentTab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Form 01'}" Command="{Binding SelectCorporateDocumentTabCommand}" CommandParameter="Form 01">
                                            <TextBlock Text="Form 01"/>
                                        </Button>
                                        <Button Classes="tab-btn" Classes.selected="{Binding SelectedCorporateDocumentTab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Article of Association'}" Command="{Binding SelectCorporateDocumentTabCommand}" CommandParameter="Article of Association">
                                            <TextBlock Text="Article of Association"/>
                                        </Button>
                                        <Button Classes="tab-btn" Classes.selected="{Binding SelectedCorporateDocumentTab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='TIN'}" Command="{Binding SelectCorporateDocumentTabCommand}" CommandParameter="TIN">
                                            <TextBlock Text="TIN"/>
                                        </Button>
                                        <Button Classes="tab-btn" Classes.selected="{Binding SelectedCorporateDocumentTab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Tax Clearance Report'}" Command="{Binding SelectCorporateDocumentTabCommand}" CommandParameter="Tax Clearance Report">
                                            <TextBlock Text="Tax Clearance Report"/>
                                        </Button>
                                        <Button Classes="tab-btn" Classes.selected="{Binding SelectedCorporateDocumentTab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Deed'}" Command="{Binding SelectCorporateDocumentTabCommand}" CommandParameter="Deed">
                                            <TextBlock Text="Deed"/>
                                        </Button>
                                        <Button Classes="tab-btn" Classes.selected="{Binding SelectedCorporateDocumentTab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Billing Proof'}" Command="{Binding SelectCorporateDocumentTabCommand}" CommandParameter="Billing Proof">
                                            <TextBlock Text="Billing Proof"/>
                                        </Button>
                                        <Button Classes="tab-btn" Classes.selected="{Binding SelectedCorporateDocumentTab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Plan'}" Command="{Binding SelectCorporateDocumentTabCommand}" CommandParameter="Plan">
                                            <TextBlock Text="Plan"/>
                                        </Button>
                                    </StackPanel>
                            </Border>

                            <!-- Tab Content -->
                            <StackPanel Spacing="16">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock Text="UPLOADED:" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding SelectedCorporateDocumentTab}" Foreground="{DynamicResource TextPrimary}" FontSize="12" FontWeight="Bold"/>
                                </StackPanel>
                                
                                <TextBlock Text="No documents uploaded in this category." Foreground="{DynamicResource TextFaint}" FontStyle="Italic" HorizontalAlignment="Center" Margin="0,20" IsVisible="{Binding !FilteredCorporateDocuments.Count}"/>
                                
                                <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding FilteredCorporateDocuments}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:SourceDocument">
                                                <Border Classes="document-item" Background="{DynamicResource DrawerHeaderBg}" CornerRadius="10" Padding="16,12" Margin="0,0,0,8" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1">
                                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                                        <i:Icon Value="fa-solid fa-file-pdf" Foreground="{DynamicResource AccentPrimary}" FontSize="20" Margin="0,0,16,0"/>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding FileName}" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                        
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Button Classes="btn-detail-action" Padding="8" BorderThickness="0" Height="32"
                                                    Command="{Binding $parent[UserControl].DataContext.PreviewSourceDocumentCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="Preview this document">
                                                <i:Icon Value="fa-solid fa-eye" Foreground="{DynamicResource TextSecondary}" FontSize="14"/>
                                            </Button>
                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Supporting Documents Card -->
                    <Border Classes="detail-card">
                        <StackPanel Spacing="20">
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                    <i:Icon Value="fa-solid fa-folder-open" Foreground="{DynamicResource AccentPrimary}" FontSize="18"/>
                                    <TextBlock Text="SUPPORTING DOCUMENTS" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                </StackPanel>
                                
                            </Grid>
                            
                            <!-- Document Tabs -->
                            <Border BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1">
                                    <StackPanel Orientation="Horizontal" Spacing="0">
                                        <Button Classes="tab-btn" Classes.selected="{Binding SelectedSupportingDocumentTab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Photos'}" Command="{Binding SelectSupportingDocumentTabCommand}" CommandParameter="Photos">
                                            <TextBlock Text="Photos"/>
                                        </Button>
                                        <Button Classes="tab-btn" Classes.selected="{Binding SelectedSupportingDocumentTab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='BL'}" Command="{Binding SelectSupportingDocumentTabCommand}" CommandParameter="BL">
                                            <TextBlock Text="BL"/>
                                        </Button>
                                        <Button Classes="tab-btn" Classes.selected="{Binding SelectedSupportingDocumentTab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='LC'}" Command="{Binding SelectSupportingDocumentTabCommand}" CommandParameter="LC">
                                            <TextBlock Text="LC"/>
                                        </Button>
                                        <Button Classes="tab-btn" Classes.selected="{Binding SelectedSupportingDocumentTab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='GS Forms'}" Command="{Binding SelectSupportingDocumentTabCommand}" CommandParameter="GS Forms">
                                            <TextBlock Text="GS Forms"/>
                                        </Button>
                                        <Button Classes="tab-btn" Classes.selected="{Binding SelectedSupportingDocumentTab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Directors&amp;apos; NICs'}" Command="{Binding SelectSupportingDocumentTabCommand}" CommandParameter="Directors' NICs">
                                            <TextBlock Text="Directors' NICs"/>
                                        </Button>
                                        <Button Classes="tab-btn" Classes.selected="{Binding SelectedSupportingDocumentTab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='JP Certified Copy'}" Command="{Binding SelectSupportingDocumentTabCommand}" CommandParameter="JP Certified Copy">
                                            <TextBlock Text="JP Certified Copy"/>
                                        </Button>
                                        <Button Classes="tab-btn" Classes.selected="{Binding SelectedSupportingDocumentTab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Lawyer Certified Copy'}" Command="{Binding SelectSupportingDocumentTabCommand}" CommandParameter="Lawyer Certified Copy">
                                            <TextBlock Text="Lawyer Certified Copy"/>
                                        </Button>
                                    </StackPanel>
                            </Border>

                            <!-- Tab Content -->
                            <StackPanel Spacing="16">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock Text="UPLOADED:" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding SelectedSupportingDocumentTab}" Foreground="{DynamicResource TextPrimary}" FontSize="12" FontWeight="Bold"/>
                                </StackPanel>
                                
                                <TextBlock Text="No documents uploaded in this category." Foreground="{DynamicResource TextFaint}" FontStyle="Italic" HorizontalAlignment="Center" Margin="0,20" IsVisible="{Binding !FilteredSupportingDocuments.Count}"/>
                                
                                <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding FilteredSupportingDocuments}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:SourceDocument">
                                                <Border Classes="document-item" Background="{DynamicResource DrawerHeaderBg}" CornerRadius="10" Padding="16,12" Margin="0,0,0,8" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1">
                                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                                        <i:Icon Value="fa-solid fa-file-pdf" Foreground="{DynamicResource AccentPrimary}" FontSize="20" Margin="0,0,16,0"/>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding FileName}" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                        
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Button Classes="btn-detail-action" Padding="8" BorderThickness="0" Height="32"
                                                    Command="{Binding $parent[UserControl].DataContext.PreviewSourceDocumentCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="Preview this document">
                                                <i:Icon Value="fa-solid fa-eye" Foreground="{DynamicResource TextSecondary}" FontSize="14"/>
                                            </Button>
                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    
<Border Classes="detail-card" Margin="0,0,0,0">
                    <Grid RowDefinitions="Auto, Auto, *">
                        <!-- Header -->
                        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,24">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                <i:Icon Value="fa-solid fa-folder-open" Foreground="{DynamicResource AccentPrimary}" FontSize="18"/>
                                <TextBlock Text="REGISTRATION PROCESS DOCUMENTS" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Tabs -->
                        <Border Grid.Row="1" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1" Margin="0,0,0,24">
                            <StackPanel Orientation="Horizontal" Spacing="0">
                                <Button Classes="tab-btn" Classes.selected="{Binding SelectedProcessDocumentsCardTab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Temporary Certificate'}" Command="{Binding SelectProcessDocumentsCardTabCommand}" CommandParameter="Temporary Certificate">
                                    <TextBlock Text="Temporary Certificate"/>
                                </Button>
                                <Button Classes="tab-btn" Classes.selected="{Binding SelectedProcessDocumentsCardTab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Letter'}" Command="{Binding SelectProcessDocumentsCardTabCommand}" CommandParameter="Letter">
                                    <TextBlock Text="Letter"/>
                                </Button>
                                <Button Classes="tab-btn" Classes.selected="{Binding SelectedProcessDocumentsCardTab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Certificate'}" Command="{Binding SelectProcessDocumentsCardTabCommand}" CommandParameter="Certificate">
                                    <TextBlock Text="Certificate"/>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Tab Content (Files) -->
                        <Grid Grid.Row="2" RowDefinitions="Auto, *">
                            <StackPanel Grid.Row="0" Spacing="16">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock Text="RECORDS IN" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding SelectedProcessDocumentsCardTab}" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="Bold"/>
                                </StackPanel>
                                
                                <TextBlock Text="No documents found." Foreground="{DynamicResource TextFaint}" FontStyle="Italic" HorizontalAlignment="Center" Margin="0,20" IsVisible="{Binding !FilteredProcessCardDocuments.Count}"/>
                            </StackPanel>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                                <ItemsControl ItemsSource="{Binding FilteredProcessCardDocuments}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:AppDocument">
                                            <Border Classes="document-item" Background="{DynamicResource DrawerHeaderBg}" CornerRadius="10" Padding="16,12" Margin="0,0,0,8" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1">
                                                <Grid ColumnDefinitions="Auto, *, Auto">
                                                    <i:Icon Value="fa-solid fa-file-pdf" Foreground="{DynamicResource AccentPrimary}" FontSize="20" Margin="0,0,16,0"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FileName}" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="{Binding FileSize}" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                                            <TextBlock Text="â€¢" Foreground="{DynamicResource TextFaint}" FontSize="11"/>
                                                            <TextBlock Text="{Binding Type}" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- Hover Actions -->
                                                    <StackPanel Grid.Column="2" Classes="action-icons" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <Button Classes="icon-action-btn" Command="{Binding $parent[UserControl].((vm:TradeLicenseDetailViewModel)DataContext).PreviewProcessDocumentCommand}" CommandParameter="{Binding}">
                                                            <i:Icon Value="fa-solid fa-eye" Foreground="{DynamicResource TextSecondary}"/>
                                                        </Button>
                                                        <Button Classes="icon-action-btn" Command="{Binding $parent[UserControl].((vm:TradeLicenseDetailViewModel)DataContext).RemoveProcessDocumentCommand}" CommandParameter="{Binding}">
                                                            <i:Icon Value="fa-solid fa-trash-can" Foreground="{DynamicResource StatusDanger}"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Border>
 
                                                

                    </StackPanel>
                </Grid>

                <!-- Footer Actions -->
                <Grid Grid.Row="4" ColumnDefinitions="Auto, *, Auto" VerticalAlignment="Bottom" Margin="0,40,0,0">
                    <Button Grid.Column="0" Classes="footer-link" Command="{Binding OpenGuideCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <i:Icon Value="fa-solid fa-circle-question" Foreground="{DynamicResource TextSecondary}" FontSize="16"/>
                            <TextBlock Text="Learn more about Trade License Details" Foreground="{DynamicResource TextSecondary}" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16">
                        <Button Name="EditRecordButton" Content="Edit" Classes="btn-edit" Width="140" Command="{Binding EditRecordCommand}"/>
                        <Button Name="DeleteRecordButton" Content="Delete" Classes="btn-delete" Width="140" Command="{Binding DeleteRecordCommand}"/>
                    </StackPanel>
                </Grid>

            </Grid>
        </ScrollViewer>

        <!-- Instruction Guide Popup (Global Style Sync) -->
        <Border ZIndex="4000" IsVisible="{Binding IsGuideVisible}" helpers:GuideHelper.EnableOutsideClickClose="True" Background="{DynamicResource OverlayBg}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="-30">
             <Border Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" CornerRadius="12" Width="600" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="30" BoxShadow="0 8 32 0 #66000000">
                <StackPanel Spacing="25">
                    <!-- Header -->
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <i:Icon Value="fa-regular fa-circle-question" FontSize="20" Foreground="{DynamicResource TextHeading}"/>
                            <TextBlock Text="{Binding GuideTitle}" Foreground="{DynamicResource TextHeading}" FontSize="20" FontWeight="Bold"/>
                        </StackPanel>
                        <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="5" Command="{Binding CloseGuideCommand}" Cursor="Hand">
                            <i:Icon Value="fa-solid fa-xmark" Foreground="{DynamicResource TextSecondary}" FontSize="18"/>
                        </Button>
                    </Grid>
                    
                    <TextBlock Text="{Binding GuideDescription}" Foreground="{DynamicResource TextSecondary}" FontSize="14" Margin="0,-10,0,10"/>

                    <!-- Features Grid -->
                    <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, *" Margin="0,0,0,10">
                        <!-- 1 -->
                        <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource GuideCardBg}" CornerRadius="8" Padding="15" Margin="0,0,10,10">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Background="{DynamicResource GuideBadgeBg}" CornerRadius="10" Width="20" Height="20">
                                        <TextBlock Text="1" Foreground="{DynamicResource GuideCardBg}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Timeline Progress" Foreground="{DynamicResource TextHeading}" FontWeight="Bold" FontSize="14"/>
                                </StackPanel>
                                <TextBlock Text="Track the registration process from start to finish." Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- 2 -->
                        <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource GuideCardBg}" CornerRadius="8" Padding="15" Margin="10,0,0,10">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Background="{DynamicResource GuideBadgeBg}" CornerRadius="10" Width="20" Height="20">
                                        <TextBlock Text="2" Foreground="{DynamicResource GuideCardBg}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Attachments" Foreground="{DynamicResource TextHeading}" FontWeight="Bold" FontSize="14"/>
                                </StackPanel>
                                <TextBlock Text="View and manage uploaded documents for each stage of the Trade License process." Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- 3 -->
                        <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource GuideCardBg}" CornerRadius="8" Padding="15" Margin="0,10,10,0">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Background="{DynamicResource GuideBadgeBg}" CornerRadius="10" Width="20" Height="20">
                                        <TextBlock Text="3" Foreground="{DynamicResource GuideCardBg}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Activity Timeline" Foreground="{DynamicResource TextHeading}" FontWeight="Bold" FontSize="14"/>
                                </StackPanel>
                                <TextBlock Text="View the history of activity on this record. Currently under development." Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- 4 -->
                        <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource GuideCardBg}" CornerRadius="8" Padding="15" Margin="10,10,0,0">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Background="{DynamicResource GuideBadgeBg}" CornerRadius="10" Width="20" Height="20">
                                        <TextBlock Text="4" Foreground="{DynamicResource GuideCardBg}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Action Center" Foreground="{DynamicResource TextHeading}" FontWeight="Bold" FontSize="14"/>
                                </StackPanel>
                                <TextBlock Text="Use the bottom action bar to quickly edit, delete, or generate reports for this specific record." Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Pro Tip -->
                    <Border Background="{DynamicResource DrawerHeaderBg}" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" CornerRadius="8" Padding="15">
                        <StackPanel Spacing="10">
                            <TextBlock Text="PRO TIP" Foreground="{DynamicResource TextSecondary}" FontWeight="Bold" FontSize="11"/>
                            <TextBlock Text="{Binding GuideProTip}" Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    
                    <Button Content="Got it, thanks!" Command="{Binding CloseGuideCommand}" Background="{DynamicResource GuideGotItBg}" Foreground="{DynamicResource DrawerHeaderBg}" FontWeight="Bold" CornerRadius="6" Padding="15,8" HorizontalAlignment="Right" Cursor="Hand"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- Global Confirmation Dialog Overlay -->
        <Border Classes="premium-modal-overlay" IsVisible="{Binding IsConfirmDialogVisible}" ZIndex="1000">
            <Border Classes="premium-modal-content" HorizontalAlignment="Center" VerticalAlignment="Center" Width="480">
                <StackPanel Spacing="28">
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                             <Border Width="48" Height="48" CornerRadius="24" Background="{DynamicResource HoverBg}">
                                <i:Icon Value="fa-solid fa-circle-exclamation" Foreground="{DynamicResource StatusDanger}" FontSize="22"/>
                            </Border>
                            <TextBlock Text="{Binding ConfirmDialogTitle}" Foreground="{DynamicResource TextHeading}" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="footer-link" Command="{Binding CancelActionCommand}" VerticalAlignment="Top" Margin="0,-10,-10,0">
                            <i:Icon Value="fa-solid fa-xmark" Foreground="{DynamicResource TextSecondary}" FontSize="20"/>
                        </Button>
                    </Grid>
                    <TextBlock Text="{Binding ConfirmDialogMessage}" Foreground="{DynamicResource TextSecondary}" FontSize="16" LineHeight="26" TextWrapping="Wrap"/>
                    <Grid ColumnDefinitions="*, 12, *" Margin="0,10,0,0">
                        <Button Grid.Column="0" Content="Cancel" Classes="btn-secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding CancelActionCommand}"/>
                        <Button Name="ConfirmDeleteButton" Grid.Column="2" Content="Confirm" Classes="btn-delete" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding ConfirmActionCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- Loading Busy Overlay -->
        <Border Background="#80000000" IsVisible="{Binding IsBusy}" ZIndex="2000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="15">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4" Foreground="{DynamicResource AccentPrimary}"/>
                <TextBlock Text="Processing..." Foreground="White" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="14"/>
            </StackPanel>
        </Border>
    </Panel>
</UserControl>
