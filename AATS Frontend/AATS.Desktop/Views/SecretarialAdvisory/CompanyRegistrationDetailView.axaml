<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:helpers="using:AATS.Desktop.Helpers"
             xmlns:vm="clr-namespace:AATS.Desktop.ViewModels.SecretarialAdvisory"
             xmlns:models="clr-namespace:AATS.Desktop.Models"
             xmlns:vmb="clr-namespace:AATS.Desktop.ViewModels"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="900"
             x:Class="AATS.Desktop.Views.SecretarialAdvisory.CompanyRegistrationDetailView"
             x:DataType="vm:CompanyRegistrationDetailViewModel">

    <UserControl.Styles>
        <Style Selector="Border.detail-card">
            <Setter Property="Background" Value="{DynamicResource TableBg}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="32"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="TextBlock.card-label">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style Selector="TextBlock.card-value">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        

        <!-- Popup Styles -->
        <Style Selector="Border.upload-drop-zone">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="40"/>
        </Style>
        <Style Selector="Border.upload-drop-zone:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource DrawerHeaderBg}"/>
        </Style>

        <Style Selector="Border.file-item-card">
            <Setter Property="Background" Value="{DynamicResource DrawerHeaderBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,12"/>
        </Style>

        <Style Selector="Button.icon-action-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
        </Style>
        <Style Selector="Button.icon-action-btn i|Icon">
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style Selector="ComboBox.popup-input">
            <Setter Property="Background" Value="{DynamicResource DrawerHeaderBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}"/>
        </Style>
        <Style Selector="TextBox.popup-input">
            <Setter Property="Background" Value="{DynamicResource DrawerHeaderBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}"/>
        </Style>

        <!-- Hover Action Styles -->
        <Style Selector="Border.document-item StackPanel.action-icons">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.document-item:pointerover StackPanel.action-icons">
            <Setter Property="Opacity" Value="1"/>
        </Style>
    </UserControl.Styles>

    <Panel>
        <ScrollViewer>
            <Grid RowDefinitions="Auto, Auto, Auto, *, Auto" Margin="40,20,40,40" IsSharedSizeScope="True">
                
                <!-- 1. Header Section -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,32">
                    <!-- Client Brand -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16">
                        <Border Width="64" Height="64" CornerRadius="16" Background="{DynamicResource FilterBarBg}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                            <i:Icon Value="fa-solid fa-building" Foreground="{DynamicResource AccentPrimary}" FontSize="28"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="16">
                            <TextBlock Text="{Binding ClientName}" FontSize="36" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                            <Border Background="{Binding ClientCategoryColor}" CornerRadius="12" Padding="12,4" VerticalAlignment="Center" IsVisible="{Binding HasClientCategory}">
                                <TextBlock Text="{Binding ClientCategory}" Foreground="Black" FontSize="12" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
 
                    <!-- Header Actions -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                        <Button Classes="btn-secondary" Command="{Binding DownloadRecordCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <i:Icon Value="fa-solid fa-download" FontSize="14" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="Download Report" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="btn-print" Command="{Binding PrintRecordCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <i:Icon Value="fa-solid fa-print" FontSize="14" Foreground="{DynamicResource AddRecordFg}"/>
                                <TextBlock Text="Print" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
 
                <!-- 2. Info Grid Summary -->
                <Grid Grid.Row="1" ColumnDefinitions="*, 20, *, 20, *, 20, *" Margin="0,0,0,32">
                    <Border Grid.Column="0" Classes="detail-summary-card">
                        <StackPanel>
                            <TextBlock Text="ID" Classes="detail-card-label"/>
                            <TextBlock Text="{Binding ID}" Classes="detail-card-value"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Classes="detail-summary-card">
                        <StackPanel>
                            <TextBlock Text="DATE" Classes="detail-card-label"/>
                            <TextBlock Text="{Binding Date}" Classes="detail-card-value"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Classes="detail-summary-card">
                        <StackPanel>
                            <TextBlock Text="BRANCH" Classes="detail-card-label"/>
                            <TextBlock Text="{Binding Record.Branch}" Classes="detail-card-value"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="6" Classes="detail-summary-card">
                        <StackPanel>
                            <TextBlock Text="STATUS" Classes="detail-card-label"/>
                            <TextBlock Text="{Binding PaymentStatus}" Classes="detail-card-value"/>
                        </StackPanel>
                    </Border>
                </Grid>
 
                <!-- Billing Details Section (only visible if payment status is Partial) -->
                <Border Grid.Row="2" Background="{DynamicResource CardBg}" CornerRadius="12" Padding="25" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" Margin="0,0,0,32" IsVisible="{Binding IsPaymentStatusPartial}">
                    <Grid ColumnDefinitions="*, *, *, *">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="PAYMENT STATUS" Classes="detail-card-label" Foreground="{DynamicResource TextSecondary}" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding PaymentStatus}" Classes="detail-card-value" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource StatusWarning}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="PARTIALLY PAID AMOUNT" Classes="detail-card-label" Foreground="{DynamicResource TextSecondary}" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding PartiallyPaidAmount, StringFormat='{}Rs. {0:N2}'}" Classes="detail-card-value" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="OUTSTANDING BALANCE" Classes="detail-card-label" Foreground="{DynamicResource TextSecondary}" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding OutstandingBalance, StringFormat='{}Rs. {0:N2}'}" Classes="detail-card-value" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource StatusDanger}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="TOTAL PAYMENT DUE" Classes="detail-card-label" Foreground="{DynamicResource TextSecondary}" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding TotalPaymentDue, StringFormat='{}Rs. {0:N2}'}" Classes="detail-card-value" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource StatusDanger}"/>
                        </StackPanel>

                    <!-- Bottom Section: Process Documents Viewer -->
                    <Border Grid.Row="3" Grid.ColumnSpan="3" Classes="detail-card" Margin="0,32,0,0" Padding="0">
                        <Grid RowDefinitions="Auto, *">
                            <Border Background="{DynamicResource CardBackgroundSecondary}" CornerRadius="12,12,0,0" Padding="24,16">
                                <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                                    <PathIcon Data="{StaticResource FolderRegular}" Width="20" Height="20" Foreground="{DynamicResource AccentPrimary}"/>
                                    <TextBlock Text="Process Documents Viewer" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                </StackPanel>
                            </Border>
                            
                            <Grid Grid.Row="1" RowDefinitions="Auto, *" Margin="24">
                                <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
                                        <Button Classes="tab-btn" Classes.active="{Binding SelectedProcessDocumentTab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Name Approval'}"
                                                Command="{Binding SelectProcessDocumentTabCommand}" CommandParameter="Name Approval">
                                            <TextBlock Text="Name Approval" />
                                        </Button>
                                        <Button Classes="tab-btn" Classes.active="{Binding SelectedProcessDocumentTab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Signature'}"
                                                Command="{Binding SelectProcessDocumentTabCommand}" CommandParameter="Signature">
                                            <TextBlock Text="Signature" />
                                        </Button>
                                        <Button Classes="tab-btn" Classes.active="{Binding SelectedProcessDocumentTab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Incorporation'}"
                                                Command="{Binding SelectProcessDocumentTabCommand}" CommandParameter="Incorporation">
                                            <TextBlock Text="Incorporation" />
                                        </Button>
                                        <Button Classes="tab-btn" Classes.active="{Binding SelectedProcessDocumentTab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Certified Copies'}"
                                                Command="{Binding SelectProcessDocumentTabCommand}" CommandParameter="Certified Copies">
                                            <TextBlock Text="Certified Copies" />
                                        </Button>
                                    </StackPanel>
                                </ScrollViewer>
                                
                                <Border Grid.Row="1" Background="{DynamicResource CardBackgroundSecondary}" CornerRadius="8" Padding="16">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="300">
                                        <ItemsControl ItemsSource="{Binding FilteredProcessDocuments}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource CardBackground}" CornerRadius="8" Padding="12" Margin="0,0,0,8"
                                                            BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                                                        <Grid ColumnDefinitions="Auto, *, Auto">
                                                            <PathIcon Data="{StaticResource DocumentRegular}" Width="24" Height="24" Foreground="{DynamicResource AccentPrimary}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding FileName}" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                                                                <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                                                                    <TextBlock Text="{Binding Type}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                                                    <TextBlock Text="{Binding FileSize}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                                <Button Classes="icon-btn" ToolTip.Tip="Preview"
                                                                        Command="{Binding $parent[UserControl].((vm:CompanyRegistrationDetailViewModel)DataContext).PreviewProcessDocumentCommand}"
                                                                        CommandParameter="{Binding}">
                                                                    <PathIcon Data="{StaticResource EyeRegular}" Width="16" Height="16"/>
                                                                </Button>
                                                                <Button Classes="icon-btn danger" ToolTip.Tip="Remove"
                                                                        Command="{Binding $parent[UserControl].((vm:CompanyRegistrationDetailViewModel)DataContext).RemoveProcessDocumentCommand}"
                                                                        CommandParameter="{Binding}">
                                                                    <PathIcon Data="{StaticResource DeleteRegular}" Width="16" Height="16"/>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                    </Grid>
                </Border>

 
                <!-- 3. Content Area -->
                <Grid Grid.Row="3" RowDefinitions="Auto, Auto, *, Auto" ColumnDefinitions="*, 40, *">
                    
                    <!-- Top Section: Registration Process Timeline -->
                    <Border Grid.Row="0" Grid.ColumnSpan="3" Classes="detail-card" Margin="0,0,0,32" Padding="32">
                        <StackPanel Spacing="24">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <i:Icon Value="fa-solid fa-bars-progress" Foreground="{DynamicResource AccentPrimary}" FontSize="18"/>
                                <TextBlock Text="REGISTRATION PROCESS" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            
                            <ItemsControl ItemsSource="{Binding Steps}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vmb:ProcessStep" x:CompileBindings="False">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button AutomationProperties.AutomationId="{Binding Number, StringFormat='ProcessStep_{0}'}" Classes="process-step-btn" 
                                                    Command="{Binding $parent[UserControl].((vm:CompanyRegistrationDetailViewModel)DataContext).StepClickCommand}" 
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding IsClickable}">
                                                <StackPanel Spacing="12">
                                                    <Border Classes="step-indicator-circle" 
                                                            Classes.active="{Binding IsActive}"
                                                            Classes.clickable="{Binding IsClickable}"
                                                            Width="40" Height="40">
                                                        <TextBlock Text="{Binding Number}" 
                                                                  Classes="step-indicator-num" 
                                                                  Classes.active="{Binding IsActive}"
                                                                  FontSize="16"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Name}" 
                                                              Classes="step-indicator-label" 
                                                              Classes.active="{Binding IsActive}"
                                                              Width="110" TextAlignment="Center" FontSize="11"/>
                                                </StackPanel>
                                            </Button>
                                            
                                            <Rectangle Width="45" Height="2" Fill="{DynamicResource BorderSubtle}" Margin="5,20,5,0" VerticalAlignment="Top" IsVisible="{Binding IsNotLast}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    
                    <!-- Dynamic Document Upload Cards -->
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Spacing="24" Margin="0,0,0,32">
                        
                        <!-- Name Approval Proof Upload -->
                        <Border Classes="detail-card" IsVisible="{Binding IsNameApprovalUploadVisible}">
                            <StackPanel Spacing="24">
                                <Grid ColumnDefinitions="*, Auto">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                        <i:Icon Value="fa-solid fa-file-arrow-up" Foreground="{DynamicResource AccentPrimary}" FontSize="18"/>
                                        <TextBlock Text="NAME APPROVAL PROOF REQUIRED" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="btn-primary" Background="{DynamicResource AccentPrimary}" Padding="12,6" Command="{Binding UploadProcessDocumentCommand}" CommandParameter="Name Approval" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <i:Icon Value="fa-solid fa-plus" FontSize="12" Foreground="{DynamicResource TextPrimary}"/>
                                            <TextBlock Text="Upload" FontSize="12" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock Text="Please upload the Name Approval Certificate to proceed with the registration." Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,-8,0,0" TextWrapping="Wrap"/>

                                <!-- Tab Content (Files) -->
                                <StackPanel Spacing="16">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <TextBlock Text="UPLOADED FILES" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="Bold"/>
                                    </StackPanel>
                                    
                                    <TextBlock Text="No documents uploaded." Foreground="{DynamicResource TextFaint}" FontStyle="Italic" HorizontalAlignment="Center" Margin="0,20" IsVisible="{Binding !FilteredProcessDocuments.Count}"/>
                                    
                                    <ScrollViewer MaxHeight="350" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding FilteredProcessDocuments}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:AppDocument">
                                                    <Border Classes="document-item" Background="{DynamicResource DrawerHeaderBg}" CornerRadius="10" Padding="16,12" Margin="0,0,0,8" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1">
                                                        <Grid ColumnDefinitions="Auto, *, Auto">
                                                            <i:Icon Value="fa-solid fa-file-pdf" Foreground="{DynamicResource AccentPrimary}" FontSize="20" Margin="0,0,16,0"/>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding FileName}" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <TextBlock Text="{Binding FileSize}" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                                                    <TextBlock Text="â€¢" Foreground="{DynamicResource TextFaint}" FontSize="11"/>
                                                                    <TextBlock Text="{Binding Category}" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                            
                                                            <!-- Hover Actions -->
                                                            <StackPanel Grid.Column="2" Classes="action-icons" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                                <Button Classes="icon-action-btn" Command="{Binding $parent[UserControl].((vm:CompanyRegistrationDetailViewModel)DataContext).PreviewProcessDocumentCommand}" CommandParameter="{Binding}">
                                                                    <i:Icon Value="fa-solid fa-eye" Foreground="{DynamicResource TextSecondary}"/>
                                                                </Button>
                                                                <Button Classes="icon-action-btn" Command="{Binding $parent[UserControl].((vm:CompanyRegistrationDetailViewModel)DataContext).RemoveProcessDocumentCommand}" CommandParameter="{Binding}">
                                                                    <i:Icon Value="fa-solid fa-trash-can" Foreground="{DynamicResource StatusDanger}"/>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>

                            </StackPanel>
                        </Border>

                                                <!-- Signature Upload -->
                        <Border Classes="detail-card" IsVisible="{Binding IsSignatureUploadVisible}">
                            <StackPanel Spacing="24">
                                <Grid ColumnDefinitions="*, Auto">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                        <i:Icon Value="fa-solid fa-signature" Foreground="{DynamicResource AccentPrimary}" FontSize="18"/>
                                        <TextBlock Text="SIGNATURES REQUIRED" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="btn-primary" Background="{DynamicResource AccentPrimary}" Padding="12,6" Command="{Binding UploadProcessDocumentCommand}" CommandParameter="{Binding SelectedSignatureTab}" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <i:Icon Value="fa-solid fa-plus" FontSize="12" Foreground="{DynamicResource TextPrimary}"/>
                                            <TextBlock Text="Upload" FontSize="12" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock Text="Please upload Form 01, Form 18, Form 19, and Articles of Association." Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,-8,0,0" TextWrapping="Wrap"/>

                                <!-- Signature Tabs -->
                                <Border BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1">
                                    <StackPanel Orientation="Horizontal" Spacing="0">
                                        <Button Classes="tab-btn" Classes.selected="{Binding SelectedSignatureTab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Form 01'}" Command="{Binding SelectSignatureTabCommand}" CommandParameter="Form 01">
                                            <TextBlock Text="Form 01"/>
                                        </Button>
                                        <Button Classes="tab-btn" Classes.selected="{Binding SelectedSignatureTab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Form 18'}" Command="{Binding SelectSignatureTabCommand}" CommandParameter="Form 18">
                                            <TextBlock Text="Form 18"/>
                                        </Button>
                                        <Button Classes="tab-btn" Classes.selected="{Binding SelectedSignatureTab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Form 19'}" Command="{Binding SelectSignatureTabCommand}" CommandParameter="Form 19">
                                            <TextBlock Text="Form 19"/>
                                        </Button>
                                        <Button Classes="tab-btn" Classes.selected="{Binding SelectedSignatureTab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Articles of Association'}" Command="{Binding SelectSignatureTabCommand}" CommandParameter="Articles of Association">
                                            <TextBlock Text="Articles of Association"/>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Tab Content (Files) -->
                                <StackPanel Spacing="16">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <TextBlock Text="UPLOADED" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding SelectedSignatureTab}" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="Bold"/>
                                    </StackPanel>
                                    
                                    <TextBlock Text="No documents uploaded." Foreground="{DynamicResource TextFaint}" FontStyle="Italic" HorizontalAlignment="Center" Margin="0,20" IsVisible="{Binding !FilteredProcessDocuments.Count}"/>
                                    
                                    <ScrollViewer MaxHeight="350" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding FilteredProcessDocuments}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:AppDocument">
                                                    <Border Classes="document-item" Background="{DynamicResource DrawerHeaderBg}" CornerRadius="10" Padding="16,12" Margin="0,0,0,8" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1">
                                                        <Grid ColumnDefinitions="Auto, *, Auto">
                                                            <i:Icon Value="fa-solid fa-file-pdf" Foreground="{DynamicResource AccentPrimary}" FontSize="20" Margin="0,0,16,0"/>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding FileName}" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <TextBlock Text="{Binding FileSize}" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                                                    <TextBlock Text="â€¢" Foreground="{DynamicResource TextFaint}" FontSize="11"/>
                                                                    <TextBlock Text="{Binding Category}" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                            
                                                            <!-- Hover Actions -->
                                                            <StackPanel Grid.Column="2" Classes="action-icons" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                                <Button Classes="icon-action-btn" Command="{Binding $parent[UserControl].((vm:CompanyRegistrationDetailViewModel)DataContext).PreviewProcessDocumentCommand}" CommandParameter="{Binding}">
                                                                    <i:Icon Value="fa-solid fa-eye" Foreground="{DynamicResource TextSecondary}"/>
                                                                </Button>
                                                                <Button Classes="icon-action-btn" Command="{Binding $parent[UserControl].((vm:CompanyRegistrationDetailViewModel)DataContext).RemoveProcessDocumentCommand}" CommandParameter="{Binding}">
                                                                    <i:Icon Value="fa-solid fa-trash-can" Foreground="{DynamicResource StatusDanger}"/>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>

                            </StackPanel>
                        </Border>

                        <!-- Incorporation Certificate Upload -->
                        <Border Classes="detail-card" IsVisible="{Binding IsIncorporationUploadVisible}">
                            <StackPanel Spacing="24">
                                <Grid ColumnDefinitions="*, Auto">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                        <i:Icon Value="fa-solid fa-building" Foreground="{DynamicResource AccentPrimary}" FontSize="18"/>
                                        <TextBlock Text="INCORPORATION CERTIFICATE" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="btn-primary" Background="{DynamicResource AccentPrimary}" Padding="12,6" Command="{Binding UploadProcessDocumentCommand}" CommandParameter="Certificate" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <i:Icon Value="fa-solid fa-plus" FontSize="12" Foreground="{DynamicResource TextPrimary}"/>
                                            <TextBlock Text="Upload" FontSize="12" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock Text="Please upload the final Certificate of Incorporation." Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,-8,0,0" TextWrapping="Wrap"/>

                                <!-- Tab Content (Files) -->
                                <StackPanel Spacing="16">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <TextBlock Text="UPLOADED FILES" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="Bold"/>
                                    </StackPanel>
                                    
                                    <TextBlock Text="No documents uploaded." Foreground="{DynamicResource TextFaint}" FontStyle="Italic" HorizontalAlignment="Center" Margin="0,20" IsVisible="{Binding !FilteredProcessDocuments.Count}"/>
                                    
                                    <ScrollViewer MaxHeight="350" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding FilteredProcessDocuments}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:AppDocument">
                                                    <Border Classes="document-item" Background="{DynamicResource DrawerHeaderBg}" CornerRadius="10" Padding="16,12" Margin="0,0,0,8" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1">
                                                        <Grid ColumnDefinitions="Auto, *, Auto">
                                                            <i:Icon Value="fa-solid fa-file-pdf" Foreground="{DynamicResource AccentPrimary}" FontSize="20" Margin="0,0,16,0"/>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding FileName}" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <TextBlock Text="{Binding FileSize}" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                                                    <TextBlock Text="â€¢" Foreground="{DynamicResource TextFaint}" FontSize="11"/>
                                                                    <TextBlock Text="{Binding Category}" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                            
                                                            <!-- Hover Actions -->
                                                            <StackPanel Grid.Column="2" Classes="action-icons" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                                <Button Classes="icon-action-btn" Command="{Binding $parent[UserControl].((vm:CompanyRegistrationDetailViewModel)DataContext).PreviewProcessDocumentCommand}" CommandParameter="{Binding}">
                                                                    <i:Icon Value="fa-solid fa-eye" Foreground="{DynamicResource TextSecondary}"/>
                                                                </Button>
                                                                <Button Classes="icon-action-btn" Command="{Binding $parent[UserControl].((vm:CompanyRegistrationDetailViewModel)DataContext).RemoveProcessDocumentCommand}" CommandParameter="{Binding}">
                                                                    <i:Icon Value="fa-solid fa-trash-can" Foreground="{DynamicResource StatusDanger}"/>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>

                            </StackPanel>
                        </Border>

                        <!-- Certified Copies Upload -->
                        <Border Classes="detail-card" IsVisible="{Binding IsCertifiedCopiesUploadVisible}">
                            <StackPanel Spacing="24">
                                <Grid ColumnDefinitions="*, Auto">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                        <i:Icon Value="fa-solid fa-copy" Foreground="{DynamicResource AccentPrimary}" FontSize="18"/>
                                        <TextBlock Text="CERTIFIED COPIES" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="btn-primary" Background="{DynamicResource AccentPrimary}" Padding="12,6" Command="{Binding UploadProcessDocumentCommand}" CommandParameter="Certified Copy" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <i:Icon Value="fa-solid fa-plus" FontSize="12" Foreground="{DynamicResource TextPrimary}"/>
                                            <TextBlock Text="Upload" FontSize="12" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock Text="Please upload certified copies of all registration documents." Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,-8,0,0" TextWrapping="Wrap"/>

                                <!-- Tab Content (Files) -->
                                <StackPanel Spacing="16">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <TextBlock Text="UPLOADED FILES" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="Bold"/>
                                    </StackPanel>
                                    
                                    <TextBlock Text="No documents uploaded." Foreground="{DynamicResource TextFaint}" FontStyle="Italic" HorizontalAlignment="Center" Margin="0,20" IsVisible="{Binding !FilteredProcessDocuments.Count}"/>
                                    
                                    <ScrollViewer MaxHeight="350" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding FilteredProcessDocuments}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:AppDocument">
                                                    <Border Classes="document-item" Background="{DynamicResource DrawerHeaderBg}" CornerRadius="10" Padding="16,12" Margin="0,0,0,8" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1">
                                                        <Grid ColumnDefinitions="Auto, *, Auto">
                                                            <i:Icon Value="fa-solid fa-file-pdf" Foreground="{DynamicResource AccentPrimary}" FontSize="20" Margin="0,0,16,0"/>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding FileName}" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <TextBlock Text="{Binding FileSize}" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                                                    <TextBlock Text="â€¢" Foreground="{DynamicResource TextFaint}" FontSize="11"/>
                                                                    <TextBlock Text="{Binding Category}" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                            
                                                            <!-- Hover Actions -->
                                                            <StackPanel Grid.Column="2" Classes="action-icons" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                                <Button Classes="icon-action-btn" Command="{Binding $parent[UserControl].((vm:CompanyRegistrationDetailViewModel)DataContext).PreviewProcessDocumentCommand}" CommandParameter="{Binding}">
                                                                    <i:Icon Value="fa-solid fa-eye" Foreground="{DynamicResource TextSecondary}"/>
                                                                </Button>
                                                                <Button Classes="icon-action-btn" Command="{Binding $parent[UserControl].((vm:CompanyRegistrationDetailViewModel)DataContext).RemoveProcessDocumentCommand}" CommandParameter="{Binding}">
                                                                    <i:Icon Value="fa-solid fa-trash-can" Foreground="{DynamicResource StatusDanger}"/>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>

                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Left Column: Details, Personnel, Documents -->

                    <StackPanel Grid.Row="2" Grid.Column="0" Spacing="32">
                        
                        <!-- Registration Details -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" SharedSizeGroup="TopCardHeight"/>
                            </Grid.RowDefinitions>
                            <Border Classes="detail-card" Grid.Row="0">
                                <Grid RowDefinitions="Auto, *">
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,20">
                                        <i:Icon Value="fa-solid fa-building-circle-check" Foreground="{DynamicResource AccentPrimary}" FontSize="18"/>
                                        <TextBlock Text="REGISTRATION DETAILS" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, 24, Auto">
                                        <!-- Row 1 -->
                                        <StackPanel Grid.Row="0" Grid.Column="0">
                                            <TextBlock Text="COMPANY NAME" Classes="card-label"/>
                                            <TextBlock Text="{Binding ClientName}" Classes="card-value"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1">
                                            <TextBlock Text="TYPE" Classes="card-label"/>
                                            <TextBlock Text="{Binding CompanyType}" Classes="card-value"/>
                                        </StackPanel>
                                        
                                        <!-- Row 2 -->
                                        <StackPanel Grid.Row="2" Grid.Column="0">
                                            <TextBlock Text="ADDRESS" Classes="card-label"/>
                                            <TextBlock Text="{Binding Address}" Classes="card-value" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="1">
                                            <TextBlock Text="EMAIL" Classes="card-label"/>
                                            <TextBlock Text="{Binding Email}" Classes="card-value"/>
                                            <TextBlock Text="PHONE" Classes="card-label" Margin="0,16,0,4"/>
                                            <TextBlock Text="{Binding Phone}" Classes="card-value"/>
                                        </StackPanel>
                                        </Grid>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Personnel -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" SharedSizeGroup="MiddleCardHeight"/>
                            </Grid.RowDefinitions>
                            <Border Classes="detail-card" Grid.Row="0">
                            <Grid RowDefinitions="Auto, Auto, *">
                                <!-- Personnel Header -->
                                <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,24">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                        <i:Icon Value="fa-solid fa-users" Foreground="{DynamicResource AccentPrimary}" FontSize="18"/>
                                        <TextBlock Text="PERSONNEL" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Personnel Tabs -->
                                <Border Grid.Row="1" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1" Margin="0,0,0,24">
                                    <StackPanel Orientation="Horizontal" Spacing="0">
                                        <Button Classes="tab-btn" Classes.selected="{Binding SelectedPersonnelTab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Directors'}" Command="{Binding SelectPersonnelTabCommand}" CommandParameter="Directors">
                                            <TextBlock Text="Directors"/>
                                        </Button>
                                        <Button Classes="tab-btn" Classes.selected="{Binding SelectedPersonnelTab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Secretaries'}" Command="{Binding SelectPersonnelTabCommand}" CommandParameter="Secretaries">
                                            <TextBlock Text="Secretaries"/>
                                        </Button>
                                        <Button Classes="tab-btn" Classes.selected="{Binding SelectedPersonnelTab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Shareholders'}" Command="{Binding SelectPersonnelTabCommand}" CommandParameter="Shareholders">
                                            <TextBlock Text="Shareholders"/>
                                        </Button>
                                        <Button Classes="tab-btn" Classes.selected="{Binding SelectedPersonnelTab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Others'}" Command="{Binding SelectPersonnelTabCommand}" CommandParameter="Others">
                                            <TextBlock Text="Others"/>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Tab Content (Personnel) -->
                                <Grid Grid.Row="2" RowDefinitions="Auto, *">
                                    <StackPanel Grid.Row="0" Spacing="16">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <TextBlock Text="RECORDS IN" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding SelectedPersonnelTab}" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="Bold"/>
                                    </StackPanel>
                                    </StackPanel>
                                    
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                                        <StackPanel>
                                            <ItemsControl ItemsSource="{Binding Directors}" IsVisible="{Binding SelectedPersonnelTab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Directors'}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:CompanyCharacter">
                                                        <Border Background="{DynamicResource DrawerHeaderBg}" CornerRadius="10" Padding="16,12" Margin="0,0,0,8" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1">
                                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                                <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentPrimary}" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            
                                            <ItemsControl ItemsSource="{Binding Secretaries}" IsVisible="{Binding SelectedPersonnelTab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Secretaries'}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:CompanyCharacter">
                                                        <Border Background="{DynamicResource DrawerHeaderBg}" CornerRadius="10" Padding="16,12" Margin="0,0,0,8" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1">
                                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                                <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentPrimary}" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            
                                            <ItemsControl ItemsSource="{Binding Shareholders}" IsVisible="{Binding SelectedPersonnelTab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Shareholders'}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:CompanyCharacter">
                                                        <Border Background="{DynamicResource DrawerHeaderBg}" CornerRadius="10" Padding="16,12" Margin="0,0,0,8" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1">
                                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                                <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentPrimary}" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            
                                            <ItemsControl ItemsSource="{Binding Others}" IsVisible="{Binding SelectedPersonnelTab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Others'}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:CompanyCharacter">
                                                        <Border Background="{DynamicResource DrawerHeaderBg}" CornerRadius="10" Padding="16,12" Margin="0,0,0,8" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1">
                                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                                <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentPrimary}" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>
                        </Border>
                        </Grid>

                        <!-- NIC Documents -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" SharedSizeGroup="BottomCardHeight"/>
                            </Grid.RowDefinitions>
                            <Border Classes="detail-card" Grid.Row="0">
                            <Grid RowDefinitions="Auto, Auto, *">
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,24">
                                    <i:Icon Value="fa-solid fa-file-contract" Foreground="{DynamicResource AccentPrimary}" FontSize="18"/>
                                    <TextBlock Text="NIC DOCUMENTS" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- NIC Tabs -->
                                <Border Grid.Row="1" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1" Margin="0,0,0,24">
                                    <StackPanel Orientation="Horizontal" Spacing="0">
                                        <Button Classes="tab-btn" Classes.selected="{Binding SelectedNicTab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Directors'}" Command="{Binding SelectNicTabCommand}" CommandParameter="Directors">
                                            <TextBlock Text="Directors"/>
                                        </Button>
                                        <Button Classes="tab-btn" Classes.selected="{Binding SelectedNicTab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Secretaries'}" Command="{Binding SelectNicTabCommand}" CommandParameter="Secretaries">
                                            <TextBlock Text="Secretaries"/>
                                        </Button>
                                        <Button Classes="tab-btn" Classes.selected="{Binding SelectedNicTab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Shareholders'}" Command="{Binding SelectNicTabCommand}" CommandParameter="Shareholders">
                                            <TextBlock Text="Shareholders"/>
                                        </Button>
                                        <Button Classes="tab-btn" Classes.selected="{Binding SelectedNicTab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Others'}" Command="{Binding SelectNicTabCommand}" CommandParameter="Others">
                                            <TextBlock Text="Others"/>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Tab Content (NICs) -->
                                <Grid Grid.Row="2" RowDefinitions="Auto, *">
                                    <StackPanel Grid.Row="0" Spacing="16">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <TextBlock Text="FILES IN" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding SelectedNicTab}" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="Bold"/>
                                    </StackPanel>
                                    
                                    <TextBlock Text="No NIC documents uploaded." Foreground="{DynamicResource TextFaint}" FontStyle="Italic" HorizontalAlignment="Center" Margin="0,20" IsVisible="{Binding !FilteredNicDocuments.Count}"/>
                                    
                                    </StackPanel>
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                                        <ItemsControl ItemsSource="{Binding FilteredNicDocuments}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:AppDocument">
                                                    <Border Classes="document-item" Background="{DynamicResource DrawerHeaderBg}" CornerRadius="10" Padding="16,12" Margin="0,0,0,8" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1">
                                                        <Grid ColumnDefinitions="Auto, *, Auto">
                                                            <i:Icon Value="fa-solid fa-file-pdf" Foreground="{DynamicResource AccentPrimary}" FontSize="20" Margin="0,0,16,0"/>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding FileName}" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                                                <TextBlock Text="{Binding FileSize}" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                                            </StackPanel>
                                                            
                                                            <!-- Actions -->
                                                            <StackPanel Grid.Column="2" Classes="action-icons" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                                <Button Classes="icon-action-btn" Command="{Binding $parent[UserControl].((vm:CompanyRegistrationDetailViewModel)DataContext).PreviewDocumentCommand}" CommandParameter="{Binding}">
                                                                    <i:Icon Value="fa-solid fa-eye" Foreground="{DynamicResource TextSecondary}"/>
                                                                </Button>
                                                                <Button Classes="icon-action-btn" Command="{Binding $parent[UserControl].((vm:CompanyRegistrationDetailViewModel)DataContext).DownloadDocumentCommand}" CommandParameter="{Binding}">
                                                                    <i:Icon Value="fa-solid fa-download" Foreground="{DynamicResource TextSecondary}"/>
                                                                </Button>
                                                                <Button Classes="icon-action-btn" Command="{Binding $parent[UserControl].((vm:CompanyRegistrationDetailViewModel)DataContext).DeleteDocumentCommand}" CommandParameter="{Binding}">
                                                                    <i:Icon Value="fa-solid fa-trash-can" Foreground="{DynamicResource StatusDanger}"/>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>
                        </Border>
                        </Grid>
                    </StackPanel>

                    <!-- Right Column: TIN Registration -->
                    <StackPanel Grid.Row="2" Grid.Column="2" Spacing="32">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" SharedSizeGroup="TopCardHeight"/>
                            </Grid.RowDefinitions>
                            <Border Classes="detail-card" Grid.Row="0">
                        <Grid RowDefinitions="Auto, Auto, *">
                            <!-- TIN Header -->
                            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,24">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                    <i:Icon Value="fa-solid fa-file-signature" Foreground="{DynamicResource AccentPrimary}" FontSize="18"/>
                                    <TextBlock Text="TIN REGISTRATION" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button Name="AddRegistrationButton" Grid.Column="1" Classes="btn-primary" Background="{DynamicResource AccentPrimary}" Padding="12,6" Command="{Binding AddRegistrationCommand}" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <i:Icon Value="fa-solid fa-plus" FontSize="12" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="Add Record" FontSize="12" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- TIN Tabs -->
                            <Border Grid.Row="1" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1" Margin="0,0,0,24">
                                <StackPanel Orientation="Horizontal" Spacing="0">
                                    <Button Classes="tab-btn" Classes.selected="{Binding SelectedTinTab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='PROCESS'}" Command="{Binding SelectTinTabCommand}" CommandParameter="PROCESS">
                                        <TextBlock Text="PROCESS"/>
                                    </Button>
                                    <Button Classes="tab-btn" Classes.selected="{Binding SelectedTinTab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='APPROVED'}" Command="{Binding SelectTinTabCommand}" CommandParameter="APPROVED">
                                        <TextBlock Text="APPROVED"/>
                                    </Button>
                                    <Button Classes="tab-btn" Classes.selected="{Binding SelectedTinTab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='PIN'}" Command="{Binding SelectTinTabCommand}" CommandParameter="PIN">
                                        <TextBlock Text="PIN"/>
                                    </Button>
                                    <Button Classes="tab-btn" Classes.selected="{Binding SelectedTinTab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='SSID'}" Command="{Binding SelectTinTabCommand}" CommandParameter="SSID">
                                        <TextBlock Text="SSID"/>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Tab Content (Files) -->
                            <Grid Grid.Row="2" RowDefinitions="Auto, *">
                                <StackPanel Grid.Row="0" Spacing="16">
                                <Grid ColumnDefinitions="*, Auto">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <TextBlock Text="FILES IN" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding SelectedTinTab}" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="Bold"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="footer-link" Command="{Binding OpenViewAllTinRecordsCommand}" Padding="0">
                                        <TextBlock Text="VIEW ALL" Foreground="{DynamicResource AccentPrimary}" FontSize="12" FontWeight="Bold"/>
                                    </Button>
                                </Grid>
                                
                                <TextBlock Text="No documents uploaded." Foreground="{DynamicResource TextFaint}" FontStyle="Italic" HorizontalAlignment="Center" Margin="0,20" IsVisible="{Binding !FilteredTinFiles.Count}"/>
                                </StackPanel>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                                <ItemsControl ItemsSource="{Binding FilteredTinFiles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:AppDocument">
                                            <Border Classes="document-item" Background="{DynamicResource DrawerHeaderBg}" CornerRadius="10" Padding="16,12" Margin="0,0,0,8" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1">
                                                <Grid ColumnDefinitions="Auto, *, Auto">
                                                    <i:Icon Value="fa-solid fa-file-pdf" Foreground="{DynamicResource AccentPrimary}" FontSize="20" Margin="0,0,16,0"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FileName}" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="{Binding FileSize}" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                                            <TextBlock Text="Ã¢â‚¬Â¢" Foreground="{DynamicResource TextFaint}" FontSize="11"/>
                                                            <TextBlock Text="{Binding Type}" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- Hover Actions -->
                                                    <StackPanel Grid.Column="2" Classes="action-icons" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <Button Classes="icon-action-btn" Command="{Binding $parent[UserControl].((vm:CompanyRegistrationDetailViewModel)DataContext).ViewTinRecordCommand}" CommandParameter="{Binding}">
                                                            <i:Icon Value="fa-solid fa-eye" Foreground="{DynamicResource TextSecondary}"/>
                                                        </Button>
                                                        <Button Classes="icon-action-btn" Command="{Binding $parent[UserControl].((vm:CompanyRegistrationDetailViewModel)DataContext).EditTinRecordCommand}" CommandParameter="{Binding}">
                                                            <i:Icon Value="fa-solid fa-pen" Foreground="{DynamicResource TextSecondary}"/>
                                                        </Button>
                                                        <Button Classes="icon-action-btn" Command="{Binding $parent[UserControl].((vm:CompanyRegistrationDetailViewModel)DataContext).DeleteDocumentCommand}" CommandParameter="{Binding}">
                                                            <i:Icon Value="fa-solid fa-trash-can" Foreground="{DynamicResource StatusDanger}"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Border>
                    </Grid>
                    <!-- ATTACHMENTS -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" SharedSizeGroup="MiddleCardHeight"/>
                        </Grid.RowDefinitions>
                        <Border Classes="detail-card" Grid.Row="0">
                        <Grid RowDefinitions="Auto, Auto, *">
                            <!-- Attachments Header -->
                            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,24">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                    <i:Icon Value="fa-solid fa-paperclip" Foreground="{DynamicResource AccentPrimary}" FontSize="18"/>
                                    <TextBlock Text="ATTACHMENTS" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- Attachments Tabs -->
                            <Border Grid.Row="1" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1" Margin="0,0,0,24">
                                <StackPanel Orientation="Horizontal" Spacing="0">
                                    <Button Classes="tab-btn" Classes.selected="{Binding SelectedAttachmentTab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Form 01'}" Command="{Binding SelectAttachmentTabCommand}" CommandParameter="Form 01">
                                        <TextBlock Text="Form 01"/>
                                    </Button>
                                    <Button Classes="tab-btn" Classes.selected="{Binding SelectedAttachmentTab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='BO Form'}" Command="{Binding SelectAttachmentTabCommand}" CommandParameter="BO Form">
                                        <TextBlock Text="BO Form"/>
                                    </Button>
                                    <Button Classes="tab-btn" Classes.selected="{Binding SelectedAttachmentTab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Form 05'}" Command="{Binding SelectAttachmentTabCommand}" CommandParameter="Form 05">
                                        <TextBlock Text="Form 05"/>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Tab Content (Files) -->
                            <Grid Grid.Row="2" RowDefinitions="Auto, *">
                                <StackPanel Grid.Row="0" Spacing="16">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock Text="FILES IN" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding SelectedAttachmentTab}" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="Bold"/>
                                </StackPanel>
                                
                                <TextBlock Text="No documents uploaded." Foreground="{DynamicResource TextFaint}" FontStyle="Italic" HorizontalAlignment="Center" Margin="0,20" IsVisible="{Binding !FilteredAttachmentFiles.Count}"/>
                                
                                <!-- BO Responsible Person Section -->
                                <Border Background="{DynamicResource InputBg}" CornerRadius="8" Padding="16,12" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" IsVisible="{Binding SelectedAttachmentTab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='BO Form'}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="BO RESPONSIBLE PERSON" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}"/>
                                        
                                        <TextBlock Text="{Binding BoResponsiblePersonName}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" IsVisible="{Binding BoResponsiblePersonName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        <TextBlock Text="Not Assigned" FontSize="14" FontStyle="Italic" Foreground="{DynamicResource TextFaint}" IsVisible="{Binding BoResponsiblePersonName, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
                                        
                                        <!-- BO Person NIC -->
                                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasBoPersonNic}" Margin="0,4,0,0">
                                            <i:Icon Value="fa-solid fa-id-card" Foreground="{DynamicResource AccentPrimary}" FontSize="14" VerticalAlignment="Center"/>
                                            <TextBlock Text="NIC Uploaded" FontSize="12" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                </StackPanel>
                                
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                                    <ItemsControl ItemsSource="{Binding FilteredAttachmentFiles}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:AppDocument">
                                                <Border Classes="document-item" Background="{DynamicResource DrawerHeaderBg}" CornerRadius="10" Padding="16,12" Margin="0,0,0,8" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1">
                                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                                        <i:Icon Value="fa-solid fa-file-pdf" Foreground="{DynamicResource AccentPrimary}" FontSize="20" Margin="0,0,16,0"/>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding FileName}" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <TextBlock Text="{Binding FileSize}" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                                                <TextBlock Text="Ã¢â‚¬Â¢" Foreground="{DynamicResource TextFaint}" FontSize="11"/>
                                                                <TextBlock Text="{Binding Category}" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <!-- Hover Actions -->
                                                        <StackPanel Grid.Column="2" Classes="action-icons" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                            <Button Classes="icon-action-btn" Command="{Binding $parent[UserControl].((vm:CompanyRegistrationDetailViewModel)DataContext).PreviewDocumentCommand}" CommandParameter="{Binding}">
                                                                <i:Icon Value="fa-solid fa-eye" Foreground="{DynamicResource TextSecondary}"/>
                                                            </Button>
                                                            <Button Classes="icon-action-btn" Command="{Binding $parent[UserControl].((vm:CompanyRegistrationDetailViewModel)DataContext).DownloadDocumentCommand}" CommandParameter="{Binding}">
                                                                <i:Icon Value="fa-solid fa-download" Foreground="{DynamicResource TextSecondary}"/>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                </Grid>
                            </Grid>
                    </Border>
                    </Grid>

                    <!-- Registration Process Documents -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" SharedSizeGroup="BottomCardHeight"/>
                        </Grid.RowDefinitions>
                        <Border Classes="detail-card" Grid.Row="0">
                        <Grid RowDefinitions="Auto, Auto, *">
                            <!-- Header -->
                            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,24">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                    <i:Icon Value="fa-solid fa-folder-open" Foreground="{DynamicResource AccentPrimary}" FontSize="18"/>
                                    <TextBlock Text="REGISTRATION PROCESS DOCUMENTS" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- Tabs -->
                            <Border Grid.Row="1" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1" Margin="0,0,0,24">
                                <StackPanel Orientation="Horizontal" Spacing="0">
                                    <Button Classes="tab-btn" Classes.selected="{Binding SelectedProcessDocumentsCardTab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Name Approval'}" Command="{Binding SelectProcessDocumentsCardTabCommand}" CommandParameter="Name Approval">
                                        <TextBlock Text="Name Approval"/>
                                    </Button>
                                    <Button Classes="tab-btn" Classes.selected="{Binding SelectedProcessDocumentsCardTab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Signature'}" Command="{Binding SelectProcessDocumentsCardTabCommand}" CommandParameter="Signature">
                                        <TextBlock Text="Signature"/>
                                    </Button>
                                    <Button Classes="tab-btn" Classes.selected="{Binding SelectedProcessDocumentsCardTab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Incorporation'}" Command="{Binding SelectProcessDocumentsCardTabCommand}" CommandParameter="Incorporation">
                                        <TextBlock Text="Incorporation"/>
                                    </Button>
                                    <Button Classes="tab-btn" Classes.selected="{Binding SelectedProcessDocumentsCardTab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Certified Copies'}" Command="{Binding SelectProcessDocumentsCardTabCommand}" CommandParameter="Certified Copies">
                                        <TextBlock Text="Certified Copies"/>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Tab Content (Files) -->
                            <Grid Grid.Row="2" RowDefinitions="Auto, *">
                                <StackPanel Grid.Row="0" Spacing="16">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock Text="RECORDS IN" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding SelectedProcessDocumentsCardTab}" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="Bold"/>
                                </StackPanel>
                                
                                <TextBlock Text="No documents found." Foreground="{DynamicResource TextFaint}" FontStyle="Italic" HorizontalAlignment="Center" Margin="0,20" IsVisible="{Binding !FilteredProcessCardDocuments.Count}"/>
                                </StackPanel>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                                    <ItemsControl ItemsSource="{Binding FilteredProcessCardDocuments}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:AppDocument">
                                                <Border Classes="document-item" Background="{DynamicResource DrawerHeaderBg}" CornerRadius="10" Padding="16,12" Margin="0,0,0,8" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1">
                                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                                        <i:Icon Value="fa-solid fa-file-pdf" Foreground="{DynamicResource AccentPrimary}" FontSize="20" Margin="0,0,16,0"/>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding FileName}" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <TextBlock Text="{Binding FileSize}" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                                                <TextBlock Text="â€¢" Foreground="{DynamicResource TextFaint}" FontSize="11"/>
                                                                <TextBlock Text="{Binding Type}" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <!-- Hover Actions -->
                                                        <StackPanel Grid.Column="2" Classes="action-icons" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                            <Button Classes="icon-action-btn" Command="{Binding $parent[UserControl].((vm:CompanyRegistrationDetailViewModel)DataContext).PreviewProcessDocumentCommand}" CommandParameter="{Binding}">
                                                                <i:Icon Value="fa-solid fa-eye" Foreground="{DynamicResource TextSecondary}"/>
                                                            </Button>
                                                            <Button Classes="icon-action-btn" Command="{Binding $parent[UserControl].((vm:CompanyRegistrationDetailViewModel)DataContext).RemoveProcessDocumentCommand}" CommandParameter="{Binding}">
                                                                <i:Icon Value="fa-solid fa-trash-can" Foreground="{DynamicResource StatusDanger}"/>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                </Grid>
                            </Grid>
                    </Border>
                    </Grid>
                </StackPanel>
                </Grid>

                <!-- Footer Actions -->
                <Grid Grid.Row="4" ColumnDefinitions="Auto, *, Auto" VerticalAlignment="Bottom" Margin="0,40,0,0">
                    <Button Grid.Column="0" Classes="footer-link" Command="{Binding OpenGuideCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <i:Icon Value="fa-solid fa-circle-question" Foreground="{DynamicResource TextSecondary}" FontSize="16"/>
                            <TextBlock Text="Learn more about Company Registration" Foreground="{DynamicResource TextSecondary}" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16">
                        <Button Name="EditRecordButton" Content="Edit" Classes="btn-edit" Width="140" Command="{Binding EditRecordCommand}"/>
                        <Button Name="DeleteRecordButton" Content="Delete" Classes="btn-delete" Width="140" Command="{Binding DeleteRecordCommand}"/>
                    </StackPanel>
                </Grid>
            
                            </Grid></ScrollViewer>

        <!-- TIN REGISTRATION UPLOAD POPUP -->
        <Border ZIndex="5" IsVisible="{Binding IsRegistrationPopupVisible}" Background="{DynamicResource OverlayBg}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" PointerPressed="Overlay_PointerPressed">
            <Border Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" CornerRadius="12" Width="640" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="0" BoxShadow="0 20 60 0 #66000000">
                <Grid RowDefinitions="Auto, *, Auto">
                    <!-- Popup Header -->
                    <Border Grid.Row="0" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="0,0,0,1" Padding="32,24">
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16">
                                <i:Icon Value="fa-solid fa-file-lines" Foreground="{DynamicResource AccentPrimary}" FontSize="20"/>
                                <TextBlock Text="TIN REGISTRATION UPLOAD" Foreground="{DynamicResource TextPrimary}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Grid.Column="2" Classes="footer-link" Command="{Binding CloseRegistrationPopupCommand}" VerticalAlignment="Center">
                                <i:Icon Value="fa-solid fa-xmark" Foreground="{DynamicResource TextSecondary}" FontSize="20"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Popup Content -->
                    <ScrollViewer Grid.Row="1" MaxHeight="600">
                        <Border Padding="32">
                            <StackPanel Spacing="32">
                            <!-- Section: Added Files -->
                            <StackPanel Spacing="16">
                                <TextBlock Text="{Binding TempUploadFiles.Count, StringFormat='{}ADDED FILES ({0})'}" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="Bold"/>
                                <ItemsControl ItemsSource="{Binding TempUploadFiles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:AppDocument">
                                            <Border Classes="file-item-card" Margin="0,0,0,8">
                                                <Grid ColumnDefinitions="Auto, *, Auto, Auto, Auto">
                                                    <i:Icon Grid.Column="0" Value="fa-solid fa-file-pdf" Foreground="{DynamicResource AccentPrimary}" FontSize="20" Margin="0,0,16,0"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FileName}" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="{Binding IsExisting, Converter={StaticResource BooleanToStringConverter}, ConverterParameter='Existing|New'}" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                                            <TextBlock Text="Ã¢â‚¬Â¢" Foreground="{DynamicResource TextFaint}" FontSize="11"/>
                                                            <TextBlock Text="{Binding Description, FallbackValue='No Desc'}" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    
                                                    <Border Grid.Column="2" Background="{DynamicResource HoverBg}" CornerRadius="4" Padding="8,4" Margin="0,0,16,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Category}" Foreground="{DynamicResource TextSecondary}" FontSize="10" FontWeight="Bold"/>
                                                    </Border>

                                                    <Button Grid.Column="3" Classes="icon-action-btn" Command="{Binding $parent[UserControl].((vm:CompanyRegistrationDetailViewModel)DataContext).EditTempFileCommand}" CommandParameter="{Binding}">
                                                        <i:Icon Value="fa-solid fa-pen-to-square" Foreground="{DynamicResource TextSecondary}"/>
                                                    </Button>
                                                    <Button Grid.Column="4" Classes="icon-action-btn" Command="{Binding $parent[UserControl].((vm:CompanyRegistrationDetailViewModel)DataContext).RemoveTempFileCommand}" CommandParameter="{Binding}">
                                                        <i:Icon Value="fa-solid fa-trash-can" Foreground="{DynamicResource StatusDanger}"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <!-- Section: Upload Area / Editing Form -->
                            <Panel>
                                <!-- Form for metadata -->
                                <Border Background="{DynamicResource DrawerHeaderBg}" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" CornerRadius="12" Padding="24">
                                    <StackPanel Spacing="24">
                                        <!-- Metadata Form -->
                                        <StackPanel Spacing="16">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="CATEGORY" Classes="card-label"/>
                                                <ComboBox ItemsSource="{Binding AvailableCategories}" SelectedItem="{Binding SelectedUploadFile.Category}" HorizontalAlignment="Stretch" Classes="popup-input"/>
                                            </StackPanel>
                                            
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="TYPE" Classes="card-label"/>
                                                <TextBox Watermark="e.g. Application Form" Text="{Binding SelectedUploadFile.Type}" Classes="popup-input"/>
                                            </StackPanel>
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="DESCRIPTION" Classes="card-label"/>
                                                <TextBox Watermark="Add a description..." Text="{Binding SelectedUploadFile.Description}" Height="80" TextWrapping="Wrap" AcceptsReturn="True" Classes="popup-input"/>
                                            </StackPanel>

                                            <!-- Optional Document Upload -->
                                            <StackPanel Spacing="8" Margin="0,8,0,0">
                                                <TextBlock Text="ATTACHMENT (OPTIONAL)" Classes="card-label"/>
                                                
                                                <!-- Shows when NO document is attached -->
                                                <Button Classes="footer-link" Command="{Binding PickRegistrationFileCommand}" HorizontalAlignment="Left" IsVisible="{Binding SelectedUploadFile.FileName, Converter={x:Static StringConverters.IsNullOrEmpty}}">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <i:Icon Value="fa-solid fa-plus" Foreground="{DynamicResource AccentPrimary}" FontSize="14"/>
                                                        <TextBlock Text="Add Document" Foreground="{DynamicResource AccentPrimary}" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Button>

                                                <!-- Shows when document IS attached -->
                                                <Border Background="{DynamicResource HoverBg}" CornerRadius="8" Padding="16,12" IsVisible="{Binding SelectedUploadFile.FileName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                    <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                                                        <i:Icon Value="fa-solid fa-check-circle" Foreground="{DynamicResource StatusSuccess}" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding SelectedUploadFile.FileName}" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" FontSize="13"/>
                                                            <TextBlock Text="{Binding SelectedUploadFile.FileSize}" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="2" Content="Change" Foreground="{DynamicResource AccentPrimary}" Background="Transparent" Command="{Binding PickRegistrationFileCommand}" FontSize="12" Margin="0,0,12,0"/>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                        
                                        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                                            <Button Content="Cancel" Command="{Binding CancelPickCommand}" Background="Transparent" Foreground="{DynamicResource TextSecondary}"/>
                                            <Button Name="ConfirmUploadedFileButton" Content="Confirm" Command="{Binding ConfirmSelectedFileCommand}" Classes="btn-primary" Background="{DynamicResource AccentPrimary}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Panel>
                        </StackPanel>
                        </Border>
                    </ScrollViewer>
 
                    <!-- Popup Footer -->
                    <Border Grid.Row="2" Padding="32,24" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="0,1,0,0">
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <Button Grid.Column="0" Content="Cancel" Command="{Binding CloseRegistrationPopupCommand}" Foreground="{DynamicResource TextSecondary}" Background="Transparent"/>
                            <TextBlock Grid.Column="1" Text="{Binding TempUploadFiles.Count, StringFormat='{}{0} file(s) to save'}" Foreground="{DynamicResource TextMuted}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0"/>
                            <Button Name="SaveUploadsButton" Grid.Column="2" Content="Save &amp; Close" Command="{Binding SaveUploadsCommand}" Classes="btn-primary" Background="{DynamicResource AccentPrimary}" Padding="20,10"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Border>

        <!-- TIN REGISTRATION VIEW ALL POPUP -->
        <Border ZIndex="5" IsVisible="{Binding IsViewAllTinRecordsPopupVisible}" Background="{DynamicResource OverlayBg}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" PointerPressed="Overlay_PointerPressed">
            <Border Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" CornerRadius="12" Width="600" MaxHeight="600" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="0" BoxShadow="0 20 60 0 #66000000">
                <Grid RowDefinitions="Auto, *">
                    <!-- Popup Header -->
                    <Border Grid.Row="0" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="0,0,0,1" Padding="32,24">
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16">
                                <i:Icon Value="fa-solid fa-list" Foreground="{DynamicResource AccentPrimary}" FontSize="20"/>
                                <TextBlock Text="ALL RECORDS" Foreground="{DynamicResource TextPrimary}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Grid.Column="2" Classes="footer-link" Command="{Binding CloseViewAllTinRecordsCommand}" VerticalAlignment="Center">
                                <i:Icon Value="fa-solid fa-xmark" Foreground="{DynamicResource TextSecondary}" FontSize="20"/>
                            </Button>
                        </Grid>
                    </Border>
                    <!-- Popup Content -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <Border Padding="32">
                            <StackPanel Spacing="16">
                                <TextBlock Text="No documents found." Foreground="{DynamicResource TextFaint}" FontStyle="Italic" HorizontalAlignment="Center" Margin="0,20" IsVisible="{Binding !FilteredTinFiles.Count}"/>
                                <ItemsControl ItemsSource="{Binding FilteredTinFiles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:AppDocument">
                                            <Button Background="Transparent" BorderThickness="0" Padding="0" Command="{Binding $parent[UserControl].((vm:CompanyRegistrationDetailViewModel)DataContext).ViewTinRecordCommand}" CommandParameter="{Binding}" HorizontalAlignment="Stretch" Cursor="Hand">
                                                <Border Classes="document-item" Background="{DynamicResource DrawerHeaderBg}" CornerRadius="10" Padding="16,12" Margin="0,0,0,8" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" HorizontalAlignment="Stretch">
                                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                                        <i:Icon Value="fa-solid fa-file-pdf" Foreground="{DynamicResource AccentPrimary}" FontSize="20" Margin="0,0,16,0"/>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                            <TextBlock Text="{Binding FileName}" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <TextBlock Text="{Binding FileSize}" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                                                <TextBlock Text="â€¢" Foreground="{DynamicResource TextFaint}" FontSize="11"/>
                                                                <TextBlock Text="{Binding Type}" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <i:Icon Grid.Column="2" Value="fa-solid fa-chevron-right" Foreground="{DynamicResource TextMuted}" FontSize="14" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Border>

        <!-- TIN RECORD DETAILS POPUP -->
        <Border ZIndex="5" IsVisible="{Binding IsTinRecordDetailsVisible}" Background="{DynamicResource OverlayBg}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" PointerPressed="Overlay_PointerPressed">
            <Border Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" CornerRadius="12" Width="600" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="0" BoxShadow="0 20 60 0 #66000000">
                <Grid RowDefinitions="Auto, *, Auto">
                    <!-- Popup Header -->
                    <Border Grid.Row="0" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="0,0,0,1" Padding="32,24">
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16">
                                <i:Icon Value="fa-solid fa-file-lines" Foreground="{DynamicResource AccentPrimary}" FontSize="20"/>
                                <TextBlock Text="RECORD DETAILS" Foreground="{DynamicResource TextPrimary}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Grid.Column="2" Classes="footer-link" Command="{Binding CloseTinRecordDetailsCommand}" VerticalAlignment="Center">
                                <i:Icon Value="fa-solid fa-xmark" Foreground="{DynamicResource TextSecondary}" FontSize="20"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Popup Content -->
                    <ScrollViewer Grid.Row="1" MaxHeight="500">
                        <Border Padding="32">
                            <StackPanel Spacing="24">
                                <!-- Read-Only Data Section -->
                                <StackPanel Spacing="16" IsVisible="{Binding !IsTinRecordEditMode}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="CATEGORY" Classes="card-label"/>
                                        <TextBlock Text="{Binding PreviewingTinRecord.Category, TargetNullValue=''}" Foreground="{DynamicResource TextPrimary}" FontSize="14" IsVisible="{Binding PreviewingTinRecord.Category, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        <TextBlock Text="No category specified" Foreground="{DynamicResource TextMuted}" FontSize="14" Opacity="0.5" IsVisible="{Binding PreviewingTinRecord.Category, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
                                    </StackPanel>
                                    
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="TYPE" Classes="card-label"/>
                                        <TextBlock Text="{Binding PreviewingTinRecord.Type, TargetNullValue=''}" Foreground="{DynamicResource TextPrimary}" FontSize="14" IsVisible="{Binding PreviewingTinRecord.Type, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        <TextBlock Text="No type specified" Foreground="{DynamicResource TextMuted}" FontSize="14" Opacity="0.5" IsVisible="{Binding PreviewingTinRecord.Type, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
                                    </StackPanel>

                                    <StackPanel Spacing="8">
                                        <TextBlock Text="DESCRIPTION" Classes="card-label"/>
                                        <TextBlock Text="{Binding PreviewingTinRecord.Description, TargetNullValue=''}" Foreground="{DynamicResource TextPrimary}" FontSize="14" TextWrapping="Wrap" IsVisible="{Binding PreviewingTinRecord.Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        <TextBlock Text="No description provided" Foreground="{DynamicResource TextMuted}" FontSize="14" Opacity="0.5" IsVisible="{Binding PreviewingTinRecord.Description, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Edit Mode Data Section -->
                                <StackPanel Spacing="16" IsVisible="{Binding IsTinRecordEditMode}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="CATEGORY" Classes="card-label"/>
                                        <ComboBox ItemsSource="{Binding AvailableCategories}" SelectedItem="{Binding EditingTinRecord.Category}" HorizontalAlignment="Stretch" Classes="popup-input"/>
                                    </StackPanel>
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="TYPE" Classes="card-label"/>
                                        <TextBox Watermark="e.g. Application Form" Text="{Binding EditingTinRecord.Type}" Classes="popup-input"/>
                                    </StackPanel>
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="DESCRIPTION" Classes="card-label"/>
                                        <TextBox Watermark="Add a description..." Text="{Binding EditingTinRecord.Description}" Height="80" TextWrapping="Wrap" AcceptsReturn="True" Classes="popup-input"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Read-Only Uploaded Document Section -->
                                <StackPanel Spacing="8" Margin="0,8,0,0" IsVisible="{Binding !IsTinRecordEditMode}">
                                    <TextBlock Text="ATTACHED DOCUMENT" Classes="card-label"/>
                                    <Border Background="{DynamicResource HoverBg}" CornerRadius="8" Padding="16,12" IsVisible="{Binding PreviewingTinRecord.FileName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <Grid ColumnDefinitions="Auto, *, Auto">
                                            <i:Icon Grid.Column="0" Value="fa-solid fa-file-pdf" Foreground="{DynamicResource AccentPrimary}" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding PreviewingTinRecord.FileName}" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" FontSize="13"/>
                                                <TextBlock Text="{Binding PreviewingTinRecord.FileSize}" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Classes="action-icons" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Button Classes="icon-action-btn" Command="{Binding PreviewDocumentCommand}" CommandParameter="{Binding PreviewingTinRecord}">
                                                    <i:Icon Value="fa-solid fa-eye" Foreground="{DynamicResource TextSecondary}"/>
                                                </Button>
                                                <Button Classes="icon-action-btn" Command="{Binding DownloadDocumentCommand}" CommandParameter="{Binding PreviewingTinRecord}">
                                                    <i:Icon Value="fa-solid fa-download" Foreground="{DynamicResource TextSecondary}"/>
                                                </Button>
                                                <Button Classes="icon-action-btn" Command="{Binding EditDocumentCommand}" CommandParameter="{Binding PreviewingTinRecord}">
                                                    <i:Icon Value="fa-solid fa-pen" Foreground="{DynamicResource TextSecondary}"/>
                                                </Button>
                                                <Button Classes="icon-action-btn" Command="{Binding DeleteDocumentCommand}" CommandParameter="{Binding PreviewingTinRecord}">
                                                    <i:Icon Value="fa-solid fa-trash-can" Foreground="{DynamicResource StatusDanger}"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="No document attached" Foreground="{DynamicResource TextMuted}" FontSize="14" Opacity="0.5" IsVisible="{Binding PreviewingTinRecord.FileName, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
                                </StackPanel>

                                <!-- Edit Mode Document Section -->
                                <StackPanel Spacing="8" Margin="0,8,0,0" IsVisible="{Binding IsTinRecordEditMode}">
                                    <TextBlock Text="ATTACHMENT" Classes="card-label"/>
                                    
                                    <!-- Add Document Button (when empty) -->
                                    <Button Classes="footer-link" Command="{Binding PickEditingTinFileCommand}" HorizontalAlignment="Left" IsVisible="{Binding EditingTinRecord.FileName, Converter={x:Static StringConverters.IsNullOrEmpty}}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <i:Icon Value="fa-solid fa-plus" Foreground="{DynamicResource AccentPrimary}" FontSize="14"/>
                                            <TextBlock Text="Add Document(s)" Foreground="{DynamicResource AccentPrimary}" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Main Attachment File -->
                                    <Border Background="{DynamicResource HoverBg}" CornerRadius="8" Padding="16,12" IsVisible="{Binding EditingTinRecord.FileName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                                            <i:Icon Value="fa-solid fa-check-circle" Foreground="{DynamicResource StatusSuccess}" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding EditingTinRecord.FileName}" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" FontSize="13"/>
                                                <TextBlock Text="{Binding EditingTinRecord.FileSize}" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="Replace" Foreground="{DynamicResource AccentPrimary}" Background="Transparent" Command="{Binding PickEditingTinFileCommand}" FontSize="12" Margin="0,0,12,0"/>
                                            <Button Grid.Column="3" Content="Delete" Foreground="{DynamicResource StatusDanger}" Background="Transparent" Command="{Binding RemoveEditingTinFileCommand}" FontSize="12"/>
                                        </Grid>
                                    </Border>
                                    
                                    <!-- Additional Attachments -->
                                    <ItemsControl ItemsSource="{Binding AdditionalEditingFiles}" Margin="0,8,0,0" IsVisible="{Binding AdditionalEditingFiles.Count, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource HoverBg}" CornerRadius="8" Padding="16,12" Margin="0,4,0,0">
                                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                                        <i:Icon Value="fa-solid fa-check-circle" Foreground="{DynamicResource StatusSuccess}" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding FileName}" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" FontSize="13"/>
                                                            <TextBlock Text="{Binding FileSize}" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="2" Classes="icon-action-btn" Command="{Binding $parent[UserControl].((vm:CompanyRegistrationDetailViewModel)DataContext).RemoveAdditionalEditingFileCommand}" CommandParameter="{Binding}">
                                                            <i:Icon Value="fa-solid fa-trash-can" Foreground="{DynamicResource StatusDanger}"/>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Classes="footer-link" Command="{Binding PickEditingTinFileCommand}" HorizontalAlignment="Left" IsVisible="{Binding EditingTinRecord.FileName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Margin="0,8,0,0">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <i:Icon Value="fa-solid fa-plus" Foreground="{DynamicResource AccentPrimary}" FontSize="14"/>
                                            <TextBlock Text="Upload More Documents" Foreground="{DynamicResource AccentPrimary}" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
 
                    <!-- Popup Footer -->
                    <Border Grid.Row="2" Padding="32,24" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="0,1,0,0">
                        <Panel>
                            <!-- Read-Only Actions -->
                            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" IsVisible="{Binding !IsTinRecordEditMode}">
                                <Button Content="Delete" Classes="btn-delete" />
                                <Button Content="Edit" Command="{Binding EditTinRecordCommand}" CommandParameter="{Binding PreviewingTinRecord}" Classes="btn-primary" Background="{DynamicResource AccentPrimary}"/>
                            </StackPanel>
                            <!-- Edit Actions -->
                            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" IsVisible="{Binding IsTinRecordEditMode}">
                                <Button Content="Cancel" Command="{Binding CancelTinRecordEditCommand}" Foreground="{DynamicResource TextSecondary}" Background="Transparent"/>
                                <Button Content="Save Changes" Command="{Binding SaveTinRecordEditCommand}" Classes="btn-primary" Background="{DynamicResource AccentPrimary}"/>
                            </StackPanel>
                        </Panel>
                    </Border>
                </Grid>
            </Border>
        </Border>

        <!-- PREVIEW POPUP -->
        <Border ZIndex="10" IsVisible="{Binding IsPreviewVisible}" Classes="premium-modal-overlay" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" PointerPressed="Overlay_PointerPressed">
            <Border Classes="premium-modal-content" Width="900" Height="700" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="0">
                <Grid RowDefinitions="Auto, *, Auto">
                    <!-- Preview Header -->
                    <Border Grid.Row="0" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="0,0,0,1" Padding="24,16">
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0" Text="{Binding PreviewingFile.FileName, StringFormat='{}Preview: {0}'}" Foreground="{DynamicResource TextPrimary}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Classes="footer-link" Command="{Binding ClosePreviewCommand}" VerticalAlignment="Center">
                                <i:Icon Value="fa-solid fa-xmark" Foreground="{DynamicResource TextSecondary}" FontSize="20"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Preview Body -->
                    <Border Grid.Row="1" Background="{DynamicResource DrawerHeaderBg}" Margin="24">
                        <Panel>
                            <!-- Actual Image -->
                            <Image Source="{Binding PreviewImage}" Stretch="Uniform" Margin="20"/>
                            
                            <!-- Fallback/Overlay if error -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" IsVisible="{Binding PreviewImage, Converter={x:Static ObjectConverters.IsNull}}">
                                <i:Icon Value="fa-solid fa-file-circle-exclamation" FontSize="48" Foreground="{DynamicResource TextFaint}"/>
                                <TextBlock Text="Unable to load preview." Foreground="{DynamicResource TextMuted}"/>
                            </StackPanel>
                        </Panel>
                    </Border>

                    <!-- Preview Footer -->
                    <Border Grid.Row="2" Padding="24,16" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="0,1,0,0">
                        <Button HorizontalAlignment="Right" Content="Close" Command="{Binding ClosePreviewCommand}" Classes="btn-secondary" Padding="32,10"/>
                    </Border>
                </Grid>
            </Border>
        </Border>

        <!-- GLOBAL EDIT POPUP -->
        <Border ZIndex="10" IsVisible="{Binding IsGlobalEditVisible}" Classes="premium-modal-overlay" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" PointerPressed="Overlay_PointerPressed">
            <Border Classes="premium-modal-content" Width="500" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel Spacing="32">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Edit Document" Foreground="{DynamicResource TextPrimary}" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="Update the document metadata below." Foreground="{DynamicResource TextSecondary}" FontSize="14"/>
                    </StackPanel>

                    <StackPanel Spacing="24" IsVisible="{Binding EditingDocument, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="FILE NAME" Classes="card-label"/>
                            <TextBox Text="{Binding EditingDocument.FileName}" Classes="popup-input"/>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="CATEGORY" Classes="card-label"/>
                            <ComboBox ItemsSource="{Binding AvailableCategories}" SelectedItem="{Binding EditingDocument.Category}" HorizontalAlignment="Stretch" Classes="popup-input"/>
                        </StackPanel>
                        
                        <StackPanel Spacing="8">
                            <TextBlock Text="TYPE" Classes="card-label"/>
                            <TextBox Text="{Binding EditingDocument.Type}" Watermark="e.g. NIC Copy" Classes="popup-input"/>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="DESCRIPTION" Classes="card-label"/>
                            <TextBox Text="{Binding EditingDocument.Description}" Height="80" TextWrapping="Wrap" AcceptsReturn="True" Classes="popup-input"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                        <Button Content="Cancel" Command="{Binding CloseGlobalEditCommand}" Foreground="{DynamicResource TextSecondary}" Background="Transparent"/>
                        <Button Content="Save Changes" Command="{Binding SaveGlobalEditCommand}" Classes="btn-primary" Background="{DynamicResource AccentPrimary}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Reuse DetailViewModelBase Overlays -->
        <!-- Logic for Confirmation Dialog & Guide should be identical to AuditAssuranceDetailView -->
        
        <!-- Instruction Guide Popup (Global Style Sync) -->
        <Border ZIndex="4000" IsVisible="{Binding IsGuideVisible}" helpers:GuideHelper.EnableOutsideClickClose="True" Background="{DynamicResource OverlayBg}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="-30">
             <Border Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" CornerRadius="12" Width="600" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="30" BoxShadow="0 8 32 0 #66000000">
                <StackPanel Spacing="25">
                    <!-- Header -->
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <i:Icon Value="fa-regular fa-circle-question" FontSize="20" Foreground="{DynamicResource TextHeading}"/>
                            <TextBlock Text="Guide: Company Registration Details" Foreground="{DynamicResource TextHeading}" FontSize="20" FontWeight="Bold"/>
                        </StackPanel>
                        <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="5" Command="{Binding CloseGuideCommand}" Cursor="Hand">
                            <i:Icon Value="fa-solid fa-xmark" Foreground="{DynamicResource TextSecondary}" FontSize="18"/>
                        </Button>
                    </Grid>
                    
                    <TextBlock Text="Review and manage comprehensive information for this company registration record." Foreground="{DynamicResource TextSecondary}" FontSize="14" Margin="0,-10,0,10"/>

                    <!-- Features Grid -->
                    <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, *" Margin="0,0,0,10">
                        <!-- 1 -->
                        <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource GuideCardBg}" CornerRadius="8" Padding="15" Margin="0,0,10,10">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Background="{DynamicResource GuideBadgeBg}" CornerRadius="10" Width="20" Height="20">
                                        <TextBlock Text="1" Foreground="{DynamicResource GuideCardBg}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Timeline Progress" Foreground="{DynamicResource TextHeading}" FontWeight="Bold" FontSize="14"/>
                                </StackPanel>
                                <TextBlock Text="Track the 7-step registration process from name approval to receiving the certified copy." Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- 2 -->
                        <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource GuideCardBg}" CornerRadius="8" Padding="15" Margin="10,0,0,10">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Background="{DynamicResource GuideBadgeBg}" CornerRadius="10" Width="20" Height="20">
                                        <TextBlock Text="2" Foreground="{DynamicResource GuideCardBg}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Personnel &amp; NICs" Foreground="{DynamicResource TextHeading}" FontWeight="Bold" FontSize="14"/>
                                </StackPanel>
                                <TextBlock Text="View directors, secretaries, and shareholders. Hover over NIC documents to view, edit, or delete them." Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- 3 -->
                        <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource GuideCardBg}" CornerRadius="8" Padding="15" Margin="0,10,10,0">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Background="{DynamicResource GuideBadgeBg}" CornerRadius="10" Width="20" Height="20">
                                        <TextBlock Text="3" Foreground="{DynamicResource GuideCardBg}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="TIN Registration" Foreground="{DynamicResource TextHeading}" FontWeight="Bold" FontSize="14"/>
                                </StackPanel>
                                <TextBlock Text="Manage all tax-related documents. Filter files by category (Process, Approved, PIN, SSID)." Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- 4 -->
                        <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource GuideCardBg}" CornerRadius="8" Padding="15" Margin="10,10,0,0">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Background="{DynamicResource GuideBadgeBg}" CornerRadius="10" Width="20" Height="20">
                                        <TextBlock Text="4" Foreground="{DynamicResource GuideCardBg}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Action Center" Foreground="{DynamicResource TextHeading}" FontWeight="Bold" FontSize="14"/>
                                </StackPanel>
                                <TextBlock Text="Use the bottom action bar to quickly edit, delete, or generate reports for this specific record." Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Pro Tip -->
                    <Border Background="{DynamicResource DrawerHeaderBg}" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" CornerRadius="8" Padding="15">
                        <StackPanel Spacing="10">
                            <TextBlock Text="PRO TIP" Foreground="{DynamicResource TextSecondary}" FontWeight="Bold" FontSize="11"/>
                            <TextBlock Text="You can easily update personnel details by clicking 'Edit' in the action bar below. Changes are saved instantly to the database." Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    
                    <Button Content="Got it, thanks!" Command="{Binding CloseGuideCommand}" Background="{DynamicResource GuideGotItBg}" Foreground="{DynamicResource DrawerHeaderBg}" FontWeight="Bold" CornerRadius="6" Padding="15,8" HorizontalAlignment="Right" Cursor="Hand"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- Global Confirmation Dialog Overlay -->
        <Border Classes="premium-modal-overlay" IsVisible="{Binding IsConfirmDialogVisible}" ZIndex="1000">
            <Border Classes="premium-modal-content" HorizontalAlignment="Center" VerticalAlignment="Center" Width="480">
                <StackPanel Spacing="28">
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                             <Border Width="48" Height="48" CornerRadius="24" Background="{DynamicResource HoverBg}">
                                <i:Icon Value="fa-solid fa-circle-exclamation" Foreground="{DynamicResource StatusDanger}" FontSize="22"/>
                            </Border>
                            <TextBlock Text="{Binding ConfirmDialogTitle}" Foreground="{DynamicResource TextHeading}" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="footer-link" Command="{Binding CancelActionCommand}" VerticalAlignment="Top" Margin="0,-10,-10,0">
                            <i:Icon Value="fa-solid fa-xmark" Foreground="{DynamicResource TextSecondary}" FontSize="20"/>
                        </Button>
                    </Grid>
                    <TextBlock Text="{Binding ConfirmDialogMessage}" Foreground="{DynamicResource TextSecondary}" FontSize="16" LineHeight="26" TextWrapping="Wrap"/>
                    <Grid ColumnDefinitions="*, 12, *" Margin="0,10,0,0">
                        <Button Grid.Column="0" Content="Cancel" Classes="btn-secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding CancelActionCommand}"/>
                        <Button Name="ConfirmDeleteButton" Grid.Column="2" Content="Confirm" Classes="btn-delete" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding ConfirmActionCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Panel>
</UserControl>
