<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:helpers="using:AATS.Desktop.Helpers"
             xmlns:vm="using:AATS.Desktop.ViewModels.AuditAndAccounts"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             xmlns:conv="using:AATS.Desktop.Converters"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="1000"
             x:Class="AATS.Desktop.Views.AuditAndAccounts.AuditAssuranceAddRecordView"
             x:DataType="vm:AuditAssuranceAddRecordViewModel"
             x:CompileBindings="False">

    <UserControl.Styles>
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextHeading}"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>
        <Style Selector="TextBlock.input-label">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextHeading}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style Selector="TextBox.form-input">
            <Setter Property="Background" Value="{DynamicResource InputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextInput}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="TextBox.form-input:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource InputBg}"/>
        </Style>

        <Style Selector="AutoCompleteBox.form-input">
            <Setter Property="Background" Value="{DynamicResource InputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextInput}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="AutoCompleteBox.form-input /template/ TextBox#PART_TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBg}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="AutoCompleteBox.form-input /template/ TextBox#PART_TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource InputBg}"/>
        </Style>
        <Style Selector="AutoCompleteBox.form-input:focus-within">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource InputBg}"/>
        </Style>
        
        <Style Selector="Border.card-panel">
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>

        <Style Selector="Button.upload-trigger">
            <Setter Property="Background" Value="{DynamicResource InputBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.upload-trigger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
        </Style>

        <Style Selector="Border.upload-box">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        

        
        <!-- Custom RadioButton Styling -->
        <Style Selector="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextInput}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,20,0"/>
        </Style>

        <Style Selector="Button.action-btn-premium">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.action-btn-premium:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SelectionIndicatorBg}"/>
        </Style>
    </UserControl.Styles>
    
    <UserControl.Resources>
        <conv:PathToImageConverter x:Key="PathToImageConverter"/>
    </UserControl.Resources>

    <Panel>
        <ScrollViewer>
            <Grid RowDefinitions="Auto, Auto, *" Margin="25,20,15,20">
                <!-- Header -->
                <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,25">
                    <TextBlock Text="Add Record" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="15">
                        <Button Classes="btn-cancel" Content="Cancel" Command="{Binding DiscardChangesCommand}"/>
                        <Button Classes="btn-save" Command="{Binding SaveRecordCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <i:Icon Value="fa-regular fa-floppy-disk" FontSize="14"/>
                                <TextBlock Text="Save Record"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Error Message Banner -->
                <Border Grid.Row="1" Background="{DynamicResource NexoraErrorBg}" BorderBrush="{DynamicResource NexoraErrorBorder}" BorderThickness="1" CornerRadius="6" Padding="15,10" Margin="0,0,0,20" IsVisible="{Binding HasFormError}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <i:Icon Value="fa-solid fa-circle-exclamation" Foreground="{DynamicResource NexoraErrorIcon}" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding FormErrorMessage}" Foreground="{DynamicResource NexoraErrorText}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

            <ScrollViewer Grid.Row="2">
                <Grid ColumnDefinitions="6*, 4*" RowDefinitions="Auto, Auto, Auto, Auto" Margin="0,0,0,20">
                    <!-- General Details -->
                    <Border Grid.Row="0" Grid.Column="0" Classes="card-panel" Margin="0,0,20,0" VerticalAlignment="Stretch">
                            <Grid RowDefinitions="Auto, Auto, Auto, *">
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,20">
                                    <i:Icon Value="fa-solid fa-address-card" Foreground="{DynamicResource AccentPrimary}" FontSize="18"/>
                                    <TextBlock Text="GENERAL DETAILS" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                </StackPanel>
                                
                                <Grid Grid.Row="1" ColumnDefinitions="*, *">
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="ID" Classes="input-label"/>
                                        <Grid ColumnDefinitions="Auto, *">
                                            <!-- Subtle premium vertical bookmark indicator ribbon on the left-edge of the field -->
                                            <Rectangle Grid.Column="0" Width="4" Height="24" Fill="{Binding SelectedClientCategoryColor}" Margin="0,0,8,0" RadiusX="2" RadiusY="2" IsVisible="{Binding HasSelectedClientCategory}" VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="1" Classes="form-input" Watermark="Enter Client ID (e.g. CL-00001)" Text="{Binding ClientId}" Name="ClientIdTextBox"/>
                                        </Grid>
                                        <Popup IsOpen="{Binding IsClientCodeDropdownOpen}" 
                                               PlacementTarget="{Binding #ClientIdTextBox}"
                                               Placement="Bottom"
                                               PlacementGravity="Bottom"
                                               PlacementAnchor="Bottom"
                                               HorizontalOffset="0"
                                               VerticalOffset="2"
                                               IsLightDismissEnabled="True"
                                               MaxHeight="220"
                                               Width="{Binding #ClientIdTextBox.Bounds.Width}">
                                            <Border Background="{DynamicResource CardBg}" 
                                                    BorderBrush="{DynamicResource BorderDefault}" 
                                                    BorderThickness="1" 
                                                    CornerRadius="0,0,6,6" 
                                                    BoxShadow="0 4 16 0 #40000000"
                                                    ClipToBounds="True">
                                                <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl ItemsSource="{Binding ClientCodeSuggestions}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Background="Transparent" 
                                                                        BorderThickness="0" 
                                                                        Padding="0" 
                                                                        HorizontalAlignment="Stretch" 
                                                                        HorizontalContentAlignment="Stretch"
                                                                        Cursor="Hand"
                                                                        Command="{Binding $parent[UserControl].DataContext.SelectClientCodeCommand}" 
                                                                        CommandParameter="{Binding}">
                                                                    <Grid ColumnDefinitions="Auto, *" Height="36" Background="Transparent">
                                                                        <!-- Subtle premium vertical bookmark accent strip -->
                                                                        <Rectangle Grid.Column="0" Width="4" Height="20" Fill="{Binding CategoryColor}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0" RadiusX="2" RadiusY="2"/>
                                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" Margin="10,0" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding ClientCode}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" FontSize="13"/>
                                                                            <TextBlock Text="-" Foreground="{DynamicResource TextSecondary}" Opacity="0.7" FontSize="13"/>
                                                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextSecondary}" Opacity="0.8" FontSize="12" VerticalAlignment="Center"/>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Border>
                                        </Popup>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="Date" Classes="input-label"/>
                                        <CalendarDatePicker SelectedDate="{Binding Date}" HorizontalAlignment="Stretch" BorderBrush="{DynamicResource BorderDefault}" Background="{DynamicResource InputBg}" Padding="10,6" CornerRadius="6" Height="38"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Grid.Row="2" Margin="0,20,0,0">
                                    <TextBlock Text="Client Name" Classes="input-label"/>
                                    <TextBox Name="ClientNameTextBox" Classes="form-input" Watermark="Enter client name" Text="{Binding ClientName}"/>
<Popup IsOpen="{Binding IsClientNameDropdownOpen}" PlacementTarget="{Binding #ClientNameTextBox}" Placement="Bottom" IsLightDismissEnabled="True" MaxHeight="220" Width="{Binding #ClientNameTextBox.Bounds.Width}">
    <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" CornerRadius="0,0,6,6" BoxShadow="0 4 16 0 #40000000" ClipToBounds="True">
        <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding ClientNameSuggestions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Cursor="Hand" Command="{Binding $parent[UserControl].DataContext.SelectClientNameCommand}" CommandParameter="{Binding}">
                            <Grid ColumnDefinitions="Auto, *" Height="36" Background="Transparent">
                                <Rectangle Grid.Column="0" Width="4" Height="20" Fill="{Binding CategoryColor}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0" RadiusX="2" RadiusY="2"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" Margin="10,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" FontSize="13"/>
                                    <TextBlock Text="-" Foreground="{DynamicResource TextSecondary}" Opacity="0.7" FontSize="13"/>
                                    <TextBlock Text="{Binding ClientCode}" Foreground="{DynamicResource TextSecondary}" Opacity="0.8" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Border>
</Popup>
                                </StackPanel>

                                <Grid Grid.Row="3" Margin="0,20,0,0" RowDefinitions="Auto, *">
                                    <TextBlock Grid.Row="0" Text="Assignment" Classes="input-label"/>
                                    <TextBox Grid.Row="1" Classes="form-input" Watermark="Enter assignment details..." Text="{Binding Assignment}" AcceptsReturn="True" TextWrapping="Wrap" VerticalAlignment="Stretch"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Required Documents - Part 1 -->
                    <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Classes="card-panel" Margin="0,20,0,0">
                        <StackPanel Spacing="20">
                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,20">
                                <i:Icon Value="fa-solid fa-folder-open" Foreground="{DynamicResource AccentPrimary}" FontSize="18"/>
                                <TextBlock Text="REQUIRED DOCUMENTS - PART 1" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Tabs -->
                            <Border BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal" Spacing="0">
                                    <Button Classes="tab-btn" Classes.selected="{Binding SelectedPart1Tab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='BR'}" Command="{Binding SelectPart1TabCommand}" CommandParameter="BR">
                                        <TextBlock Text="BR"/>
                                    </Button>
                                    <Button Classes="tab-btn" Classes.selected="{Binding SelectedPart1Tab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Form 01'}" Command="{Binding SelectPart1TabCommand}" CommandParameter="Form 01">
                                        <TextBlock Text="Form 01"/>
                                    </Button>
                                    <Button Classes="tab-btn" Classes.selected="{Binding SelectedPart1Tab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Article of Association'}" Command="{Binding SelectPart1TabCommand}" CommandParameter="Article of Association">
                                        <TextBlock Text="Article of Association"/>
                                    </Button>
                                    <Button Classes="tab-btn" Classes.selected="{Binding SelectedPart1Tab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Previous Accounts'}" Command="{Binding SelectPart1TabCommand}" CommandParameter="Previous Accounts">
                                        <TextBlock Text="Previous Accounts"/>
                                    </Button>
                                    <Button Classes="tab-btn" Classes.selected="{Binding SelectedPart1Tab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Bank Confirmation'}" Command="{Binding SelectPart1TabCommand}" CommandParameter="Bank Confirmation">
                                        <TextBlock Text="Bank Confirmation"/>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Tab Content -->
                            <ScrollViewer MaxHeight="450" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <!-- BR Tab -->
                                    <StackPanel IsVisible="{Binding SelectedPart1Tab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='BR'}">
                                        <ItemsControl ItemsSource="{Binding BRFiles}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource DrawerHeaderBg}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                                            <i:Icon Value="fa-solid fa-file" Foreground="{DynamicResource AccentPrimary}" FontSize="16" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding FileName}" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextInput}"/>
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                                                <Button Command="{Binding $parent[UserControl].DataContext.PreviewDocumentCommand}" CommandParameter="{Binding}" Classes="action-btn-premium">
                                                                    <i:Icon Value="fa-solid fa-eye" Foreground="{DynamicResource AccentPrimary}" FontSize="14"/>
                                                                </Button>
                                                                <Button Command="{Binding $parent[UserControl].DataContext.RemoveDocumentCommand}" CommandParameter="{Binding}" Classes="action-btn-premium">
                                                                    <i:Icon Value="fa-solid fa-trash-can" Foreground="{DynamicResource StatusDanger}" FontSize="14"/>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        
                                        <!-- Upload Area -->
                                        <Button Classes="action-btn-premium" HorizontalAlignment="Left" Command="{Binding PickBRFilesCommand}" Margin="0,16,0,0">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <i:Icon Value="fa-solid fa-plus" Foreground="{DynamicResource AccentPrimary}"/>
                                                <TextBlock Text="Add BR" Foreground="{DynamicResource AccentPrimary}" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <!-- Form 01 Tab -->
                                    <StackPanel IsVisible="{Binding SelectedPart1Tab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Form 01'}">
                                        <ItemsControl ItemsSource="{Binding Form01Files}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource DrawerHeaderBg}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                                            <i:Icon Value="fa-solid fa-file" Foreground="{DynamicResource AccentPrimary}" FontSize="16" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding FileName}" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextInput}"/>
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                                                <Button Command="{Binding $parent[UserControl].DataContext.PreviewDocumentCommand}" CommandParameter="{Binding}" Classes="action-btn-premium">
                                                                    <i:Icon Value="fa-solid fa-eye" Foreground="{DynamicResource AccentPrimary}" FontSize="14"/>
                                                                </Button>
                                                                <Button Command="{Binding $parent[UserControl].DataContext.RemoveDocumentCommand}" CommandParameter="{Binding}" Classes="action-btn-premium">
                                                                    <i:Icon Value="fa-solid fa-trash-can" Foreground="{DynamicResource StatusDanger}" FontSize="14"/>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        
                                        <!-- Upload Area -->
                                        <Button Classes="action-btn-premium" HorizontalAlignment="Left" Command="{Binding PickForm01FilesCommand}" Margin="0,16,0,0">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <i:Icon Value="fa-solid fa-plus" Foreground="{DynamicResource AccentPrimary}"/>
                                                <TextBlock Text="Add Form 01" Foreground="{DynamicResource AccentPrimary}" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <!-- Article of Association Tab -->
                                    <StackPanel IsVisible="{Binding SelectedPart1Tab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Article of Association'}">
                                        <ItemsControl ItemsSource="{Binding ArticleofAssociationFiles}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource DrawerHeaderBg}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                                            <i:Icon Value="fa-solid fa-file" Foreground="{DynamicResource AccentPrimary}" FontSize="16" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding FileName}" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextInput}"/>
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                                                <Button Command="{Binding $parent[UserControl].DataContext.PreviewDocumentCommand}" CommandParameter="{Binding}" Classes="action-btn-premium">
                                                                    <i:Icon Value="fa-solid fa-eye" Foreground="{DynamicResource AccentPrimary}" FontSize="14"/>
                                                                </Button>
                                                                <Button Command="{Binding $parent[UserControl].DataContext.RemoveDocumentCommand}" CommandParameter="{Binding}" Classes="action-btn-premium">
                                                                    <i:Icon Value="fa-solid fa-trash-can" Foreground="{DynamicResource StatusDanger}" FontSize="14"/>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        
                                        <!-- Upload Area -->
                                        <Button Classes="action-btn-premium" HorizontalAlignment="Left" Command="{Binding PickArticleofAssociationFilesCommand}" Margin="0,16,0,0">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <i:Icon Value="fa-solid fa-plus" Foreground="{DynamicResource AccentPrimary}"/>
                                                <TextBlock Text="Add Article of Association" Foreground="{DynamicResource AccentPrimary}" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <!-- Previous Accounts Tab -->
                                    <StackPanel IsVisible="{Binding SelectedPart1Tab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Previous Accounts'}">
                                        <ItemsControl ItemsSource="{Binding PreviousAccountsFiles}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource DrawerHeaderBg}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                                            <i:Icon Value="fa-solid fa-file" Foreground="{DynamicResource AccentPrimary}" FontSize="16" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding FileName}" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextInput}"/>
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                                                <Button Command="{Binding $parent[UserControl].DataContext.PreviewDocumentCommand}" CommandParameter="{Binding}" Classes="action-btn-premium">
                                                                    <i:Icon Value="fa-solid fa-eye" Foreground="{DynamicResource AccentPrimary}" FontSize="14"/>
                                                                </Button>
                                                                <Button Command="{Binding $parent[UserControl].DataContext.RemoveDocumentCommand}" CommandParameter="{Binding}" Classes="action-btn-premium">
                                                                    <i:Icon Value="fa-solid fa-trash-can" Foreground="{DynamicResource StatusDanger}" FontSize="14"/>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        
                                        <!-- Upload Area -->
                                        <Button Classes="action-btn-premium" HorizontalAlignment="Left" Command="{Binding PickPreviousAccountsFilesCommand}" Margin="0,16,0,0">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <i:Icon Value="fa-solid fa-plus" Foreground="{DynamicResource AccentPrimary}"/>
                                                <TextBlock Text="Add Previous Accounts" Foreground="{DynamicResource AccentPrimary}" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <!-- Bank Confirmation Tab -->
                                    <StackPanel IsVisible="{Binding SelectedPart1Tab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Bank Confirmation'}">
                                        <ItemsControl ItemsSource="{Binding BankConfirmationFiles}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource DrawerHeaderBg}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                                            <i:Icon Value="fa-solid fa-file" Foreground="{DynamicResource AccentPrimary}" FontSize="16" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding FileName}" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextInput}"/>
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                                                <Button Command="{Binding $parent[UserControl].DataContext.PreviewDocumentCommand}" CommandParameter="{Binding}" Classes="action-btn-premium">
                                                                    <i:Icon Value="fa-solid fa-eye" Foreground="{DynamicResource AccentPrimary}" FontSize="14"/>
                                                                </Button>
                                                                <Button Command="{Binding $parent[UserControl].DataContext.RemoveDocumentCommand}" CommandParameter="{Binding}" Classes="action-btn-premium">
                                                                    <i:Icon Value="fa-solid fa-trash-can" Foreground="{DynamicResource StatusDanger}" FontSize="14"/>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        
                                        <!-- Upload Area -->
                                        <Button Classes="action-btn-premium" HorizontalAlignment="Left" Command="{Binding PickBankConfirmationFilesCommand}" Margin="0,16,0,0">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <i:Icon Value="fa-solid fa-plus" Foreground="{DynamicResource AccentPrimary}"/>
                                                <TextBlock Text="Add Bank Confirmation" Foreground="{DynamicResource AccentPrimary}" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- Required Documents - Part 2 -->
                    <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Classes="card-panel" Margin="0,20,0,0">
                        <StackPanel Spacing="20">
                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,20">
                                <i:Icon Value="fa-solid fa-folder-open" Foreground="{DynamicResource AccentPrimary}" FontSize="18"/>
                                <TextBlock Text="REQUIRED DOCUMENTS - PART 2" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Tabs -->
                            <Border BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal" Spacing="0">
                                    <Button Classes="tab-btn" Classes.selected="{Binding SelectedPart2Tab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Bank Statement'}" Command="{Binding SelectPart2TabCommand}" CommandParameter="Bank Statement">
                                        <TextBlock Text="Bank Statement"/>
                                    </Button>
                                    <Button Classes="tab-btn" Classes.selected="{Binding SelectedPart2Tab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Asset Details'}" Command="{Binding SelectPart2TabCommand}" CommandParameter="Asset Details">
                                        <TextBlock Text="Asset Details"/>
                                    </Button>
                                    <Button Classes="tab-btn" Classes.selected="{Binding SelectedPart2Tab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Liability Details'}" Command="{Binding SelectPart2TabCommand}" CommandParameter="Liability Details">
                                        <TextBlock Text="Liability Details"/>
                                    </Button>
                                    <Button Classes="tab-btn" Classes.selected="{Binding SelectedPart2Tab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Expense Details'}" Command="{Binding SelectPart2TabCommand}" CommandParameter="Expense Details">
                                        <TextBlock Text="Expense Details"/>
                                    </Button>
                                    <Button Classes="tab-btn" Classes.selected="{Binding SelectedPart2Tab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Logo'}" Command="{Binding SelectPart2TabCommand}" CommandParameter="Logo">
                                        <TextBlock Text="Logo"/>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Tab Content -->
                            <ScrollViewer MaxHeight="450" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <!-- Bank Statement Tab -->
                                    <StackPanel IsVisible="{Binding SelectedPart2Tab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Bank Statement'}">
                                        <ItemsControl ItemsSource="{Binding BankStatementFiles}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource DrawerHeaderBg}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                                            <i:Icon Value="fa-solid fa-file" Foreground="{DynamicResource AccentPrimary}" FontSize="16" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding FileName}" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextInput}"/>
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                                                <Button Command="{Binding $parent[UserControl].DataContext.PreviewDocumentCommand}" CommandParameter="{Binding}" Classes="action-btn-premium">
                                                                    <i:Icon Value="fa-solid fa-eye" Foreground="{DynamicResource AccentPrimary}" FontSize="14"/>
                                                                </Button>
                                                                <Button Command="{Binding $parent[UserControl].DataContext.RemoveDocumentCommand}" CommandParameter="{Binding}" Classes="action-btn-premium">
                                                                    <i:Icon Value="fa-solid fa-trash-can" Foreground="{DynamicResource StatusDanger}" FontSize="14"/>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        
                                        <!-- Upload Area -->
                                        <Button Classes="action-btn-premium" HorizontalAlignment="Left" Command="{Binding PickBankStatementFilesCommand}" Margin="0,16,0,0">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <i:Icon Value="fa-solid fa-plus" Foreground="{DynamicResource AccentPrimary}"/>
                                                <TextBlock Text="Add Bank Statement" Foreground="{DynamicResource AccentPrimary}" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <!-- Asset Details Tab -->
                                    <StackPanel IsVisible="{Binding SelectedPart2Tab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Asset Details'}">
                                        <ItemsControl ItemsSource="{Binding AssetDetailsFiles}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource DrawerHeaderBg}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                                            <i:Icon Value="fa-solid fa-file" Foreground="{DynamicResource AccentPrimary}" FontSize="16" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding FileName}" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextInput}"/>
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                                                <Button Command="{Binding $parent[UserControl].DataContext.PreviewDocumentCommand}" CommandParameter="{Binding}" Classes="action-btn-premium">
                                                                    <i:Icon Value="fa-solid fa-eye" Foreground="{DynamicResource AccentPrimary}" FontSize="14"/>
                                                                </Button>
                                                                <Button Command="{Binding $parent[UserControl].DataContext.RemoveDocumentCommand}" CommandParameter="{Binding}" Classes="action-btn-premium">
                                                                    <i:Icon Value="fa-solid fa-trash-can" Foreground="{DynamicResource StatusDanger}" FontSize="14"/>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        
                                        <!-- Upload Area -->
                                        <Button Classes="action-btn-premium" HorizontalAlignment="Left" Command="{Binding PickAssetDetailsFilesCommand}" Margin="0,16,0,0">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <i:Icon Value="fa-solid fa-plus" Foreground="{DynamicResource AccentPrimary}"/>
                                                <TextBlock Text="Add Asset Details" Foreground="{DynamicResource AccentPrimary}" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <!-- Liability Details Tab -->
                                    <StackPanel IsVisible="{Binding SelectedPart2Tab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Liability Details'}">
                                        <ItemsControl ItemsSource="{Binding LiabilityDetailsFiles}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource DrawerHeaderBg}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                                            <i:Icon Value="fa-solid fa-file" Foreground="{DynamicResource AccentPrimary}" FontSize="16" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding FileName}" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextInput}"/>
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                                                <Button Command="{Binding $parent[UserControl].DataContext.PreviewDocumentCommand}" CommandParameter="{Binding}" Classes="action-btn-premium">
                                                                    <i:Icon Value="fa-solid fa-eye" Foreground="{DynamicResource AccentPrimary}" FontSize="14"/>
                                                                </Button>
                                                                <Button Command="{Binding $parent[UserControl].DataContext.RemoveDocumentCommand}" CommandParameter="{Binding}" Classes="action-btn-premium">
                                                                    <i:Icon Value="fa-solid fa-trash-can" Foreground="{DynamicResource StatusDanger}" FontSize="14"/>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        
                                        <!-- Upload Area -->
                                        <Button Classes="action-btn-premium" HorizontalAlignment="Left" Command="{Binding PickLiabilityDetailsFilesCommand}" Margin="0,16,0,0">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <i:Icon Value="fa-solid fa-plus" Foreground="{DynamicResource AccentPrimary}"/>
                                                <TextBlock Text="Add Liability Details" Foreground="{DynamicResource AccentPrimary}" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <!-- Expense Details Tab -->
                                    <StackPanel IsVisible="{Binding SelectedPart2Tab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Expense Details'}">
                                        <ItemsControl ItemsSource="{Binding ExpenseDetailsFiles}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource DrawerHeaderBg}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                                            <i:Icon Value="fa-solid fa-file" Foreground="{DynamicResource AccentPrimary}" FontSize="16" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding FileName}" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextInput}"/>
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                                                <Button Command="{Binding $parent[UserControl].DataContext.PreviewDocumentCommand}" CommandParameter="{Binding}" Classes="action-btn-premium">
                                                                    <i:Icon Value="fa-solid fa-eye" Foreground="{DynamicResource AccentPrimary}" FontSize="14"/>
                                                                </Button>
                                                                <Button Command="{Binding $parent[UserControl].DataContext.RemoveDocumentCommand}" CommandParameter="{Binding}" Classes="action-btn-premium">
                                                                    <i:Icon Value="fa-solid fa-trash-can" Foreground="{DynamicResource StatusDanger}" FontSize="14"/>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        
                                        <!-- Upload Area -->
                                        <Button Classes="action-btn-premium" HorizontalAlignment="Left" Command="{Binding PickExpenseDetailsFilesCommand}" Margin="0,16,0,0">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <i:Icon Value="fa-solid fa-plus" Foreground="{DynamicResource AccentPrimary}"/>
                                                <TextBlock Text="Add Expense Details" Foreground="{DynamicResource AccentPrimary}" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <!-- Logo Tab -->
                                    <StackPanel IsVisible="{Binding SelectedPart2Tab, Converter={StaticResource StringEqualityConverter}, ConverterParameter='Logo'}">
                                        <ItemsControl ItemsSource="{Binding LogoFiles}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource DrawerHeaderBg}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                                            <i:Icon Value="fa-solid fa-file" Foreground="{DynamicResource AccentPrimary}" FontSize="16" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding FileName}" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextInput}"/>
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                                                <Button Command="{Binding $parent[UserControl].DataContext.PreviewDocumentCommand}" CommandParameter="{Binding}" Classes="action-btn-premium">
                                                                    <i:Icon Value="fa-solid fa-eye" Foreground="{DynamicResource AccentPrimary}" FontSize="14"/>
                                                                </Button>
                                                                <Button Command="{Binding $parent[UserControl].DataContext.RemoveDocumentCommand}" CommandParameter="{Binding}" Classes="action-btn-premium">
                                                                    <i:Icon Value="fa-solid fa-trash-can" Foreground="{DynamicResource StatusDanger}" FontSize="14"/>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        
                                        <!-- Upload Area -->
                                        <Button Classes="action-btn-premium" HorizontalAlignment="Left" Command="{Binding PickLogoFilesCommand}" Margin="0,16,0,0">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <i:Icon Value="fa-solid fa-plus" Foreground="{DynamicResource AccentPrimary}"/>
                                                <TextBlock Text="Add Logo" Foreground="{DynamicResource AccentPrimary}" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,20,0,0">
                        <Button Classes="footer-link" Command="{Binding OpenGuideCommand}" Padding="0" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <i:Icon Value="fa-solid fa-circle-question" Foreground="{DynamicResource TextSecondary}" FontSize="16"/>
                                <TextBlock Text="Learn more about Audit Records" Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Right Column: Payment Summary -->
                    <Border Grid.Row="0" Grid.Column="1" Classes="card-panel" VerticalAlignment="Stretch" Margin="0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,20">
                                <i:Icon Value="fa-solid fa-file-invoice-dollar" Foreground="{DynamicResource AccentPrimary}" FontSize="18"/>
                                <TextBlock Text="PAYMENT SUMMARY" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                </StackPanel>

                            <!-- Sub Total -->
                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Text="Sub Total" Classes="input-label"/>
                                <TextBox Classes="form-input numeric-input" Text="{Binding SubTotal, TargetNullValue='', FallbackValue='0'}"/>
                            </StackPanel>

                            <!-- Payment Option -->
                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Text="Payment Option" Classes="input-label"/>
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <RadioButton Content="Cash" IsChecked="{Binding IsOptionCash, Mode=TwoWay}"/>
                                    <RadioButton Content="Online" IsChecked="{Binding IsOptionOnline, Mode=TwoWay}"/>
                                    <RadioButton Content="Cheque" IsChecked="{Binding IsOptionCheque, Mode=TwoWay}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Cheque Details (Animated) -->
                            <Border Classes="cheque-details-card" Classes.is-active="{Binding IsOptionCheque}">
                                <StackPanel Spacing="15">
                                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,5">
                                        <i:Icon Value="fa-solid fa-money-check" Foreground="{DynamicResource AccentPrimary}" FontSize="16"/>
                                        <TextBlock Text="Issue Cheque Details" Foreground="{DynamicResource TextHeading}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    
                                    <Grid ColumnDefinitions="*, *">
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="Cheque Number" Classes="input-label"/>
                                            <TextBox Classes="form-input" Watermark="Number" Text="{Binding ChequeNumber}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock Text="Cheque Date" Classes="input-label"/>
                                            <CalendarDatePicker Classes="form-input" SelectedDate="{Binding ChequeDate}"/>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel>
                                        <TextBlock Text="Bank Name" Classes="input-label"/>
                                         <AutoCompleteBox ItemsSource="{Binding Banks}"
                                                          Text="{Binding ChequeBank}"
                                                          FilterMode="StartsWith"
                                                          MinimumPrefixLength="0"
                                                          Classes="form-input"
                                                          Watermark="Select or type bank name"/>
                                    </StackPanel>

                                    <Grid ColumnDefinitions="*, *">
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="Amount" Classes="input-label"/>
                                            <TextBox Classes="form-input" Text="{Binding ChequeAmount}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock Text="Status" Classes="input-label"/>
                                            <ComboBox Classes="form-input" ItemsSource="{Binding ChequeStatusOptions}" SelectedItem="{Binding ChequeStatus}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Payment Status -->
                            <StackPanel Margin="0,0,0,25">
                                <TextBlock Text="Payment Status" Classes="input-label"/>
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <RadioButton Content="Paid" IsChecked="{Binding IsStatusPaid, Mode=TwoWay}"/>
                                    <RadioButton Content="Unpaid" IsChecked="{Binding IsStatusUnpaid, Mode=TwoWay}"/>
                                    <RadioButton Content="Partial" IsChecked="{Binding IsStatusPartial, Mode=TwoWay}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Partially Paid Amount (only visible if status is Partial) -->
                            <StackPanel Margin="0,0,0,25" IsVisible="{Binding IsPaymentStatusPartial}">
                                <TextBlock Text="Partially Paid Amount" Classes="input-label"/>
                                <TextBox Classes="form-input numeric-input" Text="{Binding PartialAmount, TargetNullValue='', FallbackValue='0'}">
                                    <TextBox.InnerLeftContent>
                                        <TextBlock Text="LKR " Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="12,0,5,0" FontSize="13"/>
                                    </TextBox.InnerLeftContent>
                                </TextBox>
                            </StackPanel>

                            <!-- Discount -->
                            <StackPanel Margin="0,0,0,25">
                                <TextBlock Text="Discount" Classes="input-label"/>
                                <TextBox Classes="form-input numeric-input" Text="{Binding Discount, TargetNullValue='', FallbackValue='0'}"/>
                            </StackPanel>

                            <!-- Total Block -->
                            <Border Background="{DynamicResource DrawerHeaderBg}" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,15,0,0">
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Text="Total Payment:" Foreground="{DynamicResource TextHeading}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                                        <TextBlock Text="LKR" Foreground="{DynamicResource TextHeading}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding TotalPayment, StringFormat='{}{0:N2}'}" Foreground="{DynamicResource TextHeading}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
            </Grid>
        </ScrollViewer>

    <!-- Instruction Guide Popup Overlay -->
    <Border ZIndex="10" 
            IsVisible="{Binding IsGuideVisible}" helpers:GuideHelper.EnableOutsideClickClose="True" 
            Background="{DynamicResource OverlayBg}" 
            HorizontalAlignment="Stretch" 
            VerticalAlignment="Stretch">
        <Border Background="{DynamicResource DateFlyoutBg}" 
                CornerRadius="12" 
                Width="600" 
                VerticalAlignment="Center" 
                HorizontalAlignment="Center" 
                Padding="25"
                BoxShadow="0 20 60 0 #A6000000">
            <StackPanel Spacing="25">
                <!-- Header -->
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <i:Icon Value="fa-solid fa-circle-question" FontSize="20" Foreground="{DynamicResource TextHeading}"/>
                        <TextBlock Text="Guide: Creating New Records" Foreground="{DynamicResource TextHeading}" FontSize="20" FontWeight="Bold"/>
                    </StackPanel>
                    <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="5" Command="{Binding CloseGuideCommand}" Cursor="Hand">
                        <i:Icon Value="fa-solid fa-xmark" Foreground="{DynamicResource TextSecondary}" FontSize="18"/>
                    </Button>
                </Grid>

                <TextBlock Text="Follow these steps to ensure all audit data is captured accurately." Foreground="{DynamicResource TextSecondary}" FontSize="14" Margin="0,-15,0,0"/>

                <!-- Cards Grid -->
                <!-- Matching the exact Grid/Margin logic of SharedAuditTableView for consistency -->
                <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto">
                    <!-- Step 1 -->
                    <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource GuideCardBg}" CornerRadius="8" Padding="15" Margin="0,0,10,10">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Background="{DynamicResource GuideBadgeBg}" CornerRadius="10" Width="20" Height="20">
                                    <TextBlock Text="1" Foreground="{DynamicResource GuideCardBg}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="General Details" Foreground="{DynamicResource TextHeading}" FontWeight="Bold" FontSize="14"/>
                            </StackPanel>
                            <TextBlock Text="Capture the client's identity and basic assignment details. You can even upload a client logo for a customized view." Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Step 2 -->
                    <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource GuideCardBg}" CornerRadius="8" Padding="15" Margin="10,0,0,10">
                         <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Background="{DynamicResource GuideBadgeBg}" CornerRadius="10" Width="20" Height="20">
                                    <TextBlock Text="2" Foreground="{DynamicResource GuideCardBg}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Source Documents" Foreground="{DynamicResource TextHeading}" FontWeight="Bold" FontSize="14"/>
                            </StackPanel>
                            <TextBlock Text="Drag and drop multiple files. Each document can have its own description for better source tracking." Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Step 3 -->
                    <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource GuideCardBg}" CornerRadius="8" Padding="15" Margin="0,10,10,0">
                         <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Background="{DynamicResource GuideBadgeBg}" CornerRadius="10" Width="20" Height="20">
                                    <TextBlock Text="3" Foreground="{DynamicResource GuideCardBg}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Payment Logic" Foreground="{DynamicResource TextHeading}" FontWeight="Bold" FontSize="14"/>
                            </StackPanel>
                            <TextBlock Text="Enter subtotal and discounts. The system automatically calculates balances for partial or unpaid status." Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Step 4 -->
                    <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource GuideCardBg}" CornerRadius="8" Padding="15" Margin="10,10,0,0">
                         <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Background="{DynamicResource GuideBadgeBg}" CornerRadius="10" Width="20" Height="20">
                                    <TextBlock Text="4" Foreground="{DynamicResource GuideCardBg}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Review &amp; Save" Foreground="{DynamicResource TextHeading}" FontWeight="Bold" FontSize="14"/>
                            </StackPanel>
                            <TextBlock Text="Once all fields are verified, save the record to initialize the Bookkeeping process automatically." Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Pro Tip Section -->
                <Border Background="{DynamicResource DrawerHeaderBg}" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" CornerRadius="8" Padding="15">
                    <StackPanel Spacing="10">
                        <TextBlock Text="PRO TIP" Foreground="{DynamicResource TextSecondary}" FontWeight="Bold" FontSize="11"/>
                        <TextBlock Text="You can edit these details later, but once the process moves beyond Handover, certain fields may become read-only to ensure audit integrity." Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Footer Button -->
                <Button Command="{Binding CloseGuideCommand}" 
                        Content="Got it, thanks!" 
                        Background="{DynamicResource GuideGotItBg}" 
                        Foreground="{DynamicResource DrawerHeaderBg}" 
                        FontWeight="Bold" 
                        CornerRadius="6" 
                        Padding="15,8" 
                        HorizontalAlignment="Right" 
                        Cursor="Hand"/>
            </StackPanel>
        </Border>
    </Border>

    <!-- Save Confirmation Dialog Overlay -->
    <Border ZIndex="100" IsVisible="{Binding IsConfirmSaveVisible}" Background="{DynamicResource OverlayBg}"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Border Background="{DynamicResource DrawerHeaderBg}" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" CornerRadius="12"
                Width="420" VerticalAlignment="Center" HorizontalAlignment="Center"
                Padding="30" BoxShadow="0 8 32 0 #66000000">
            <StackPanel Spacing="20">
                <!-- Dialog Title -->
                <TextBlock Text="{Binding ConfirmSaveTitle}" Foreground="{DynamicResource TextHeading}" FontSize="18" FontWeight="Bold"/>
                
                <!-- Dialog Message -->
                <TextBlock Text="{Binding ConfirmSaveMessage}" Foreground="{DynamicResource TextSecondary}" FontSize="14" TextWrapping="Wrap" LineHeight="22"/>
                
                <!-- Dialog Buttons -->
                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Content="Keep Editing" Background="Transparent" Foreground="{DynamicResource TextSecondary}" BorderThickness="0"
                            Command="{Binding CancelSaveCommand}" Cursor="Hand"/>
                    <Button Content="Save Changes" Background="{DynamicResource AccentPrimary}" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"
                            Padding="25,10" CornerRadius="8"
                            Command="{Binding ConfirmSaveCommand}" Cursor="Hand"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>

    <!-- Discard Changes Confirmation Overlay -->
    <Border ZIndex="101" IsVisible="{Binding IsDiscardConfirmVisible}" Classes="premium-modal-overlay">
        <Border Classes="premium-modal-content" HorizontalAlignment="Center" VerticalAlignment="Center" Width="440">
            <StackPanel Spacing="25">
                <i:Icon Value="fa-solid fa-triangle-exclamation" Foreground="{DynamicResource StatusWarning}" FontSize="40" HorizontalAlignment="Center"/>
                <TextBlock Text="Discard changes?" Foreground="{DynamicResource TextPrimary}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="You have unsaved information. Are you sure you want to discard it? This action cannot be undone." 
                           Foreground="{DynamicResource TextSecondary}" FontSize="13" TextAlignment="Center" TextWrapping="Wrap"/>
                <Grid ColumnDefinitions="*, 12, *" Margin="0,10,0,0">
                    <Button Grid.Column="0" Content="Keep Editing" Command="{Binding CancelDiscardCommand}" Classes="btn-secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    <Button Grid.Column="2" Content="Discard" Command="{Binding ConfirmDiscardCommand}" Classes="btn-delete" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Border>
    </Border>
    <!-- Remove Confirmation Overlay -->
    <Border ZIndex="102" IsVisible="{Binding IsRemoveConfirmVisible}" Classes="premium-modal-overlay">
        <Border Classes="premium-modal-content" HorizontalAlignment="Center" VerticalAlignment="Center" Width="440">
            <StackPanel Spacing="25">
                <i:Icon Value="fa-solid fa-trash-can" Foreground="{DynamicResource StatusDanger}" FontSize="40" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding RemoveConfirmTitle}" Foreground="{DynamicResource TextPrimary}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding RemoveConfirmMessage}" 
                           Foreground="{DynamicResource TextSecondary}" FontSize="13" TextAlignment="Center" TextWrapping="Wrap"/>
                <Grid ColumnDefinitions="*, 12, *" Margin="0,10,0,0">
                    <Button Grid.Column="0" Content="Keep File" Command="{Binding CancelRemoveCommand}" Classes="btn-secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    <Button Grid.Column="2" Content="Remove" Command="{Binding ConfirmRemoveCommand}" Classes="btn-delete" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Border>
    </Border>
    </Panel>
</UserControl>
