<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AATS.Desktop.ViewModels"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             xmlns:conv="using:AATS.Desktop.Converters"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="900"
             x:Class="AATS.Desktop.Views.OutstandingBalancesView"
             x:DataType="vm:OutstandingBalancesViewModel"
             x:CompileBindings="False"
             ClipToBounds="False">

    <UserControl.Styles>
        <StyleInclude Source="avares://AATS.Desktop/Styles/PremiumDrawer.axaml" />

        <!-- Card Style -->
        <Style Selector="Border.dashboard-card">
            <Setter Property="Background" Value="{DynamicResource DashCardBg}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18,15"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}"/>
        </Style>

        <!-- Status Badges in Grid -->
        <Style Selector="Border.status-badge">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style Selector="^ TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="TextAlignment" Value="Center"/>
            </Style>
        </Style>
        <Style Selector="Border.status-paid">
            <Setter Property="Background" Value="#E0F2FE"/>
            <Setter Property="BorderBrush" Value="#BAE6FD"/>
            <Style Selector="^ TextBlock"><Setter Property="Foreground" Value="#0369A1"/></Style>
        </Style>
        <Style Selector="Border.status-partial">
            <Setter Property="Background" Value="#FEF3C7"/>
            <Setter Property="BorderBrush" Value="#FDE68A"/>
            <Style Selector="^ TextBlock"><Setter Property="Foreground" Value="#B45309"/></Style>
        </Style>
        <Style Selector="Border.status-unpaid">
            <Setter Property="Background" Value="#FEE2E2"/>
            <Setter Property="BorderBrush" Value="#FCA5A5"/>
            <Style Selector="^ TextBlock"><Setter Property="Foreground" Value="#B91C1C"/></Style>
        </Style>
        <Style Selector="Border.status-pendingcheque">
            <Setter Property="Background" Value="#ECFDF5"/>
            <Setter Property="BorderBrush" Value="#A7F3D0"/>
            <Style Selector="^ TextBlock"><Setter Property="Foreground" Value="#047857"/></Style>
        </Style>
        <Style Selector="Border.status-bouncedcheque">
            <Setter Property="Background" Value="#F3E8FF"/>
            <Setter Property="BorderBrush" Value="#E9D5FF"/>
            <Style Selector="^ TextBlock"><Setter Property="Foreground" Value="#6B21A8"/></Style>
        </Style>


    </UserControl.Styles>

    <Panel ClipToBounds="False">
        <ScrollViewer>
        <Grid RowDefinitions="Auto, Auto, Auto, *, Auto" Margin="30" RowSpacing="20">
            <!-- Header section -->
            <StackPanel Grid.Row="0" Spacing="5">
                <TextBlock Text="Outstanding Balances" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Text="Detailed summary and history of accounts receivables, partial billings, and collections." Foreground="{DynamicResource TextSecondary}" FontSize="15"/>
            </StackPanel>

            <!-- Metrics Cards Grid -->
            <Grid Grid.Row="1" ColumnDefinitions="*, *, *, *, *" ColumnSpacing="15">
                <!-- Card 1: Total Receivables -->
                <Border Grid.Column="0" Classes="dashboard-card">
                    <Grid RowDefinitions="Auto, Auto, Auto">
                        <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0" Text="Total Outstanding" Foreground="{DynamicResource TextSecondary}" FontSize="13" FontWeight="SemiBold"/>
                            <i:Icon Grid.Column="1" Value="fa-solid fa-circle-exclamation" Foreground="{DynamicResource StatusWarning}" VerticalAlignment="Top"/>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="{Binding TotalOutstanding, StringFormat='{}LKR {0:N0}'}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource StatusWarning}" Margin="0,12,0,4"/>
                        <TextBlock Grid.Row="2" Text="Total unpaid balance due" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                    </Grid>
                </Border>

                <!-- Card 2: Pending Cheques -->
                <Border Grid.Column="1" Classes="dashboard-card">
                    <Grid RowDefinitions="Auto, Auto, Auto">
                        <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0" Text="Pending Cheques" Foreground="{DynamicResource TextSecondary}" FontSize="13" FontWeight="SemiBold"/>
                            <i:Icon Grid.Column="1" Value="fa-solid fa-money-check" Foreground="{DynamicResource AccentBlue}" VerticalAlignment="Top"/>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="{Binding TotalPendingCheques, StringFormat='{}LKR {0:N0}'}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,12,0,4"/>
                        <TextBlock Grid.Row="2" Text="Awaiting clearing/deposit" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                    </Grid>
                </Border>

                <!-- Card 3: Total Partial Payments -->
                <Border Grid.Column="2" Classes="dashboard-card">
                    <Grid RowDefinitions="Auto, Auto, Auto">
                        <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0" Text="Partial Collections" Foreground="{DynamicResource TextSecondary}" FontSize="13" FontWeight="SemiBold"/>
                            <i:Icon Grid.Column="1" Value="fa-solid fa-chart-pie" Foreground="{DynamicResource StatusSuccess}" VerticalAlignment="Top"/>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="{Binding TotalPartialPayments, StringFormat='{}LKR {0:N0}'}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource StatusSuccess}" Margin="0,12,0,4"/>
                        <TextBlock Grid.Row="2" Text="Amount successfully paid" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                    </Grid>
                </Border>

                <!-- Card 4: Overdue Amount -->
                <Border Grid.Column="3" Classes="dashboard-card">
                    <Grid RowDefinitions="Auto, Auto, Auto">
                        <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0" Text="Overdue Amount" Foreground="{DynamicResource TextSecondary}" FontSize="13" FontWeight="SemiBold"/>
                            <i:Icon Grid.Column="1" Value="fa-solid fa-triangle-exclamation" Foreground="{DynamicResource StatusDanger}" VerticalAlignment="Top"/>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="{Binding TotalOverdueAmount, StringFormat='{}LKR {0:N0}'}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource StatusDanger}" Margin="0,12,0,4"/>
                        <TextBlock Grid.Row="2" Text="Exceeded contract terms" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                    </Grid>
                </Border>

                <!-- Card 5: Outstanding Clients -->
                <Border Grid.Column="4" Classes="dashboard-card">
                    <Grid RowDefinitions="Auto, Auto, Auto">
                        <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0" Text="Pending Clients" Foreground="{DynamicResource TextSecondary}" FontSize="13" FontWeight="SemiBold"/>
                            <i:Icon Grid.Column="1" Value="fa-solid fa-users" Foreground="{DynamicResource TextFaint}" VerticalAlignment="Top"/>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="{Binding OutstandingClientsCount}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,12,0,4"/>
                        <TextBlock Grid.Row="2" Text="Unique clients with dues" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Standardized Filter Section -->
            <Border Grid.Row="2" Background="{DynamicResource FilterBarBg}" CornerRadius="12" Padding="15" Margin="0,0,0,20" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                <Grid ColumnDefinitions="*, 15, Auto">
                    <!-- Search Field -->
                    <Grid Grid.Column="0" ColumnDefinitions="*">
                        <Panel Grid.Column="0">
                            <TextBox Classes="filter-search" Watermark="Search by client ID, name, invoice, or status..." Text="{Binding SearchText}"/>
                            <i:Icon Value="fa-solid fa-magnifying-glass" Foreground="{DynamicResource TextDimmed}" FontSize="14" HorizontalAlignment="Left" Margin="15,0,0,0" VerticalAlignment="Center"/>
                        </Panel>
                    </Grid>

                    <!-- Standardized Premium Filters Group -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                        <!-- Date Filter Button -->
                        <Button Classes="date-filter-trigger" ToolTip.Tip="Filter by Date">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <i:Icon Value="fa-solid fa-calendar-alt" Foreground="{DynamicResource AccentPrimary}" FontSize="16"/>
                                <TextBlock Text="{Binding DateFilterSummary}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14"/>
                                <i:Icon Value="fa-solid fa-chevron-down" Foreground="{DynamicResource TextMuted}" FontSize="10" VerticalAlignment="Center" Margin="5,0,0,0"/>
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft" FlyoutPresenterClasses="premium-flyout">
                                    <Border Background="{DynamicResource DrawerBg}" 
                                            BorderBrush="{DynamicResource BorderDefault}" 
                                            BorderThickness="1" 
                                            CornerRadius="12" 
                                            Padding="0" 
                                            ClipToBounds="True"
                                            BoxShadow="{DynamicResource FlyoutShadow}">
                                        <Grid ColumnDefinitions="Auto, 1, Auto">
                                            <!-- Left: Quick Picks List -->
                                            <Border Classes="quick-pick-sidebar">
                                                <ListBox ItemsSource="{Binding DateFilters}" SelectedItem="{Binding SelectedDateFilter}"
                                                         Classes="quick-pick-list"/>
                                            </Border>

                                            <!-- Vertical Divider -->
                                            <Border Grid.Column="1" Background="{DynamicResource BorderMuted}" Width="1" VerticalAlignment="Stretch"/>

                                            <!-- Right: Context Content -->
                                            <Border Grid.Column="2" Padding="25" MinWidth="350" MinHeight="480">
                                                <Panel>
                                                    <!-- All Dates -->
                                                    <StackPanel Spacing="15" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                IsVisible="{Binding SelectedDateFilter, Converter={StaticResource StringEqualityConverter}, ConverterParameter=All Dates}">
                                                        <Panel Height="80">
                                                            <i:Icon Value="fa-solid fa-calendar-check" FontSize="48" Foreground="{DynamicResource TextMuted}" Opacity="0.3" HorizontalAlignment="Center"/>
                                                        </Panel>
                                                        <TextBlock Text="Viewing all time records" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                    
                                                    <!-- Today -->
                                                    <StackPanel Spacing="15" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                IsVisible="{Binding SelectedDateFilter, Converter={StaticResource StringEqualityConverter}, ConverterParameter=Today}">
                                                        <Panel Height="80">
                                                            <i:Icon Value="fa-solid fa-clock" FontSize="48" Foreground="{DynamicResource StatusInfo}" Opacity="0.5" HorizontalAlignment="Center"/>
                                                        </Panel>
                                                        <TextBlock Text="Viewing records from today" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                                                    </StackPanel>

                                                    <!-- This Week -->
                                                    <StackPanel Spacing="15" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                IsVisible="{Binding SelectedDateFilter, Converter={StaticResource StringEqualityConverter}, ConverterParameter=This Week}">
                                                        <Panel Height="80">
                                                            <i:Icon Value="fa-solid fa-calendar-week" FontSize="48" Foreground="{DynamicResource AccentBlue}" Opacity="0.5" HorizontalAlignment="Center"/>
                                                        </Panel>
                                                        <TextBlock Text="Viewing records from this week" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                                                    </StackPanel>

                                                    <!-- This Month -->
                                                    <StackPanel Spacing="15" 
                                                                IsVisible="{Binding SelectedDateFilter, Converter={StaticResource StringEqualityConverter}, ConverterParameter=This Month}">
                                                        <TextBlock Text="Select Month" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimary}"/>
                                                        <Calendar SelectedDate="{Binding MonthDate}"/>
                                                        <TextBlock Text="Tip: Select any day in the month" FontSize="11" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                                                    </StackPanel>

                                                    <!-- This Year -->
                                                    <StackPanel Spacing="15" 
                                                                IsVisible="{Binding SelectedDateFilter, Converter={StaticResource StringEqualityConverter}, ConverterParameter=This Year}">
                                                        <TextBlock Text="Select Year" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimary}"/>
                                                        <ListBox ItemsSource="{Binding Years}" 
                                                                 SelectedItem="{Binding SelectedYear}"
                                                                 Classes="year-selector-list">
                                                            <ListBox.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel/>
                                                                </ItemsPanelTemplate>
                                                            </ListBox.ItemsPanel>
                                                        </ListBox>
                                                    </StackPanel>

                                                    <!-- Specific Date -->
                                                    <StackPanel Spacing="15" 
                                                                IsVisible="{Binding SelectedDateFilter, Converter={StaticResource StringEqualityConverter}, ConverterParameter=Specific Date}">
                                                        <TextBlock Text="Select Specific Date" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimary}"/>
                                                        <Calendar SelectedDate="{Binding SpecificDate}"/>
                                                    </StackPanel>

                                                    <!-- Specific Period -->
                                                    <StackPanel Spacing="15" 
                                                                IsVisible="{Binding SelectedDateFilter, Converter={StaticResource StringEqualityConverter}, ConverterParameter=Specific Period}">
                                                        <TextBlock Text="Select Date Range" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimary}"/>
                                                        <Border Background="{DynamicResource DateFlyoutBg}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="5">
                                                            <StackPanel Spacing="10">
                                                                <Calendar SelectionMode="SingleRange" 
                                                                          SelectedDatesChanged="Calendar_OnSelectedDatesChanged"
                                                                          HorizontalAlignment="Center"/>
                                                                <Grid ColumnDefinitions="*, Auto, *" Margin="10,0">
                                                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                                                        <TextBlock Text="Start Date" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                                                        <TextBlock Text="{Binding PeriodStartDate, StringFormat={}{0:dd MMM yyyy}}" FontWeight="SemiBold" FontSize="12"/>
                                                                    </StackPanel>
                                                                    <i:Icon Grid.Column="1" Value="fa-solid fa-arrow-right" FontSize="10" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="10,0"/>
                                                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                                                        <TextBlock Text="End Date" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                                                        <TextBlock Text="{Binding PeriodEndDate, StringFormat={}{0:dd MMM yyyy}}" FontWeight="SemiBold" FontSize="12"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </Panel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <ComboBox Classes="filter-combo" ItemsSource="{Binding ClientFilters}" SelectedItem="{Binding SelectedClientFilter}"/>
                        <ComboBox Classes="filter-combo" ItemsSource="{Binding ServiceFilters}" SelectedItem="{Binding SelectedServiceFilter}"/>
                        <ComboBox Classes="filter-combo" ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding SelectedStatusFilter}"/>

                        <!-- Reset Button -->
                        <Button Command="{Binding ClearFiltersCommand}"
                                IsVisible="{Binding HasActiveFilters}"
                                Background="Transparent" BorderThickness="0" Padding="8"
                                ToolTip.Tip="Reset All Filters">
                            <i:Icon Value="fa-solid fa-rotate-left" Foreground="{DynamicResource StatusDanger}" FontSize="16"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Receivables DataGrid -->
            <Border Grid.Row="3" Background="{DynamicResource TableBg}" CornerRadius="12" Padding="5" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" ClipToBounds="True">
                <Panel MinHeight="350">
                    <!-- Loading / No Records display -->
                    <StackPanel Spacing="15" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !FilteredRecords.Count}">
                        <i:Icon Value="fa-solid fa-folder-open" FontSize="36" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock Text="No outstanding balance records found matching your filters." Foreground="{DynamicResource TextSecondary}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Actual Table Grid -->
                    <DataGrid ItemsSource="{Binding FilteredRecords}" 
                              SelectedItem="{Binding SelectedRecord, Mode=TwoWay}"
                              IsVisible="{Binding FilteredRecords.Count}" 
                              AutoGenerateColumns="False" 
                              IsReadOnly="True" 
                              CanUserResizeColumns="True"
                              CanUserSortColumns="True"
                              Background="Transparent" 
                              BorderThickness="0"
                              GridLinesVisibility="None" 
                              RowBackground="Transparent"
                              HeadersVisibility="Column"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <!-- Client ID -->
                            <DataGridTemplateColumn Header="Client ID" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Classes="row-button" Classes.selected="{Binding IsSelected}" Command="{Binding $parent[UserControl].((vm:OutstandingBalancesViewModel)DataContext).OpenRecordDetailCommand}" CommandParameter="{Binding}">
                                            <TextBlock Text="{Binding ClientId}" VerticalAlignment="Center" Margin="12,0" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <!-- Client Name -->
                            <DataGridTemplateColumn Header="Client Name" Width="*" MinWidth="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Classes="row-button" Classes.selected="{Binding IsSelected}" Command="{Binding $parent[UserControl].((vm:OutstandingBalancesViewModel)DataContext).OpenRecordDetailCommand}" CommandParameter="{Binding}">
                                            <TextBlock Text="{Binding ClientName}" VerticalAlignment="Center" FontWeight="Bold" Margin="12,0" Foreground="{DynamicResource TextPrimary}" FontSize="13"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Service Module -->
                            <DataGridTemplateColumn Header="Service / Module" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Classes="row-button" Classes.selected="{Binding IsSelected}" Command="{Binding $parent[UserControl].((vm:OutstandingBalancesViewModel)DataContext).OpenRecordDetailCommand}" CommandParameter="{Binding}">
                                            <TextBlock Text="{Binding ServiceModule}" VerticalAlignment="Center" Margin="12,0" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Invoice Number -->
                            <DataGridTemplateColumn Header="Invoice No." Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Classes="row-button" Classes.selected="{Binding IsSelected}" Command="{Binding $parent[UserControl].((vm:OutstandingBalancesViewModel)DataContext).OpenRecordDetailCommand}" CommandParameter="{Binding}">
                                            <TextBlock Text="{Binding InvoiceNumber}" VerticalAlignment="Center" Margin="12,0" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Total Invoice Amount -->
                            <DataGridTemplateColumn Header="Total Amount" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Classes="row-button" Classes.selected="{Binding IsSelected}" Command="{Binding $parent[UserControl].((vm:OutstandingBalancesViewModel)DataContext).OpenRecordDetailCommand}" CommandParameter="{Binding}">
                                            <TextBlock Text="{Binding TotalAmount, StringFormat='{}{0:N0}'}" VerticalAlignment="Center" Margin="12,0" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" FontSize="12"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Amount Paid -->
                            <DataGridTemplateColumn Header="Amount Paid" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Classes="row-button" Classes.selected="{Binding IsSelected}" Command="{Binding $parent[UserControl].((vm:OutstandingBalancesViewModel)DataContext).OpenRecordDetailCommand}" CommandParameter="{Binding}">
                                            <TextBlock Text="{Binding AmountPaid, StringFormat='{}{0:N0}'}" VerticalAlignment="Center" Margin="12,0" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Outstanding Amount -->
                            <DataGridTemplateColumn Header="Outstanding" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Classes="row-button" Classes.selected="{Binding IsSelected}" Command="{Binding $parent[UserControl].((vm:OutstandingBalancesViewModel)DataContext).OpenRecordDetailCommand}" CommandParameter="{Binding}">
                                            <TextBlock Text="{Binding OutstandingAmount, StringFormat='{}{0:N0}'}" FontWeight="Bold" Foreground="{DynamicResource StatusWarning}" Margin="12,0" VerticalAlignment="Center" FontSize="12"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Payment Status Badge -->
                            <DataGridTemplateColumn Header="Status" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Classes="row-button" Classes.selected="{Binding IsSelected}" Command="{Binding $parent[UserControl].((vm:OutstandingBalancesViewModel)DataContext).OpenRecordDetailCommand}" CommandParameter="{Binding}">
                                            <Border Classes="status-badge" 
                                                    Classes.status-paid="{Binding PaymentStatus, Converter={StaticResource StringEqualityConverter}, ConverterParameter=Paid}"
                                                    Classes.status-partial="{Binding PaymentStatus, Converter={StaticResource StringEqualityConverter}, ConverterParameter=Partial}"
                                                    Classes.status-unpaid="{Binding PaymentStatus, Converter={StaticResource StringEqualityConverter}, ConverterParameter=Unpaid}"
                                                    Classes.status-pendingcheque="{Binding PaymentStatus, Converter={StaticResource StringEqualityConverter}, ConverterParameter=Pending Cheque}"
                                                    Classes.status-bouncedcheque="{Binding PaymentStatus, Converter={StaticResource StringEqualityConverter}, ConverterParameter=Bounced Cheque}"
                                                    HorizontalAlignment="Left" 
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding PaymentStatus}"/>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Days Overdue -->
                            <DataGridTemplateColumn Header="Days Overdue" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Classes="row-button" Classes.selected="{Binding IsSelected}" Command="{Binding $parent[UserControl].((vm:OutstandingBalancesViewModel)DataContext).OpenRecordDetailCommand}" CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <i:Icon Value="fa-solid fa-clock" FontSize="11" Foreground="{DynamicResource StatusDanger}"/>
                                                <TextBlock Text="{Binding DaysOverdue}" Foreground="{DynamicResource StatusDanger}" FontWeight="SemiBold" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Due Date -->
                            <DataGridTemplateColumn Header="Due Date" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Classes="row-button" Classes.selected="{Binding IsSelected}" Command="{Binding $parent[UserControl].((vm:OutstandingBalancesViewModel)DataContext).OpenRecordDetailCommand}" CommandParameter="{Binding}">
                                            <TextBlock Text="{Binding DueDate, StringFormat='{}{0:dd MMM yyyy}'}" VerticalAlignment="Center" Margin="12,0" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Quick Action Details Button -->
                            <DataGridTemplateColumn Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <!-- Clicking this icon button opens the slide drawer -->
                                        <Button Classes="row-button action-btn" Classes.selected="{Binding IsSelected}" Command="{Binding $parent[UserControl].((vm:OutstandingBalancesViewModel)DataContext).OpenRecordDetailCommand}" CommandParameter="{Binding}">
                                            <i:Icon Value="fa-solid fa-angle-right" Foreground="{DynamicResource TextSecondary}" FontSize="14"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Panel>
            </Border>

            <!-- Pagination Footer -->
            <Grid Grid.Row="4" ColumnDefinitions="*, Auto" Margin="0,0,0,5">
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="20">
                    <TextBlock Text="{Binding PaginationDisplay}" Foreground="{DynamicResource TextSecondary}" FontSize="13" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Button Command="{Binding PrevPageCommand}" CornerRadius="4" Background="{DynamicResource FilterBarBg}" Width="30" Height="30" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                            <i:Icon Value="fa-solid fa-chevron-left" FontSize="10"/>
                        </Button>
                        <Button Command="{Binding NextPageCommand}" CornerRadius="4" Background="{DynamicResource FilterBarBg}" Width="30" Height="30" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                            <i:Icon Value="fa-solid fa-chevron-right" FontSize="10"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>

    <!-- PREMIUM SLIDE-IN DETAIL DRAWER -->
    <Panel ZIndex="2000" Margin="0,-70,0,0" IsHitTestVisible="{Binding IsDrawerOpen}">
        <Border Classes="drawer-overlay" Classes.open="{Binding IsDrawerOpen}"/>
        <Grid ColumnDefinitions="*, 480" VerticalAlignment="Stretch" IsHitTestVisible="{Binding IsDrawerOpen}">
            <Button Grid.Column="0" Command="{Binding CloseDrawerCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            
            <!-- Drawer Body -->
            <Border Grid.Column="1" Classes="detail-drawer" Classes.open="{Binding IsDrawerOpen}" VerticalAlignment="Stretch">
                <Panel VerticalAlignment="Stretch">
                    <Grid RowDefinitions="Auto, *, Auto" VerticalAlignment="Stretch">
                        <!-- Drawer Header -->
                        <Border Grid.Row="0" Background="{DynamicResource DrawerHeaderBg}" Padding="25" BorderBrush="{DynamicResource BorderMuted}" BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <Border Grid.Column="0" Width="64" Height="64" CornerRadius="32" Background="{DynamicResource HoverBg}" BorderBrush="{DynamicResource IconActionBorder}" BorderThickness="1">
                                    <i:Icon Value="fa-solid fa-receipt" Foreground="{DynamicResource StatusWarning}" FontSize="28"/>
                                </Border>
                                
                                <StackPanel Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedRecord.ClientName}" Foreground="{DynamicResource TextPrimary}" FontSize="20" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding SelectedRecord.ClientId, StringFormat='{}Client ID: {0}'}" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding SelectedRecord.InvoiceNumber, StringFormat='{}Invoice #: {0}'}" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
                                </StackPanel>

                                 <Button Grid.Column="2" Classes="icon-action" Command="{Binding CloseDrawerCommand}">
                                     <i:Icon Value="fa-solid fa-chevron-right" Foreground="{DynamicResource TextFaint}" FontSize="18"/>
                                 </Button>
                            </Grid>
                        </Border>

                        <!-- Scrollable Content Area -->
                        <ScrollViewer Grid.Row="1" Padding="25">
                            <StackPanel Spacing="20">
                                <!-- Balance Breakdown Card -->
                                <Border Classes="dashboard-card" Padding="20">
                                    <StackPanel Spacing="15">
                                        <TextBlock Text="DUE OUTSTANDING BALANCE" Foreground="{DynamicResource TextSecondary}" FontSize="11" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding SelectedRecord.OutstandingAmount, StringFormat='{}LKR {0:N2}'}" Foreground="{DynamicResource StatusWarning}" FontSize="28" FontWeight="Bold"/>
                                        
                                        <!-- Custom balance progress bar -->
                                        <StackPanel Spacing="5">
                                            <Grid ColumnDefinitions="Auto, *, Auto">
                                                <TextBlock Grid.Column="0" Text="{Binding SelectedRecord.AmountPaid, StringFormat='{}Paid: LKR {0:N0}'}" Foreground="{DynamicResource StatusSuccess}" FontSize="11" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="2" Text="{Binding SelectedRecord.TotalAmount, StringFormat='{}Total: LKR {0:N0}'}" Foreground="{DynamicResource TextMuted}" FontSize="11" FontWeight="SemiBold"/>
                                            </Grid>
                                            
                                            <!-- visual breakdown -->
                                            <ProgressBar Value="{Binding SelectedRecord.AmountPaid}" Minimum="0" Maximum="{Binding SelectedRecord.TotalAmount}" Height="8" CornerRadius="4" Background="{DynamicResource HoverBg}" Foreground="{DynamicResource StatusSuccess}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Receivable Summary Fields Card -->
                                <Border Classes="drawer-card">
                                    <StackPanel>
                                        <!-- Service / Module -->
                                        <Grid Classes="drawer-field-row" ColumnDefinitions="Auto, *">
                                            <TextBlock Text="Service Module" Classes="drawer-label"/>
                                            <TextBlock Text="{Binding SelectedRecord.ServiceModule}" Classes="drawer-value" Grid.Column="1"/>
                                        </Grid>

                                        <!-- Payment Status -->
                                        <Grid Classes="drawer-field-row" ColumnDefinitions="Auto, *">
                                            <TextBlock Text="Payment Status" Classes="drawer-label"/>
                                            <Border Grid.Column="1" Classes="status-badge" Classes.status-paid="{Binding SelectedRecord.PaymentStatus, Converter={StaticResource StringEqualityConverter}, ConverterParameter=Paid}"
                                                    Classes.status-partial="{Binding SelectedRecord.PaymentStatus, Converter={StaticResource StringEqualityConverter}, ConverterParameter=Partial}"
                                                    Classes.status-unpaid="{Binding SelectedRecord.PaymentStatus, Converter={StaticResource StringEqualityConverter}, ConverterParameter=Unpaid}"
                                                    Classes.status-pendingcheque="{Binding SelectedRecord.PaymentStatus, Converter={StaticResource StringEqualityConverter}, ConverterParameter=Pending Cheque}"
                                                    Classes.status-bouncedcheque="{Binding SelectedRecord.PaymentStatus, Converter={StaticResource StringEqualityConverter}, ConverterParameter=Bounced Cheque}">
                                                <TextBlock Text="{Binding SelectedRecord.PaymentStatus}"/>
                                            </Border>
                                        </Grid>

                                        <!-- Due Date -->
                                        <Grid Classes="drawer-field-row" ColumnDefinitions="Auto, *">
                                            <TextBlock Text="Due Date" Classes="drawer-label"/>
                                            <TextBlock Text="{Binding SelectedRecord.DueDate, StringFormat='{}{0:dd MMM yyyy}'}" Classes="drawer-value" Grid.Column="1"/>
                                        </Grid>

                                        <!-- Days Overdue -->
                                        <Grid Classes="drawer-field-row" ColumnDefinitions="Auto, *">
                                            <TextBlock Text="Days Overdue" Classes="drawer-label"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                <i:Icon Value="fa-solid fa-circle-exclamation" FontSize="12" Foreground="{DynamicResource StatusDanger}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding SelectedRecord.DaysOverdue, StringFormat='{}{0} days overdue'}" Foreground="{DynamicResource StatusDanger}" Classes="drawer-value" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Payment Method -->
                                        <Grid Classes="drawer-field-row" ColumnDefinitions="Auto, *">
                                            <TextBlock Text="Payment Method" Classes="drawer-label"/>
                                            <TextBlock Text="{Binding SelectedRecord.PaymentType}" Classes="drawer-value" Grid.Column="1"/>
                                        </Grid>

                                        <!-- Last Payment Date -->
                                        <Grid Classes="drawer-field-row" ColumnDefinitions="Auto, *">
                                            <TextBlock Text="Last Payment" Classes="drawer-label"/>
                                            <TextBlock Text="{Binding SelectedRecord.LastPaymentDate, StringFormat='{}{0:dd MMM yyyy}', FallbackValue='No payments yet'}" Classes="drawer-value" Grid.Column="1"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Cheque details (If applicable) -->
                                <Border Classes="drawer-card" IsVisible="{Binding SelectedRecord.HasChequeDetails}">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="Pending / Cheque Collection Details" Foreground="{DynamicResource TextHeading}" FontSize="14" FontWeight="Bold"/>
                                        <Border Height="1" Background="{DynamicResource BorderMuted}"/>
                                        
                                        <ItemsControl ItemsSource="{Binding SelectedRecord.ChequeDetails}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Spacing="10" Margin="0,5">
                                                        <Grid ColumnDefinitions="Auto, *">
                                                            <TextBlock Text="Cheque Number:" Classes="drawer-label"/>
                                                            <TextBlock Text="{Binding ChequeNumber}" Classes="drawer-value" FontWeight="Bold" Grid.Column="1"/>
                                                        </Grid>
                                                        <Grid ColumnDefinitions="Auto, *">
                                                            <TextBlock Text="Bank:" Classes="drawer-label"/>
                                                            <TextBlock Text="{Binding Bank}" Classes="drawer-value" Grid.Column="1"/>
                                                        </Grid>
                                                        <Grid ColumnDefinitions="Auto, *">
                                                            <TextBlock Text="Amount:" Classes="drawer-label"/>
                                                            <TextBlock Text="{Binding Amount, StringFormat='{}LKR {0:N2}'}" Classes="drawer-value" FontWeight="Bold" Grid.Column="1"/>
                                                        </Grid>
                                                        <Grid ColumnDefinitions="Auto, *">
                                                            <TextBlock Text="Cheque Date:" Classes="drawer-label"/>
                                                            <TextBlock Text="{Binding ChequeDate, StringFormat='{}{0:dd MMM yyyy}'}" Classes="drawer-value" Grid.Column="1"/>
                                                        </Grid>
                                                        <Grid ColumnDefinitions="Auto, *">
                                                            <TextBlock Text="Cheque Status:" Classes="drawer-label"/>
                                                            <TextBlock Text="{Binding Status}" Classes="drawer-value" Foreground="{DynamicResource StatusWarning}" FontWeight="Bold" Grid.Column="1"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Payment History Breakdown Card -->
                                <Border Classes="drawer-card">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="Collection History" Foreground="{DynamicResource TextHeading}" FontSize="14" FontWeight="Bold"/>
                                        <Border Height="1" Background="{DynamicResource BorderMuted}"/>
                                        
                                        <!-- No payments message -->
                                        <TextBlock Text="No collections have been recorded for this invoice." Foreground="{DynamicResource TextMuted}" FontSize="12" IsVisible="{Binding !SelectedRecord.HasPaymentHistory}" Padding="0,10"/>

                                        <!-- Collections History List -->
                                        <ItemsControl ItemsSource="{Binding SelectedRecord.PaymentHistory}" IsVisible="{Binding SelectedRecord.HasPaymentHistory}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="0,8" BorderBrush="{DynamicResource BorderMuted}" BorderThickness="0,0,0,1">
                                                        <Grid ColumnDefinitions="Auto, *, Auto">
                                                            <StackPanel Grid.Column="0" Spacing="2">
                                                                <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextPrimary}" FontSize="13" FontWeight="SemiBold"/>
                                                                <TextBlock Text="{Binding Date, StringFormat='{}{0:dd MMM yyyy}'}" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2" Text="{Binding Amount, StringFormat='{}+ LKR {0:N0}'}" Foreground="{DynamicResource StatusSuccess}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Bottom spacer to ensure full scrollability -->
                                <Border Height="40" Background="Transparent"/>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Drawer Footer -->
                        <Border Grid.Row="2" Background="{DynamicResource DrawerFooterBg}" Padding="20" BorderBrush="{DynamicResource BorderMuted}" BorderThickness="0,1,0,0">
                            <Button Content="Close Details" Classes="btn-drawer-save" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding CloseDrawerCommand}"/>
                        </Border>
                    </Grid>
                </Panel>
            </Border>
        </Grid>
    </Panel>
    </Panel>
</UserControl>
