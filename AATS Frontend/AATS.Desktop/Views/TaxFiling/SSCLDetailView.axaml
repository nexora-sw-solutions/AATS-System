<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:helpers="using:AATS.Desktop.Helpers"
             xmlns:vm="clr-namespace:AATS.Desktop.ViewModels.TaxFiling"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="AATS.Desktop.Views.TaxFiling.SSCLDetailView"
             x:DataType="vm:SSCLDetailViewModel"
             x:CompileBindings="False">

    <UserControl.Styles>
        <Style Selector="Border.detail-card">
            <Setter Property="Background" Value="{DynamicResource TableBg}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="32"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="TextBlock.card-label">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style Selector="TextBlock.card-value">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBox.drawer-input">
            <Setter Property="Background" Value="{DynamicResource InputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextInput}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="36"/>
        </Style>
        <Style Selector="ComboBox.drawer-input">
            <Setter Property="Background" Value="{DynamicResource InputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextInput}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Border.status-badge">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style Selector="Border.status-paid">
            <Setter Property="Background" Value="#1A10B981"/>
            <Setter Property="BorderBrush" Value="#10B981"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Border.status-paid TextBlock">
            <Setter Property="Foreground" Value="#10B981"/>
        </Style>
        <Style Selector="Border.status-pending">
            <Setter Property="Background" Value="#1AF59E0B"/>
            <Setter Property="BorderBrush" Value="#F59E0B"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Border.status-pending TextBlock">
            <Setter Property="Foreground" Value="#F59E0B"/>
        </Style>
        <Style Selector="Border.status-ird">
            <Setter Property="Background" Value="#1A3B82F6"/>
            <Setter Property="BorderBrush" Value="#3B82F6"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Border.status-ird TextBlock">
            <Setter Property="Foreground" Value="#3B82F6"/>
        </Style>
    </UserControl.Styles>

    <Panel>
        <ScrollViewer>
            <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto" Margin="40,20,40,40">
                
                <!-- 1. Header Section -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,32">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="20">
                        <Border Width="50" Height="50" Background="{DynamicResource HoverBg}" CornerRadius="8">
                            <i:Icon Value="fa-solid fa-building" Foreground="{DynamicResource AccentPrimary}" FontSize="24"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="16">
                            <TextBlock Text="{Binding DisplayClientName}" FontSize="28" FontWeight="ExtraBold" Foreground="{DynamicResource TextPrimary}" LetterSpacing="1"/>
                            <Border Background="{Binding ClientCategoryColor}" CornerRadius="12" Padding="8,2" VerticalAlignment="Center" IsVisible="{Binding HasClientCategory}">
                                <TextBlock Text="{Binding ClientCategory}" Foreground="Black" FontSize="10" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
 
                    <!-- Top-Right Actions -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                        <Button Classes="btn-secondary" Command="{Binding DownloadReportCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <i:Icon Value="fa-solid fa-download" FontSize="14" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="Download Report" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="btn-print" Command="{Binding PrintReportCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <i:Icon Value="fa-solid fa-print" FontSize="14" Foreground="{DynamicResource AddRecordFg}"/>
                                <TextBlock Text="Print" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 2. Summary Info Cards -->
                <Grid Grid.Row="1" ColumnDefinitions="*, 20, *" Margin="0,0,0,32">
                    <Border Grid.Column="0" Classes="detail-summary-card">
                        <StackPanel>
                            <TextBlock Text="RECORD ID" Classes="detail-card-label"/>
                            <TextBlock Text="{Binding Code}" Classes="detail-card-value"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Classes="detail-summary-card">
                        <StackPanel>
                            <TextBlock Text="PAYMENT STATUS" Classes="detail-card-label"/>
                            <TextBlock Text="{Binding PaymentStatus}" Classes="detail-card-value"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 3. GENERAL INFORMATION Card -->
                <Border Grid.Row="2" Classes="detail-card" Margin="0,0,0,32">
                    <StackPanel Spacing="24">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <i:Icon Value="fa-solid fa-address-card" Foreground="{DynamicResource AccentPrimary}" FontSize="18"/>
                            <TextBlock Text="GENERAL INFORMATION" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, 24, Auto, 24, Auto">
                            <!-- Row 1 -->
                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="CLIENT ID" Classes="card-label"/>
                                <TextBlock Text="{Binding DisplayClientId}" Classes="card-value" IsVisible="{Binding !IsEditMode}"/>
                                <TextBox Text="{Binding EditClientId}" Classes="drawer-input" IsVisible="{Binding IsEditMode}" Margin="0,0,24,0"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1">
                                <TextBlock Text="CLIENT NAME" Classes="card-label"/>
                                <TextBlock Text="{Binding DisplayClientName}" Classes="card-value" IsVisible="{Binding !IsEditMode}"/>
                                <TextBox Text="{Binding EditClientName}" Classes="drawer-input" IsVisible="{Binding IsEditMode}"/>
                            </StackPanel>

                            <!-- Row 2 -->
                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="SSCL No." Classes="card-label"/>
                                <TextBlock Text="{Binding DisplaySsclNo}" Classes="card-value" IsVisible="{Binding !IsEditMode}"/>
                                <TextBox Text="{Binding EditSsclNo}" Classes="drawer-input" IsVisible="{Binding IsEditMode}" Margin="0,0,24,0"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="1">
                                <TextBlock Text="ASSESSMENT YEAR" Classes="card-label"/>
                                <TextBlock Text="{Binding DisplayAssessmentYear}" Classes="card-value" IsVisible="{Binding !IsEditMode}"/>
                                <TextBox Text="{Binding EditAssessmentYear}" Classes="drawer-input" IsVisible="{Binding IsEditMode}"/>
                            </StackPanel>

                            <!-- Row 3 -->
                            <StackPanel Grid.Row="4" Grid.Column="0">
                                <TextBlock Text="CURRENT PERIOD" Classes="card-label"/>
                                <TextBlock Text="{Binding DisplayCurrentPeriod}" Classes="card-value" IsVisible="{Binding !IsEditMode}"/>
                                <TextBox Text="{Binding EditCurrentPeriod}" Classes="drawer-input" IsVisible="{Binding IsEditMode}" Margin="0,0,24,0"/>
                            </StackPanel>
                            <StackPanel Grid.Row="4" Grid.Column="1">
                                <TextBlock Text="TAX AUDITOR NOTES" Classes="card-label"/>
                                <TextBlock Text="{Binding DisplayAuditorNotes}" Classes="card-value" IsVisible="{Binding !IsEditMode}" TextWrapping="Wrap"/>
                                <TextBox Text="{Binding EditAuditorNotes}" Classes="drawer-input" IsVisible="{Binding IsEditMode}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" VerticalContentAlignment="Top"/>
                            </StackPanel>
                        </Grid>
                        
                        <!-- Inline Edit Actions inside the General Information card -->
                        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" Margin="0,16,0,0" IsVisible="{Binding IsEditMode}">
                            <Button Classes="btn-secondary" Content="Clear" Command="{Binding ClearCommand}" MinWidth="80"/>
                            <Button Classes="btn-primary" Command="{Binding SubmitCommand}" MinWidth="100">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <i:Icon Value="fa-regular fa-floppy-disk" FontSize="14" Foreground="{DynamicResource InputBg}"/>
                                    <TextBlock Text="Submit" FontWeight="Bold" Foreground="{DynamicResource InputBg}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 4. Document Preview Card(s) -->
                <Border Grid.Row="3" Classes="detail-card" Margin="0,0,0,32">
                    <StackPanel Spacing="24">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <i:Icon Value="fa-solid fa-folder-open" Foreground="{DynamicResource AccentPrimary}" FontSize="18"/>
                            <TextBlock Text="PAYMENT SLIP PREVIEW" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding PreviewDocuments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Classes="document-item" Background="{DynamicResource DrawerHeaderBg}" CornerRadius="10" Padding="16,12" Margin="0,0,0,8" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1">
                                            <Grid ColumnDefinitions="Auto, *, Auto">
                                                <i:Icon Grid.Column="0" Value="fa-solid fa-file-invoice" Foreground="{DynamicResource AccentPrimary}" FontSize="18" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding}" Foreground="{DynamicResource TextPrimary}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                
                                                <Button Grid.Column="2" Classes="icon-btn" ToolTip.Tip="Preview" Command="{Binding $parent[UserControl].DataContext.PreviewDocumentCommand}" CommandParameter="{Binding}">
                                                    <i:Icon Value="fa-solid fa-eye" Foreground="{DynamicResource TextSecondary}" FontSize="16"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Text="No documents uploaded." Foreground="{DynamicResource TextFaint}" FontStyle="Italic" HorizontalAlignment="Center" Margin="0,10" IsVisible="{Binding !PreviewDocuments.Count}"/>
                    </StackPanel>
                </Border>

                <!-- 5. Footer Actions -->
                <Grid Grid.Row="4" ColumnDefinitions="Auto, *, Auto" VerticalAlignment="Bottom" Margin="0,40,0,0">
                    <Button Grid.Column="0" Classes="footer-link" Command="{Binding OpenGuideCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <i:Icon Value="fa-solid fa-circle-question" Foreground="{DynamicResource TextSecondary}" FontSize="16"/>
                            <TextBlock Text="Learn more about SSCL Details" Foreground="{DynamicResource TextSecondary}" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16" IsVisible="{Binding !IsEditMode}">
                        <Button Content="Edit" Classes="btn-edit" Width="140" Command="{Binding EnterEditModeCommand}"/>
                        <Button Content="Delete" Classes="btn-delete" Width="140" Command="{Binding RequestDeleteRecordCommand}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>
        
        <!-- Delete Confirmation Popup -->
        <Border ZIndex="101" IsVisible="{Binding IsDeleteConfirmVisible}" Classes="premium-modal-overlay">
            <Border Classes="premium-modal-content" HorizontalAlignment="Center" VerticalAlignment="Center" Width="440">
                <StackPanel Spacing="25">
                    <i:Icon Value="fa-solid fa-triangle-exclamation" Foreground="{DynamicResource StatusDanger}" FontSize="40" HorizontalAlignment="Center"/>
                    <TextBlock Text="Delete Record?" Foreground="{DynamicResource TextPrimary}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Are you sure you want to delete this record? This action cannot be undone." 
                               Foreground="{DynamicResource TextSecondary}" FontSize="13" TextAlignment="Center" TextWrapping="Wrap"/>
                    <Grid ColumnDefinitions="*, 12, *" Margin="0,10,0,0">
                        <Button Grid.Column="0" Content="Cancel" Command="{Binding CancelDeleteCommand}" Classes="btn-secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                        <Button Grid.Column="2" Content="Delete" Command="{Binding ConfirmDeleteCommand}" Classes="btn-delete" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- Guide Overlay -->
        <Border ZIndex="100" IsVisible="{Binding IsGuideVisible}" helpers:GuideHelper.EnableOutsideClickClose="True" Classes="premium-modal-overlay">
            <Border Classes="premium-modal-content" HorizontalAlignment="Center" VerticalAlignment="Center" Width="700">
                <StackPanel Spacing="25">
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="15" VerticalAlignment="Center">
                            <Border Width="45" Height="45" CornerRadius="8" Background="{DynamicResource GuideBadgeBg}">
                                <i:Icon Value="fa-solid fa-book-open" Foreground="{DynamicResource GuideCardBg}" FontSize="20"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="SSCL Details Guide" Foreground="{DynamicResource TextHeading}" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text="Understand how to manage Corporate Income Tax details." Foreground="{DynamicResource TextSecondary}" FontSize="13" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="footer-link" Command="{Binding CloseGuideCommand}" VerticalAlignment="Top" Margin="0,-5,-5,0">
                            <i:Icon Value="fa-solid fa-xmark" Foreground="{DynamicResource TextSecondary}" FontSize="18"/>
                        </Button>
                    </Grid>

                    <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, *" Margin="0,15,0,25">
                        <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource GuideCardBg}" CornerRadius="8" Padding="15" Margin="0,0,12,12">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Background="{DynamicResource GuideBadgeBg}" CornerRadius="10" Width="20" Height="20">
                                        <TextBlock Text="1" Foreground="{DynamicResource GuideCardBg}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="General Information" Foreground="{DynamicResource TextHeading}" FontWeight="Bold" FontSize="14"/>
                                </StackPanel>
                                <TextBlock Text="View the core details and auditor notes for the corporate client." Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource GuideCardBg}" CornerRadius="8" Padding="15" Margin="12,0,0,12">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Background="{DynamicResource GuideBadgeBg}" CornerRadius="10" Width="20" Height="20">
                                        <TextBlock Text="2" Foreground="{DynamicResource GuideCardBg}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Documents" Foreground="{DynamicResource TextHeading}" FontWeight="Bold" FontSize="14"/>
                                </StackPanel>
                                <TextBlock Text="Preview previously uploaded payment slips directly from this page." Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Button Content="Got it, thanks!" Classes="btn-primary" Background="{DynamicResource GuideBadgeBg}" Foreground="{DynamicResource GuideCardBg}" HorizontalAlignment="Right" Command="{Binding CloseGuideCommand}"/>
                </StackPanel>
            </Border>
        </Border>

    </Panel>
</UserControl>

