            <SolidColorBrush x:Key="NexoraDocItemBorder" Color="#D9E2EC"/>
            
            <SolidColorBrush x:Key="NexoraTableHeaderBg" Color="#EEF3F8"/>
            <SolidColorBrush x:Key="NexoraTableRowBorder" Color="#D9E2EC"/>
            <SolidColorBrush x:Key="NexoraBadgeBg" Color="#CFFAFE"/>

            <SolidColorBrush x:Key="NexoraOverlayBg" Color="#4D0A0F1A"/>
            <SolidColorBrush x:Key="NexoraDrawerBorder" Color="#D9E2EC"/>

        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
