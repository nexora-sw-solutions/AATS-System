            <SolidColorBrush x:Key="GlassBg" Color="#FAFBFD"/>
            <SolidColorBrush x:Key="GlassBorder" Color="#D9E2EC"/>
            <BoxShadows x:Key="GlassShadow">0 4 20 0 #0D000000</BoxShadows>
            
            <SolidColorBrush x:Key="NexoraFormCardBg" Color="#FAFBFD"/>
            <SolidColorBrush x:Key="NexoraFormCardBorder" Color="#D9E2EC"/>
