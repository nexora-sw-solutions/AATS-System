<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AATS.Desktop.ViewModels.ActivityLog"
             xmlns:Models="clr-namespace:AATS.Desktop.Models"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             xmlns:conv="using:AATS.Desktop.Converters"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="AATS.Desktop.Views.ActivityLog.ActivityLogView"
             x:DataType="vm:ActivityLogViewModel">

    <UserControl.Styles>
        <Style Selector="Button.filter-trigger">
            <Setter Property="Background" Value="{DynamicResource InputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextInput}"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="MinWidth" Value="150"/>
            <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource SelectionIndicatorBg}"/>
                <Setter Property="BorderBrush" Value="#4B5563"/>
            </Style>
        </Style>

        <Style Selector="Button.menu-item-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource SelectionIndicatorBg}"/>
            </Style>
        </Style>

        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="AreSeparatorsVisible" Value="False"/>
        </Style>

        <!-- Disable Header Selectable/Hover Effects -->
        <Style Selector="DataGridColumnHeader:pointerover /template/ Grid">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="DataGridColumnHeader:pointerover /template/ Border">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="DataGridRow">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
        </Style>

        <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="Transparent"/>
        </Style>

        <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="{DynamicResource RowHoverBg}"/>
            <Setter Property="Opacity" Value="0.5"/>
        </Style>

        <!-- Suppress Native Cell Focus/Currency Visuals -->
        <Style Selector="DataGridCell:current /template/ Grid#FocusVisual">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="DataGridCell:current /template/ Rectangle#CurrencyVisual">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="DataGridCell:selected /template/ Grid#FocusVisual">
            <Setter Property="IsVisible" Value="False"/>
        </Style>

        <!-- Global Status Badge Style -->
        <Style Selector="Border.action-badge">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="Border.action-Create">
            <Setter Property="Background" Value="#EBFDF5"/>
            <Setter Property="BorderBrush" Value="#D1FAE5"/>
            <Style Selector="^ TextBlock">
                <Setter Property="Foreground" Value="#059669"/>
            </Style>
            <Style Selector="^ i|Icon">
                <Setter Property="Foreground" Value="#059669"/>
            </Style>
        </Style>
        
        <Style Selector="Border.action-Update">
            <Setter Property="Background" Value="#EFF6FF"/>
            <Setter Property="BorderBrush" Value="#DBEAFE"/>
            <Style Selector="^ TextBlock">
                <Setter Property="Foreground" Value="#2563EB"/>
            </Style>
            <Style Selector="^ i|Icon">
                <Setter Property="Foreground" Value="#2563EB"/>
            </Style>
        </Style>

        <Style Selector="Border.action-Delete">
            <Setter Property="Background" Value="#FEF2F2"/>
            <Setter Property="BorderBrush" Value="#FEE2E2"/>
            <Style Selector="^ TextBlock">
                <Setter Property="Foreground" Value="#DC2626"/>
            </Style>
            <Style Selector="^ i|Icon">
                <Setter Property="Foreground" Value="#DC2626"/>
            </Style>
        </Style>

        <Style Selector="Border.action-Login">
            <Setter Property="Background" Value="#F5F3FF"/>
            <Setter Property="BorderBrush" Value="#EDE9FE"/>
            <Style Selector="^ TextBlock">
                <Setter Property="Foreground" Value="#7C3AED"/>
            </Style>
            <Style Selector="^ i|Icon">
                <Setter Property="Foreground" Value="#7C3AED"/>
            </Style>
        </Style>

        <Style Selector="Border.action-Print">
            <Setter Property="Background" Value="#FFFBEB"/>
            <Setter Property="BorderBrush" Value="#FEF3C7"/>
            <Style Selector="^ TextBlock">
                <Setter Property="Foreground" Value="#D97706"/>
            </Style>
            <Style Selector="^ i|Icon">
                <Setter Property="Foreground" Value="#D97706"/>
            </Style>
        </Style>

        <Style Selector="Border.action-Export">
            <Setter Property="Background" Value="#ECFEFF"/>
            <Setter Property="BorderBrush" Value="#CFFAFE"/>
            <Style Selector="^ TextBlock">
                <Setter Property="Foreground" Value="#0891B2"/>
            </Style>
            <Style Selector="^ i|Icon">
                <Setter Property="Foreground" Value="#0891B2"/>
            </Style>
        </Style>
    </UserControl.Styles>

    <Panel VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
        <!-- Main Content (Standard Global Margins) -->
        <Grid RowDefinitions="Auto, Auto, *, Auto" Margin="25,20,25,10" VerticalAlignment="Top">
            
            <!-- Standard Global Header -->
            <Grid Grid.Row="0" Margin="0,0,0,25">
                <TextBlock Text="Activity Logs" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
            </Grid>

            <!-- Standardized Filter Section -->
            <Border Grid.Row="1" Background="{DynamicResource FilterBarBg}" CornerRadius="12" Padding="15" Margin="0,0,0,20" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                <Grid ColumnDefinitions="*, 15, Auto">
                    <!-- Search Bar (Flexible Wide Column) -->
                    <Panel Grid.Column="0">
                        <TextBox Classes="filter-search" Watermark="Search logs by user, module or details..." Text="{Binding SearchText}"/>
                        <i:Icon Value="fa-solid fa-magnifying-glass" Foreground="{DynamicResource TextDimmed}" FontSize="14" HorizontalAlignment="Left" Margin="15,0,0,0" VerticalAlignment="Center"/>
                    </Panel>

                    <!-- Filter Group (Reordered, Inline Dynamic Inputs) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                        
                        <!-- 1. Unified Date Filter -->
                        <Button Classes="date-filter-trigger">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <i:Icon Value="fa-solid fa-calendar-alt" Foreground="{DynamicResource AccentPrimary}" FontSize="16"/>
                                <TextBlock Text="{Binding DateFilterSummary}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14"/>
                                <i:Icon Value="fa-solid fa-chevron-down" Foreground="{DynamicResource TextMuted}" FontSize="10" VerticalAlignment="Center" Margin="5,0,0,0"/>
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft" FlyoutPresenterClasses="premium-flyout">
                                    <Border Background="{DynamicResource DrawerBg}" 
                                            BorderBrush="{DynamicResource BorderDefault}" 
                                            BorderThickness="1" 
                                            CornerRadius="12" 
                                            Padding="0" 
                                            ClipToBounds="True"
                                            BoxShadow="{DynamicResource FlyoutShadow}">
                                        <Grid ColumnDefinitions="Auto, 1, Auto">
                                            <!-- Left: Quick Picks List -->
                                            <Border Classes="quick-pick-sidebar">
                                                <ListBox ItemsSource="{Binding DateFilters}" SelectedItem="{Binding SelectedDateFilter}"
                                                         Classes="quick-pick-list"/>
                                            </Border>

                                            <!-- Vertical Divider -->
                                            <Border Grid.Column="1" Background="{DynamicResource BorderMuted}" Width="1" VerticalAlignment="Stretch"/>

                                            <!-- Right: Context Content -->
                                            <Border Grid.Column="2" Padding="25" MinWidth="350" MinHeight="480">
                                                <Panel>
                                                    <!-- All Dates / Simple Filters -->
                                                    <StackPanel Spacing="15" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                IsVisible="{Binding SelectedDateFilter, Converter={StaticResource StringEqualityConverter}, ConverterParameter=All Dates}">
                                                        <Panel Height="80">
                                                            <i:Icon Value="fa-solid fa-calendar-check" FontSize="48" Foreground="{DynamicResource TextMuted}" Opacity="0.3" HorizontalAlignment="Center"/>
                                                        </Panel>
                                                        <TextBlock Text="Viewing all time records" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                    
                                                    <StackPanel Spacing="15" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                IsVisible="{Binding SelectedDateFilter, Converter={StaticResource StringEqualityConverter}, ConverterParameter=Today}">
                                                        <Panel Height="80">
                                                            <i:Icon Value="fa-solid fa-clock" FontSize="48" Foreground="{DynamicResource StatusInfo}" Opacity="0.5" HorizontalAlignment="Center"/>
                                                        </Panel>
                                                        <TextBlock Text="Viewing records from today" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                                                    </StackPanel>

                                                    <StackPanel Spacing="15" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                IsVisible="{Binding SelectedDateFilter, Converter={StaticResource StringEqualityConverter}, ConverterParameter=This Week}">
                                                        <Panel Height="80">
                                                            <i:Icon Value="fa-solid fa-calendar-week" FontSize="48" Foreground="{DynamicResource AccentBlue}" Opacity="0.5" HorizontalAlignment="Center"/>
                                                        </Panel>
                                                        <TextBlock Text="Viewing records from this week" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                                                    </StackPanel>

                                                    <!-- Month Selection -->
                                                    <StackPanel Spacing="15" 
                                                                IsVisible="{Binding SelectedDateFilter, Converter={StaticResource StringEqualityConverter}, ConverterParameter=This Month}">
                                                        <TextBlock Text="Select Month" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimary}"/>
                                                        <Calendar SelectedDate="{Binding MonthDate}"/>
                                                        <TextBlock Text="Tip: Select any day in the month" FontSize="11" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                                                    </StackPanel>

                                                    <!-- Year Selection -->
                                                    <StackPanel Spacing="15" 
                                                                IsVisible="{Binding SelectedDateFilter, Converter={StaticResource StringEqualityConverter}, ConverterParameter=This Year}">
                                                        <TextBlock Text="Select Year" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimary}"/>
                                                         <ListBox ItemsSource="{Binding Years}" 
                                                                  SelectedItem="{Binding SelectedYear}"
                                                                  Classes="year-selector-list">
                                                             <ListBox.ItemsPanel>
                                                                 <ItemsPanelTemplate>
                                                                     <WrapPanel/>
                                                                 </ItemsPanelTemplate>
                                                             </ListBox.ItemsPanel>
                                                         </ListBox>
                                                    </StackPanel>

                                                    <!-- Specific Date -->
                                                    <StackPanel Spacing="15" 
                                                                IsVisible="{Binding SelectedDateFilter, Converter={StaticResource StringEqualityConverter}, ConverterParameter=Specific Date}">
                                                        <TextBlock Text="Select Specific Date" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimary}"/>
                                                        <Calendar SelectedDate="{Binding SpecificDate}"/>
                                                    </StackPanel>

                                                    <!-- Specific Period -->
                                                    <StackPanel Spacing="15" 
                                                                IsVisible="{Binding SelectedDateFilter, Converter={StaticResource StringEqualityConverter}, ConverterParameter=Specific Period}">
                                                        <TextBlock Text="Select Date Range" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimary}"/>
                                                        <Border Background="{DynamicResource DateFlyoutBg}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="5">
                                                            <StackPanel Spacing="10">
                                                                <Calendar SelectionMode="SingleRange" 
                                                                          SelectedDatesChanged="Calendar_OnSelectedDatesChanged"
                                                                          HorizontalAlignment="Center"/>
                                                                <Grid ColumnDefinitions="*, Auto, *" Margin="10,0">
                                                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                                                        <TextBlock Text="Start Date" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                                                        <TextBlock Text="{Binding PeriodStartDate, StringFormat={}{0:dd MMM yyyy}}" FontWeight="SemiBold" FontSize="12"/>
                                                                    </StackPanel>
                                                                    <i:Icon Grid.Column="1" Value="fa-solid fa-arrow-right" FontSize="10" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="10,0"/>
                                                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                                                        <TextBlock Text="End Date" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                                                        <TextBlock Text="{Binding PeriodEndDate, StringFormat={}{0:dd MMM yyyy}}" FontWeight="SemiBold" FontSize="12"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                        <TextBlock Text="Tip: Click and drag or use Shift+Click to select a range" FontSize="11" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Panel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <!-- 2. All Actions (Filter) -->
                        <Button Classes="filter-trigger">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Grid.Column="0" Text="{Binding SelectedAction}" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextBody}"/>
                                <i:Icon Grid.Column="1" Value="fa-solid fa-chevron-down" FontSize="9" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                            </Grid>
                            <Button.Flyout>
                                <Flyout Placement="Bottom" FlyoutPresenterClasses="filter-flyout">
                                    <Border Background="{DynamicResource DrawerBg}" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" CornerRadius="8" Padding="5" Width="160">
                                        <StackPanel Spacing="2">
                                            <Button Classes="menu-item-btn" Command="{Binding UpdateActionCommand}" CommandParameter="All Actions" Content="All Actions"/>
                                            <Button Classes="menu-item-btn" Command="{Binding UpdateActionCommand}" CommandParameter="Create" Content="Create"/>
                                            <Button Classes="menu-item-btn" Command="{Binding UpdateActionCommand}" CommandParameter="Update" Content="Update"/>
                                            <Button Classes="menu-item-btn" Command="{Binding UpdateActionCommand}" CommandParameter="Delete" Content="Delete"/>
                                            <Button Classes="menu-item-btn" Command="{Binding UpdateActionCommand}" CommandParameter="Login" Content="Login"/>
                                        </StackPanel>
                                    </Border>
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <!-- 3. All Modules (M) -->
                        <Button Classes="filter-trigger">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Grid.Column="0" Text="{Binding SelectedModule}" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextBody}"/>
                                <i:Icon Grid.Column="1" Value="fa-solid fa-chevron-down" FontSize="9" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                            </Grid>
                            <Button.Flyout>
                                <Flyout Placement="Bottom" FlyoutPresenterClasses="filter-flyout">
                                    <Border Background="{DynamicResource DrawerBg}" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" CornerRadius="8" Padding="5" Width="180">
                                        <StackPanel Spacing="2">
                                            <Button Classes="menu-item-btn" Command="{Binding UpdateModuleCommand}" CommandParameter="All Modules" Content="All Modules"/>
                                            <Button Classes="menu-item-btn" Command="{Binding UpdateModuleCommand}" CommandParameter="Audit &amp; Assurance" Content="Audit &amp; Assurance"/>
                                            <Button Classes="menu-item-btn" Command="{Binding UpdateModuleCommand}" CommandParameter="CIT" Content="CIT"/>
                                            <Button Classes="menu-item-btn" Command="{Binding UpdateModuleCommand}" CommandParameter="Registration" Content="Registration"/>
                                            <Button Classes="menu-item-btn" Command="{Binding UpdateModuleCommand}" CommandParameter="Team" Content="Team"/>
                                            <Button Classes="menu-item-btn" Command="{Binding UpdateModuleCommand}" CommandParameter="Auth" Content="Auth"/>
                                        </StackPanel>
                                    </Border>
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <!-- 4. All Branches (B) -->
                        <Button Classes="filter-trigger">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Grid.Column="0" Text="{Binding SelectedBranch}" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextBody}"/>
                                <i:Icon Grid.Column="1" Value="fa-solid fa-chevron-down" FontSize="9" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                            </Grid>
                            <Button.Flyout>
                                <Flyout Placement="Bottom" FlyoutPresenterClasses="filter-flyout">
                                    <Border Background="{DynamicResource DrawerBg}" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" CornerRadius="8" Padding="5" Width="160">
                                        <StackPanel Spacing="2">
                                            <Button Classes="menu-item-btn" Command="{Binding UpdateBranchCommand}" CommandParameter="All Branches" Content="All Branches"/>
                                            <Button Classes="menu-item-btn" Command="{Binding UpdateBranchCommand}" CommandParameter="Central" Content="Central"/>
                                            <Button Classes="menu-item-btn" Command="{Binding UpdateBranchCommand}" CommandParameter="North East" Content="North East"/>
                                            <Button Classes="menu-item-btn" Command="{Binding UpdateBranchCommand}" CommandParameter="West" Content="West"/>
                                            <Button Classes="menu-item-btn" Command="{Binding UpdateBranchCommand}" CommandParameter="South" Content="South"/>
                                        </StackPanel>
                                    </Border>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        
                        <!-- Clear Filters Reset Button -->
                        <Button Command="{Binding ClearFiltersCommand}"
                                IsVisible="{Binding HasActiveFilters}"
                                Background="Transparent" BorderThickness="0" Padding="8"
                                ToolTip.Tip="Reset All Filters"
                                VerticalAlignment="Center"
                                Cursor="Hand">
                            <i:Icon Value="fa-solid fa-rotate-left" Foreground="{DynamicResource StatusDanger}" FontSize="16"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Final Global Table Section -->
            <Border Grid.Row="2" Background="{DynamicResource FilterBarBg}" CornerRadius="12" Padding="5" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                <DataGrid ItemsSource="{Binding FilteredLogs}" 
                          AutoGenerateColumns="False" 
                          IsReadOnly="True" 
                          CanUserSortColumns="True"
                          Background="Transparent" BorderThickness="0"
                          GridLinesVisibility="None" RowHeight="42">
                    <DataGrid.Columns>
                        <!-- Action Time -->
                        <DataGridTemplateColumn Header="Action Time" Width="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="Models:ActivityLogEntry">
                                    <TextBlock Text="{Binding TimestampFormatted}" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="15,0" FontSize="11"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Module -->
                        <DataGridTemplateColumn Header="Module" Width="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="Models:ActivityLogEntry">
                                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="10,0" VerticalAlignment="Center">
                                        <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource HoverBg}" BorderBrush="{DynamicResource IconActionBorder}" BorderThickness="1">
                                            <i:Icon Value="{Binding ModuleIcon}" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                                        </Border>
                                        <TextBlock Text="{Binding Module}" VerticalAlignment="Center" Foreground="{DynamicResource TextInput}" FontWeight="SemiBold" FontSize="12"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Action Status Badge -->
                        <DataGridTemplateColumn Header="Action" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="Models:ActivityLogEntry">
                                    <Border Margin="10,0" Classes="action-badge" 
                                            Classes.action-Create="{Binding IsCreate}"
                                            Classes.action-Update="{Binding IsUpdate}"
                                            Classes.action-Delete="{Binding IsDelete}"
                                            Classes.action-Login="{Binding IsLogin}"
                                            Classes.action-Print="{Binding IsPrint}"
                                            Classes.action-Export="{Binding IsExport}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <i:Icon Value="{Binding ActionIcon}" FontSize="10"/>
                                            <TextBlock Text="{Binding Action}" FontSize="10" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Details (Auto-Expanding) -->
                        <DataGridTemplateColumn Header="Details" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="Models:ActivityLogEntry">
                                    <TextBlock Text="{Binding Details}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="15,0" FontSize="12" TextWrapping="NoWrap"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- User -->
                        <DataGridTemplateColumn Header="User" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="Models:ActivityLogEntry">
                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="15,0">
                                        <i:Icon Value="fa-regular fa-user" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
                                        <TextBlock Text="{Binding User}" Foreground="{DynamicResource TextInput}" FontSize="12"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Branch -->
                        <DataGridTemplateColumn Header="Branch" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="Models:ActivityLogEntry">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="15,0">
                                        <i:Icon Value="fa-solid fa-location-dot" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                        <TextBlock Text="{Binding Branch}" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Standardized Footer -->
            <Grid Grid.Row="3" Margin="0,15,0,0" ColumnDefinitions="Auto, *, Auto">
                <!-- Guide Link -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <i:Icon Value="fa-solid fa-circle-question" Foreground="{DynamicResource TextSecondary}" FontSize="14"/>
                    <Button Classes="footer-link" Command="{Binding OpenGuideCommand}">
                        <TextBlock Text="{Binding GuideLinkText}" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                    </Button>
                </StackPanel>

                <!-- Page Navigation (Standardized Rounded Rectangles) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="20">
                    <TextBlock Text="{Binding PaginationDisplay}" Foreground="{DynamicResource TextSecondary}" FontSize="13" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Button Command="{Binding PrevPageCommand}" CornerRadius="4" Background="{DynamicResource FilterBarBg}" Width="30" Height="30" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" Cursor="Hand">
                            <i:Icon Value="fa-solid fa-chevron-left" FontSize="10" Foreground="{DynamicResource TextSecondary}"/>
                        </Button>
                        <Button Command="{Binding NextPageCommand}" CornerRadius="4" Background="{DynamicResource FilterBarBg}" Width="30" Height="30" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" Cursor="Hand">
                            <i:Icon Value="fa-solid fa-chevron-right" FontSize="10" Foreground="{DynamicResource TextSecondary}"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Instruction Guide Overlay (ZIndex 10) -->
        <Border ZIndex="10" 
                IsVisible="{Binding IsGuideVisible}" 
                Background="{DynamicResource OverlayBg}" 
                HorizontalAlignment="Stretch" 
                VerticalAlignment="Stretch">
            <Border Background="{DynamicResource InputBg}" 
                    BorderBrush="{DynamicResource BorderDefault}" 
                    BorderThickness="1" 
                    CornerRadius="12" 
                    Width="620" 
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center" 
                    Padding="30"
                    BoxShadow="0 10 30 0 #40000000">
                <StackPanel Spacing="25">
                    <!-- Guide Header -->
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <i:Icon Value="fa-regular fa-circle-question" FontSize="22" Foreground="{DynamicResource TextHeading}"/>
                            <TextBlock Text="Activity Log Guide" Foreground="{DynamicResource TextHeading}" FontSize="22" FontWeight="Bold"/>
                        </StackPanel>
                        <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="5" Command="{Binding CloseGuideCommand}" Cursor="Hand">
                            <i:Icon Value="fa-solid fa-xmark" Foreground="{DynamicResource TextSecondary}" FontSize="18"/>
                        </Button>
                    </Grid>

                    <TextBlock Text="Master the tracing and auditing features of the Activity Log for effective system management." 
                               Foreground="{DynamicResource TextSecondary}" FontSize="14" Margin="0,-10,0,5"/>

                    <!-- Activity Log Feature Grid -->
                    <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, *" Margin="0,0,0,5">
                        <!-- Feature 1 -->
                        <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource GuideCardBg}" CornerRadius="8" Padding="15" Margin="0,0,10,10">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Background="{DynamicResource GuideBadgeBg}" CornerRadius="10" Width="20" Height="20">
                                        <TextBlock Text="1" Foreground="{DynamicResource GuideCardBg}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Standard Filters" Foreground="{DynamicResource TextHeading}" FontWeight="Bold" FontSize="14"/>
                                </StackPanel>
                                <TextBlock Text="Unified filter bar to track specific actions and activities across branches and modules in the firm." 
                                           Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Feature 2 -->
                        <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource GuideCardBg}" CornerRadius="8" Padding="15" Margin="10,0,0,10">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Background="{DynamicResource GuideBadgeBg}" CornerRadius="10" Width="20" Height="20">
                                        <TextBlock Text="2" Foreground="{DynamicResource GuideCardBg}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Date Management" Foreground="{DynamicResource TextHeading}" FontWeight="Bold" FontSize="14"/>
                                </StackPanel>
                                <TextBlock Text="Audit historical data by specific dates, months, or custom ranges using the premium flyout calendar." 
                                           Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Feature 3 -->
                        <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource GuideCardBg}" CornerRadius="8" Padding="15" Margin="0,10,10,0">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Background="{DynamicResource GuideBadgeBg}" CornerRadius="10" Width="20" Height="20">
                                        <TextBlock Text="3" Foreground="{DynamicResource GuideCardBg}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Action Tracking" Foreground="{DynamicResource TextHeading}" FontWeight="Bold" FontSize="14"/>
                                </StackPanel>
                                <TextBlock Text="Real-time tracking of Create, Update, Delete, and Login activities as they occur across the system." 
                                           Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Feature 4 -->
                        <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource GuideCardBg}" CornerRadius="8" Padding="15" Margin="10,10,0,0">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Background="{DynamicResource GuideBadgeBg}" CornerRadius="10" Width="20" Height="20">
                                        <TextBlock Text="4" Foreground="{DynamicResource GuideCardBg}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Module Insights" Foreground="{DynamicResource TextHeading}" FontWeight="Bold" FontSize="14"/>
                                </StackPanel>
                                <TextBlock Text="Instantly identify which module a log entry belongs to with standardized icons and action badges." 
                                           Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- User Information Tip -->
                    <Border Background="{DynamicResource DrawerHeaderBg}" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" CornerRadius="8" Padding="15">
                        <StackPanel Spacing="10">
                            <TextBlock Text="PRO TIP" Foreground="{DynamicResource TextSecondary}" FontWeight="Bold" FontSize="11"/>
                            <TextBlock Text="Use the global search bar to instantly trace activity for a specific user ID or a branch name for precise auditing." 
                                       Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    
                    <Button Content="Got it, thanks!" 
                            Background="{DynamicResource GuideGotItBg}" 
                            Foreground="{DynamicResource DrawerHeaderBg}" 
                            FontWeight="Bold" 
                            CornerRadius="6" 
                            Padding="20,10" 
                            HorizontalAlignment="Right" 
                            Command="{Binding CloseGuideCommand}" 
                            Cursor="Hand">
                        <Button.Styles>
                            <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="#A8CEEF" />
                            </Style>
                        </Button.Styles>
                    </Button>
                </StackPanel>
            </Border>
        </Border>
    </Panel>
</UserControl>
